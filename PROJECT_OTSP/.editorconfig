root = true

# Visual Studio Code Analysis & IntelliSense rules
[*.{cs,vb}]
dotnet_analyzer_diagnostic.severity = default

# Đánh dấu toàn bộ thư viện vendor và client-side libs là mã nguồn bên thứ 3 (generated code)
# Giúp Visual Studio không quét cảnh báo cú pháp CSS / JS trong các thư mục này
[wwwroot/assets/vendor/**]
generated_code = true

[wwwroot/lib/**]
generated_code = true

