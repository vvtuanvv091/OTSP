@model PROJECT_OTSP.Dtos.ClassSessionRoomVm

@{
    ViewData["Title"] = $"Lớp học trực tuyến - {Model.ClassroomName}";
    Layout = User.IsInRole("Tutor")
        ? "~/Areas/Tutor/Views/Shared/_Layout_Tutor.cshtml"
        : "~/Areas/Student_Parent/Views/Shared/_Layout_Student.cshtml";
    var backUrl = User.IsInRole("Tutor")
        ? Url.Action("Index", "TutorSchedule", new { area = "Tutor" })
        : Url.Action("MyRequests", "Send_Details_Tutor", new { area = "Student_Parent" });
}

<div id="class-room-page" class="container-fluid py-4"
     data-room-name="@Model.RoomName"
     data-display-name="@Model.DisplayName"
     data-session-id="@Model.SessionId"
     data-hub-url="@Url.Content("~/hubs/connection-requests")"
     data-back-url="@backUrl">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h1 class="h5 mb-1">@Model.ClassroomName</h1>
                <div class="small text-body-secondary">@Model.SubjectName · @Model.ScheduledAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (GMT+7)</div>
            </div>
            <a href="@backUrl" class="btn btn-sm btn-outline-secondary">Quay lại lịch học</a>
        </div>
        <div class="card-body p-0">
            <div id="jitsiStatus" class="small text-body-secondary p-3" role="status">Đang kết nối phòng học...</div>
            <div id="jitsiMeeting" style="height:min(75vh, 800px); min-height:480px"></div>
            <div class="p-3 d-flex justify-content-end align-items-center gap-2">
                @if (User.IsInRole("Tutor"))
                {
                    <form asp-area="" asp-controller="ClassSession" asp-action="End" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn kết thúc buổi học cho tất cả thành viên?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SessionId" />
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-stop-circle me-1" aria-hidden="true"></i>Kết thúc buổi học</button>
                    </form>
                }
                <form id="leaveRoomForm" asp-area="" asp-controller="ClassSession" asp-action="Leave" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.SessionId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Rời lớp</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    <script src="https://meet.jit.si/external_api.js"></script>
    <script>
        (() => {
            const page = document.getElementById("class-room-page");
            const status = document.getElementById("jitsiStatus");
            const leaveForm = document.getElementById("leaveRoomForm");
            if (!page || !window.JitsiMeetExternalAPI) {
                status.textContent = "Không tải được phòng học trực tuyến. Vui lòng thử lại.";
                return;
            }

            const meeting = new JitsiMeetExternalAPI("meet.jit.si", {
                roomName: page.dataset.roomName,
                parentNode: document.getElementById("jitsiMeeting"),
                width: "100%",
                height: "100%",
                userInfo: { displayName: page.dataset.displayName }
            });
            let leaveRequest;
            const recordLeave = () => {
                if (!leaveRequest) {
                    leaveRequest = fetch(leaveForm.action, {
                        method: "POST",
                        body: new FormData(leaveForm),
                        credentials: "same-origin"
                    }).then(response => {
                        if (!response.ok) throw new Error("Không ghi nhận được lượt rời lớp.");
                    });
                }
                return leaveRequest;
            };

            leaveForm.addEventListener("submit", async event => {
                event.preventDefault();
                const button = leaveForm.querySelector("button");
                button.disabled = true;
                try {
                    await recordLeave();
                    meeting.executeCommand("hangup");
                    window.location.assign(page.dataset.backUrl);
                } catch (exception) {
                    status.textContent = exception.message;
                    button.disabled = false;
                }
            });

            meeting.addEventListener("videoConferenceJoined", () => {
                status.textContent = "Đã vào lớp. Hãy cho phép trình duyệt sử dụng camera và microphone nếu được yêu cầu.";
            });
            meeting.addEventListener("videoConferenceLeft", () => {
                status.textContent = "Bạn đã rời phòng học. Có thể tham gia lại khi buổi học còn diễn ra.";
                recordLeave().catch(error => console.error(error));
            });
            meeting.addEventListener("readyToClose", () => {
                status.textContent = "Bạn đã rời phòng học.";
            });

            if (window.signalR) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl(page.dataset.hubUrl)
                    .withAutomaticReconnect()
                    .build();
                connection.on("ClassSessionStatusChanged", update => {
                    if (Number(update.classSessionId) !== Number(page.dataset.sessionId)) return;
                    if (update.status === "Done" || update.status === "Cancelled") {
                        status.textContent = update.status === "Done" ? "Gia sư đã kết thúc buổi học." : "Buổi học đã bị hủy.";
                        leaveForm.querySelector("button").disabled = true;
                        meeting.executeCommand("hangup");
                        window.setTimeout(() => window.location.assign(page.dataset.backUrl), 1500);
                    }
                });
                connection.start().catch(error => console.error("Session status connection failed:", error));
            }

            window.addEventListener("beforeunload", () => meeting.dispose());
        })();
    </script>
}
