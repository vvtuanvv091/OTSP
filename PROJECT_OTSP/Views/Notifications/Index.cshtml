@using PROJECT_OTSP.Dtos.Notification
@model NotificationPageVm
@{
    var isVietnamese = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi";
    ViewData["Title"] = isVietnamese ? "Thông báo" : "Notifications";
    Layout = User.IsInRole("Tutor")
        ? "~/Areas/Tutor/Views/Shared/_Layout_Tutor.cshtml"
        : (User.IsInRole("Student_Parent")
            ? "~/Areas/Student_Parent/Views/Shared/_Layout_Student.cshtml"
            : "~/Views/Shared/_Layout.cshtml");
}

<div class="notifications-page-shell">
    <!-- Header -->
    <div class="notifications-header-box mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <span class="badge badge-soft-brand mb-2 px-2.5 py-1">OTSP Notifications</span>
                <h1 class="h3 fw-bold mb-1 text-body">@(isVietnamese ? "Thông báo" : "Notifications")</h1>
                <p class="text-secondary small mb-0">
                    @(isVietnamese ? "Nhấn vào bất kỳ thông báo nào để chuyển thẳng đến nội dung và tự động đánh dấu đã đọc." : "Click on any notification to navigate directly to its destination and mark as read.")
                </p>
            </div>
            @if (Model.UnreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" class="m-0 notif-mark-all-form">
                    <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-none">
                        <i class="bi bi-check2-all" aria-hidden="true"></i>
                        <span>@(isVietnamese ? "Đánh dấu tất cả đã đọc" : "Mark all as read")</span>
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="notifications-empty-box text-center p-5 rounded-4 shadow-sm">
            <div class="empty-icon-wrap mb-3 mx-auto">
                <i class="bi bi-bell-slash text-secondary fs-1" aria-hidden="true"></i>
            </div>
            <h4 class="h5 fw-semibold text-body mb-2">@(isVietnamese ? "Chưa có thông báo" : "No notifications yet")</h4>
            <p class="text-secondary small max-w-sm mx-auto mb-0">
                @(isVietnamese ? "Khi có yêu cầu kết nối, lịch học mới hoặc tin nhắn, bạn sẽ nhận được thông báo tại đây." : "When you receive requests, session updates or messages, they will appear here.")
            </p>
        </div>
    }
    else
    {
        <!-- Danh sách thông báo (10 cái đầu tiên) -->
        <div class="notifications-list-container d-flex flex-column gap-2" id="notificationsList">
            @foreach (var notification in Model.Items)
            {
                <a href="@Url.Action("Open", "Notifications", new { id = notification.Id })"
                   class="notification-card-link @(notification.IsRead ? "is-read" : "is-unread")"
                   title="@(isVietnamese ? "Nhấn để mở chi tiết" : "Click to view details")">
                    <div class="notification-card-icon-wrap @(notification.IsRead ? "icon-muted" : "icon-brand")">
                        <i class="bi @(notification.IsRead ? "bi-bell" : "bi-bell-fill")" aria-hidden="true"></i>
                    </div>

                    <div class="notification-card-body flex-grow-1 min-w-0">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                            <h2 class="h6 @(notification.IsRead ? "fw-semibold" : "fw-bold") mb-0 text-body text-truncate">
                                @notification.Title
                            </h2>
                            <div class="d-flex align-items-center gap-2">
                                @if (!notification.IsRead)
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger px-2 py-0.5" style="font-size: 11px;">
                                        @(isVietnamese ? "Mới" : "New")
                                    </span>
                                }
                                <time class="text-secondary small text-nowrap" datetime="@notification.CreatedAt.ToString("O")">
                                    <i class="bi bi-clock me-1"></i>@notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </time>
                            </div>
                        </div>

                        <p class="notification-card-text text-secondary mb-0">@notification.Content</p>
                    </div>

                    <div class="notification-arrow ms-2 text-secondary">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </div>
                </a>
            }
        </div>

        <!-- Khung tải thêm 10 thông báo tiếp theo (AJAX Load More - Chống nghẽn tải trang) -->
        <div class="notifications-load-more-wrap text-center mt-4 p-3 border-top" id="loadMoreWrap">
            <p class="text-secondary small mb-2" id="loadMoreSummary">
                @(isVietnamese
                    ? $"Đang hiển thị {Model.Items.Count} / {Model.TotalCount} thông báo"
                    : $"Showing {Model.Items.Count} of {Model.TotalCount} notifications")
            </p>
            @if (Model.HasMore)
            {
                <button type="button" class="btn btn-outline-danger btn-sm px-4 py-2 rounded-3 shadow-none" id="btnLoadMore" data-next-page="2">
                    <span class="spinner-border spinner-border-sm d-none me-2" id="loadMoreSpinner" role="status"></span>
                    <i class="bi bi-arrow-down-circle me-1" id="loadMoreIcon"></i>
                    <span id="loadMoreText">@(isVietnamese ? "Tải thêm 10 thông báo cũ hơn" : "Load 10 more notifications")</span>
                </button>
            }
            else
            {
                <span class="badge bg-light text-secondary border px-3 py-1.5">
                    @(isVietnamese ? "Đã hiển thị tất cả thông báo" : "All notifications loaded")
                </span>
            }
        </div>
    }
</div>

<style>
/* ==================== NOTIFICATIONS MODERN STYLES ==================== */
.notifications-page-shell {
    max-width: 960px;
    margin: 1.5rem auto 3rem;
    padding: 0 1rem;
    width: 100%;
}

.badge-soft-brand {
    background-color: rgba(219, 48, 58, 0.1);
    color: #DB303A;
    font-weight: 600;
    font-size: 0.75rem;
    border-radius: 6px;
    letter-spacing: 0.02em;
}

.notifications-empty-box {
    background-color: var(--bs-card-bg, #ffffff);
    border: 1px dashed var(--bs-border-color, #e2e8f0);
}

.empty-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--bs-tertiary-bg, #f8fafc);
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Card Link: Nhấn vào toàn bộ thẻ để mở thẳng trang đích */
.notification-card-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    background-color: var(--bs-card-bg, #ffffff);
    border: 1px solid var(--bs-border-color, #eaedf1);
    text-decoration: none !important;
    color: inherit;
    transition: all 0.2s ease-in-out;
    cursor: pointer;
}

.notification-card-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
    border-color: #DB303A;
    background-color: var(--bs-card-bg, #ffffff);
}

.notification-card-link.is-unread {
    border-left: 4px solid #DB303A;
    background-color: #fffbfa;
}

[data-bs-theme="dark"] .notification-card-link.is-unread {
    background-color: #1e293b;
    border-left: 4px solid #DB303A;
}

[data-bs-theme="dark"] .notification-card-link.is-read {
    background-color: var(--bs-card-bg, #0f172a);
}

.notification-card-icon-wrap {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    transition: transform 0.2s ease;
}

.notification-card-link:hover .notification-card-icon-wrap {
    transform: scale(1.08);
}

.notification-card-icon-wrap.icon-brand {
    background-color: rgba(219, 48, 58, 0.12);
    color: #DB303A;
}

.notification-card-icon-wrap.icon-muted {
    background-color: var(--bs-tertiary-bg, #f1f5f9);
    color: var(--bs-secondary-color, #64748b);
}

.notification-card-text {
    font-size: 0.88rem;
    line-height: 1.45;
    word-break: break-word;
}

.notification-arrow {
    font-size: 0.9rem;
    opacity: 0.5;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.notification-card-link:hover .notification-arrow {
    transform: translateX(3px);
    opacity: 1;
    color: #DB303A !important;
}

/* ==================== TỐI ƯU HÓA MÀN HÌNH ĐIỆN THOẠI (< 768px) ==================== */
@@media (max-width: 767.98px) {
    .notifications-page-shell {
        margin: 1rem auto 2rem;
        padding: 0 0.5rem;
    }

    .notifications-header-box {
        margin-bottom: 1rem !important;
    }

    .notifications-header-box .d-flex {
        flex-direction: column;
        align-items: stretch !important;
        gap: 0.75rem !important;
    }

    .notifications-header-box .notif-mark-all-form button {
        width: 100%;
        justify-content: center;
        padding: 8px 16px;
    }

    .notification-card-link {
        padding: 0.75rem 0.85rem;
        gap: 0.65rem;
        border-radius: 10px;
    }

    .notification-card-icon-wrap {
        width: 36px;
        height: 36px;
        font-size: 1rem;
    }

    .notification-card-text {
        font-size: 0.82rem;
    }

    #btnLoadMore {
        width: 100%;
        padding: 10px 16px !important;
    }
}
</style>

<script>
(() => {
    const btnLoadMore = document.getElementById("btnLoadMore");
    const listContainer = document.getElementById("notificationsList");
    const summaryEl = document.getElementById("loadMoreSummary");
    const spinner = document.getElementById("loadMoreSpinner");
    const icon = document.getElementById("loadMoreIcon");
    const isVi = "@isVietnamese" === "True";

    if (!btnLoadMore || !listContainer) return;

    btnLoadMore.addEventListener("click", async () => {
        const nextPage = parseInt(btnLoadMore.dataset.nextPage || "2", 10);

        // Hiển thị loading
        btnLoadMore.disabled = true;
        if (spinner) spinner.classList.remove("d-none");
        if (icon) icon.classList.add("d-none");

        try {
            const res = await fetch(`/Notifications/LoadMore?page=${nextPage}`, {
                headers: { "Accept": "application/json" }
            });
            if (!res.ok) throw new Error();
            const data = await res.json();

            if (data.success && data.items && data.items.length > 0) {
                data.items.forEach(item => {
                    const a = document.createElement("a");
                    a.href = `/Notifications/Open?id=${item.id}`;
                    a.className = `notification-card-link ${item.isRead ? "is-read" : "is-unread"}`;
                    a.title = isVi ? "Nhấn để mở chi tiết" : "Click to view details";

                    const dateFormatted = new Date(item.createdAt).toLocaleString(isVi ? "vi-VN" : "en-GB", {
                        day: "2-digit", month: "2-digit", year: "numeric",
                        hour: "2-digit", minute: "2-digit"
                    });

                    a.innerHTML = `
                        <div class="notification-card-icon-wrap ${item.isRead ? "icon-muted" : "icon-brand"}">
                            <i class="bi ${item.isRead ? "bi-bell" : "bi-bell-fill"}" aria-hidden="true"></i>
                        </div>
                        <div class="notification-card-body flex-grow-1 min-w-0">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                <h2 class="h6 ${item.isRead ? "fw-semibold" : "fw-bold"} mb-0 text-body text-truncate">
                                    ${item.title || ""}
                                </h2>
                                <div class="d-flex align-items-center gap-2">
                                    ${!item.isRead ? `<span class="badge rounded-pill bg-danger-subtle text-danger px-2 py-0.5" style="font-size: 11px;">${isVi ? "Mới" : "New"}</span>` : ""}
                                    <time class="text-secondary small text-nowrap">
                                        <i class="bi bi-clock me-1"></i>${dateFormatted}
                                    </time>
                                </div>
                            </div>
                            <p class="notification-card-text text-secondary mb-0">${item.content || ""}</p>
                        </div>
                        <div class="notification-arrow ms-2 text-secondary">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </div>
                    `;

                    listContainer.appendChild(a);
                });

                // Cập nhật tóm tắt
                if (summaryEl) {
                    summaryEl.textContent = isVi
                        ? `Đang hiển thị ${data.loadedCount} / ${data.totalCount} thông báo`
                        : `Showing ${data.loadedCount} of ${data.totalCount} notifications`;
                }

                // Cập nhật trạng thái trang tiếp theo
                btnLoadMore.dataset.nextPage = String(nextPage + 1);

                if (!data.hasMore) {
                    btnLoadMore.parentElement.innerHTML = `
                        <p class="text-secondary small mb-2">${isVi ? `Đang hiển thị ${data.totalCount} / ${data.totalCount} thông báo` : `Showing ${data.totalCount} of ${data.totalCount} notifications`}</p>
                        <span class="badge bg-light text-secondary border px-3 py-1.5">${isVi ? "Đã hiển thị tất cả thông báo" : "All notifications loaded"}</span>
                    `;
                }
            }
        } catch (e) {
            console.error("Lỗi khi tải thêm thông báo:", e);
        } finally {
            btnLoadMore.disabled = false;
            if (spinner) spinner.classList.add("d-none");
            if (icon) icon.classList.remove("d-none");
        }
    });
})();
</script>
