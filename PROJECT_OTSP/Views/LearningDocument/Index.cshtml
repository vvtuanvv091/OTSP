@using PROJECT_OTSP.Dtos.Common
@model IReadOnlyList<PublicLearningDocumentDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Tài liệu ôn tập";
    var subjects = (ViewBag.Subjects as List<SubjectFilterItemDto>) ?? new List<SubjectFilterItemDto>();
    var gradeLevels = (ViewBag.GradeLevels as List<GradeLevelFilterItemDto>) ?? new List<GradeLevelFilterItemDto>();
    var selectedSubjectId = ViewBag.SelectedSubjectId as int?;
    var selectedGradeLevelId = ViewBag.SelectedGradeLevelId as int?;
    var search = (ViewBag.Search as string) ?? "";
    var totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : Model.Count;
    var currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
}

<style>
    .learning-doc-shell {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }
    .doc-hero-section {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 2rem 1.5rem;
        margin-bottom: 2rem;
    }
    [data-bs-theme="dark"] .doc-hero-section {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-color: #334155;
    }
    .doc-type-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .icon-pdf { background-color: #fee2e2; color: #dc2626; }
    .icon-word { background-color: #e0e7ff; color: #3730a3; }
    .icon-excel { background-color: #dcfce7; color: #166534; }
    .icon-ppt { background-color: #ffedd5; color: #c2410c; }
    .icon-file { background-color: #f1f5f9; color: #475569; }
</style>

<div class="learning-doc-shell">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item text-muted">Môn học</li>
            <li class="breadcrumb-item active fw-semibold text-danger" aria-current="page">Tài liệu ôn tập</li>
        </ol>
    </nav>

    <!-- Hero Banner -->
    <div class="doc-hero-section">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle mb-2 px-2.5 py-1">
                    <i class="bi bi-folder-check me-1"></i> Kho tài liệu công khai
                </span>
                <h1 class="h2 fw-bold mb-2 text-body">Tài Liệu Ôn Tập Tuyển Chọn</h1>
                <p class="text-secondary mb-0">
                    Tổng hợp các tài liệu ôn thi, đề cương chi tiết và bài giảng tham khảo do đội ngũ gia sư OTSP chia sẻ miễn phí cho cộng đồng học viên.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <span class="badge bg-white text-dark border p-2 px-3 shadow-sm">
                    <i class="bi bi-file-earmark-text me-1 text-danger"></i>
                    Tổng cộng: <strong>@totalItems</strong> tài liệu
                </span>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm kiếm tên tài liệu, chủ đề..." value="@search" />
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select name="subjectId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả môn học --</option>
                        @foreach (var s in subjects)
                        {
                            <option value="@s.Id" selected="@(selectedSubjectId == s.Id ? "selected" : null)">@s.Name</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <select name="gradeLevelId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả cấp học --</option>
                        @foreach (var g in gradeLevels)
                        {
                            <option value="@g.Id" selected="@(selectedGradeLevelId == g.Id ? "selected" : null)">@g.Name</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-danger btn-sm flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    @if (!string.IsNullOrWhiteSpace(search) || selectedSubjectId.HasValue || selectedGradeLevelId.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Xóa bộ lọc">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Document List Table -->
    <div class="card border shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
            <h2 class="h6 fw-bold mb-0 text-dark">
                <i class="bi bi-journal-text me-2 text-danger"></i>
                Danh sách tài liệu ôn tập
                <span class="badge border border-secondary text-secondary ms-1 fw-normal">@totalItems tài liệu</span>
            </h2>
        </div>
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-folder-x fs-1 text-secondary d-block mb-2"></i>
                    <h5 class="fw-semibold text-dark">Không tìm thấy tài liệu phù hợp</h5>
                    <p class="small text-secondary mb-0">Hãy thử thay đổi từ khóa tìm kiếm hoặc bộ lọc môn học/cấp học.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="min-width: 260px;">Tài liệu</th>
                                <th style="min-width: 140px;">Môn học</th>
                                <th style="min-width: 130px;">Cấp học</th>
                                <th style="min-width: 160px;">Gia sư chia sẻ</th>
                                <th style="min-width: 110px;">Ngày đăng</th>
                                <th style="min-width: 120px;" class="text-end pe-3">Tải về</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var idx = (currentPage - 1) * 8;
                            }
                            @foreach (var doc in Model)
                            {
                                idx++;
                                var ext = (doc.FileExtension ?? "").ToLowerInvariant();
                                var iconClass = ext switch
                                {
                                    ".pdf" => "bi-file-earmark-pdf icon-pdf",
                                    ".doc" or ".docx" => "bi-file-earmark-word icon-word",
                                    ".xls" or ".xlsx" => "bi-file-earmark-excel icon-excel",
                                    ".ppt" or ".pptx" => "bi-file-earmark-ppt icon-ppt",
                                    _ => "bi-file-earmark-text icon-file"
                                };

                                <tr>
                                    <td class="text-center text-muted small">@idx</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2.5">
                                            <div class="doc-type-icon @iconClass.Split(' ')[1]">
                                                <i class="bi @iconClass.Split(' ')[0]"></i>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="fw-semibold text-dark text-break">@doc.Title</div>
                                                @if (!string.IsNullOrWhiteSpace(doc.Description))
                                                {
                                                    <div class="text-muted small text-truncate" style="max-width: 320px; font-size: 0.82rem;">
                                                        @doc.Description
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge border border-primary text-primary bg-transparent fw-normal">@doc.SubjectName</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">@doc.GradeLevelName</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <div class="student-avatar-circle" style="width: 26px; height: 26px; font-size: 11px; border-radius: 50%; background: #e2e8f0; color: #334155; display: inline-flex; align-items: center; justify-content: center; font-weight: 600;">
                                                @(string.IsNullOrWhiteSpace(doc.TutorName) ? "G" : doc.TutorName.Trim().Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="text-dark small">@doc.TutorName</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary small text-nowrap">
                                        @doc.UploadedAt.AddHours(7).ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-outline-success btn-sm py-1 px-2.5 text-nowrap d-inline-flex align-items-center gap-1" title="Tải xuống tệp">
                                            <i class="bi bi-download"></i> Tải về
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Phân trang chuẩn ‹ Trước 1 2 ... Sau › -->
        @if (ViewBag.Pagination is PROJECT_OTSP.Dtos.PaginationVm pagination)
        {
            <div class="card-footer bg-white border-top py-3">
                @await Html.PartialAsync("_PaginationBar", pagination)
            </div>
        }
    </div>
</div>

