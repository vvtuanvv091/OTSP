@{
    var portalHeading = ViewData["PortalHeading"] as string ?? "Khám phá OTSP";
    var portalLead = ViewData["PortalLead"] as string ?? "Học tập theo cách phù hợp với bạn.";
    var portalEyebrow = ViewData["PortalEyebrow"] as string ?? "Nền tảng học tập OTSP";
    var portalCrumb = ViewData["PortalCrumb"] as string ?? portalHeading;
}
<section class="portal-hero">
    <div class="portal-container">
        <nav class="portal-breadcrumb" aria-label="Điều hướng">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span>@portalCrumb</span>
        </nav>
        <span class="portal-eyebrow">@portalEyebrow</span>
        <h1 class="portal-title">@portalHeading</h1>
        <p class="portal-lead">@portalLead</p>
    </div>
</section>
