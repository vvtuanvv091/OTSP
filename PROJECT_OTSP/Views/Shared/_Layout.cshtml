<!DOCTYPE html>
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "vi";
    var theme = Context.Request.Cookies["otsp-theme"] == "dark" ? "dark" : "light";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isVietnamese = culture == "vi";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomePage = currentController == "Home" && currentAction == "Index";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var logoutReturnUrl = Url.Action("Index", "Home", new { area = "" }) ?? "/";
}
<html lang="@culture" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - OTSP</title>

    <!-- Prevent Dark/Light theme flicker before DOM render -->
    <script>
        (function () {
            var match = document.cookie.match(/(^|; )otsp-theme=([^;]+)/);
            if (match && (match[2] === 'dark' || match[2] === 'light')) {
                document.documentElement.setAttribute('data-bs-theme', match[2]);
            }
        })();
    </script>

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Poppins:wght@500;600;700&family=Raleway:wght@600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Poppins:wght@500;600;700&family=Raleway:wght@600;700&display=swap" rel="stylesheet">
    </noscript>

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    
    <!-- Theme & Custom CSS Files -->
    <link href="~/assets/css/main.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/otsp-home.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/otsp-pages.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/otsp-red-theme.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/otsp-components.css" rel="stylesheet" asp-append-version="true">
    @if (ViewContext.RouteData.Values["area"]?.ToString() == "Student_Parent" || ViewContext.RouteData.Values["area"]?.ToString() == "Tutor")
    {
        <link href="~/css/student-sidebar.css" rel="stylesheet" asp-append-version="true">
        @if (ViewContext.RouteData.Values["area"]?.ToString() == "Tutor" || User.IsInRole("Tutor"))
        {
            <link href="~/css/tutor-sidebar.css" rel="stylesheet" asp-append-version="true">
        }
    }
</head>
<body class="index-page">

    <!-- ==================== HEADER ==================== -->
    <header id="header" class="header sticky-top">
        <!-- Top Toolbar -->
        <div class="header-top">
            <div class="container-fluid container-xl d-flex align-items-center justify-content-between">
                <!-- Slogan / Tagline on the left (matching user screenshot) -->
                <div class="header-top-tagline text-truncate d-none d-sm-flex align-items-center">
                    <span>@(isVietnamese ? "Nền tảng kết nối Gia sư - Học viên online" : "Online Tutoring Platform - Connect Tutors & Students")</span>
                </div>

                <!-- Right Tools: Guest tools OR User Capsule (Student_Parent / Tutor on top row) -->
                <div class="header-top-right d-flex align-items-center gap-2 ms-auto">
                    @if (!isSignedIn)
                    {
                        <!-- Language Switcher (Desktop only) -->
                        <form asp-area="" asp-controller="SetLanguage" asp-action="SetPreferences" method="post" class="header-language d-none d-md-inline-flex" aria-label="Language">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" name="culture" value="vi" class="header-control @(culture == "vi" ? "active" : "")" aria-pressed="@(culture == "vi")">VI</button>
                            <button type="submit" name="culture" value="en" class="header-control @(culture == "en" ? "active" : "")" aria-pressed="@(culture == "en")">EN</button>
                        </form>

                        <!-- Theme Toggle Button (Desktop only) -->
                        <form asp-area="" asp-controller="SetLanguage" asp-action="SetPreferences" method="post" class="header-theme-form d-none d-md-inline-flex">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" id="themeToggleBtn" name="theme" value="@(theme == "dark" ? "light" : "dark")"
                                    class="header-circle-btn header-theme-toggle"
                                    aria-label="@(theme == "dark" ? (isVietnamese ? "Chuyển sang giao diện sáng" : "Switch to light theme") : (isVietnamese ? "Chuyển sang giao diện tối" : "Switch to dark theme"))"
                                    title="@(theme == "dark" ? (isVietnamese ? "Giao diện sáng" : "Light theme") : (isVietnamese ? "Giao diện tối" : "Dark theme"))">
                            <i class="bi @(theme == "dark" ? "bi-sun-fill text-warning" : "bi-moon-stars")" aria-hidden="true"></i>
                        </button>
                    </form>
                    }

                    <!-- User Account Capsule (Tong Ngoc ˅ with notifications badge) OR Login / Register -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>

        <!-- Main Navigation Bar -->
        <div class="container-fluid container-xl position-relative header-main-nav">
            <div class="d-flex align-items-center justify-content-between w-100 py-2">
                <!-- Brand Logo -->
                <a asp-area="" asp-controller="Home" asp-action="Index" class="logo otsp-brand d-flex flex-column align-items-start text-decoration-none me-auto" aria-label="OTSP - Trang chủ">
                    <div class="d-flex align-items-center">
                        <span class="otsp-brand-mark"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
                        <span class="otsp-brand-name ms-2">OTSP</span>
                    </div>
                    <span class="otsp-brand-tagline d-block d-md-none">Nền tảng kết nối gia sư - học viên online</span>
                </a>

                <!-- Navigation Links -->
                <nav id="navmenu" class="navmenu">
                    <ul>
                        <!-- Mobile Drawer Header: Brand + Close placeholder (Mobile only) -->
                        <li class="mobile-drawer-header d-xl-none d-flex align-items-center justify-content-between">
                            <div class="logo otsp-brand d-flex align-items-center">
                                <span class="otsp-brand-mark"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
                                <span class="otsp-brand-name ms-2">OTSP</span>
                            </div>
                        </li>

                        <li class="mobile-drawer-item"><a asp-area="" asp-controller="Home" asp-action="Index" class="@(isHomePage ? "active" : "")">@(isVietnamese ? "Trang chủ" : "Home")</a></li>
                        <li class="mobile-drawer-item dropdown"><a href="#"><span>@(isVietnamese ? "Gia Sư" : "Tutors")</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                                <li><a asp-controller="Search" asp-action="Index">Tìm Gia Sư</a></li>
                                <li><a asp-area="Identity" asp-page="/Account/Register">Đăng Ký Gia Sư</a></li>
                            </ul>
                        </li>
                        
                        <li class="mobile-drawer-item dropdown"><a href="#"><span>@(isVietnamese ? "Môn Học" : "Subjects")</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                              <li><a href="/#features">Danh Sách Môn Học</a></li>
                              <li><a asp-area="" asp-controller="LearningDocument" asp-action="Index">Tài Liệu Ôn Tập</a></li>
                            </ul>
                        </li>
                        <li class="mobile-drawer-item"><a href="/#footer">@(isVietnamese ? "Trung Tâm" : "English Center")</a></li>
                        <li class="mobile-drawer-item"><a href="/#trainers-index">@(isVietnamese ? "Tin Tức" : "News")</a></li>
                      
                        <li class="mobile-drawer-item dropdown"><a href="#"><span>@(isVietnamese ? "Giới thiệu" : "About")</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                              <li><a href="/#why-us">Hướng Dẫn Sử Dụng</a></li>
                              <li><a href="/#hero">Câu Hỏi Thường Gặp</a></li>
                              <li><a href="/#footer">Điều Khoản Sử Dụng</a></li>
                              <li><a href="/#footer">Chính Sách Bảo Mật</a></li>
                              <li><a href="/#footer">Liên Hệ</a></li>
                            </ul>
                        </li>

                        @if (!isSignedIn)
                        {
                            <!-- Mobile Drawer Auth Buttons for Guests (matching mockup) -->
                            <li class="mobile-drawer-auth d-xl-none">
                                <a class="mobile-drawer-btn-login mb-2" asp-area="Identity" asp-page="/Account/Login">
                                    @(isVietnamese ? "Đăng nhập" : "Log in")
                                </a>
                                <a class="mobile-drawer-btn-register" asp-area="Identity" asp-page="/Account/Register">
                                    @(isVietnamese ? "Đăng ký" : "Register")
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Mobile Drawer Auth Button for Logged in user -->
                            <li class="mobile-drawer-auth d-xl-none">
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@logoutReturnUrl" method="post" class="m-0">
                                    <button type="submit" class="btn btn-outline-danger w-100 py-2 fw-semibold rounded-pill text-center d-flex align-items-center justify-content-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>@(isVietnamese ? "Đăng xuất" : "Log out")</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
                </nav>

                <!-- Search Button on Desktop -->
                <a class="btn-getstarted d-none d-md-inline-flex" asp-controller="Search" asp-action="Index">@(isVietnamese ? "Tìm gia sư" : "Find a tutor")</a>
            </div>

            <!-- On mobile (< 768px): Full-width prominent "Tìm gia sư" button below brand row, exactly like user mockup! -->
            <div class="header-mobile-search-bar d-md-none w-100 pb-2">
                <a class="btn btn-getstarted w-100 text-center py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" asp-controller="Search" asp-action="Index">
                    <i class="bi bi-search"></i>
                    <span>@(isVietnamese ? "Tìm gia sư" : "Find a tutor")</span>
                </a>
            </div>
        </div>
    </header>

    <!-- ==================== MAIN CONTENT ==================== -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ==================== FOOTER ==================== -->
    <footer id="footer" class="footer position-relative">
        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center text-decoration-none">
                        <span class="sitename">OTSP</span>
                    </a>
                    <p class="pt-3">
                        @(isVietnamese 
                            ? "Nền tảng kết nối gia sư và học viên trực tuyến hàng đầu. Đội ngũ gia sư được kiểm định bằng cấp nghiêm ngặt, học phí minh bạch và hỗ trợ học thử linh hoạt." 
                            : "Premier online tutoring platform connecting verified tutors and students with transparent pricing and flexible schedules.")
                    </p>
                    <div class="footer-contact pt-2">
                        <p><i class="bi bi-telephone-fill me-2 text-danger"></i><strong>Hotline:</strong> <span>(+84) 984 391 940</span></p>
                        <p><i class="bi bi-envelope-fill me-2 text-danger"></i><strong>Email:</strong> <span>support@otsp.vn</span></p>
                    </div>
                    <div class="social-links d-flex gap-2 mt-4">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2 col-md-3 footer-links">
                    <h4>@(isVietnamese ? "Khám phá" : "Explore")</h4>
                    <ul class="list-unstyled">
                        <li><a href="/#features">@(isVietnamese ? "Danh mục môn học" : "Subjects")</a></li>
                        <li><a href="/#courses">@(isVietnamese ? "Lớp học đang mở" : "Active Classes")</a></li>
                        <li><a href="/#trainers-index">@(isVietnamese ? "Gia sư tiêu biểu" : "Top Tutors")</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register">@(isVietnamese ? "Đăng ký gia sư" : "Become Tutor")</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2 col-md-3 footer-links">
                    <h4>@(isVietnamese ? "Thông tin" : "Information")</h4>
                    <ul class="list-unstyled">
                        <li><a href="/#why-us">@(isVietnamese ? "Về OTSP" : "About Us")</a></li>
                        <li><a href="/#hero">@(isVietnamese ? "Quy định học thử" : "Trial Policy")</a></li>
                        <li><a href="/#footer">@(isVietnamese ? "Chính sách bảo mật" : "Privacy Policy")</a></li>
                        <li><a href="/#footer">@(isVietnamese ? "Điều khoản dịch vụ" : "Terms of Service")</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 footer-newsletter">
                    <h4>@(isVietnamese ? "Nhận bản tin giáo dục" : "Newsletter")</h4>
                    <p>@(isVietnamese ? "Đăng ký email để nhận thông tin ưu đãi học tập và các mẹo ôn thi hữu ích." : "Subscribe to receive study tips and exclusive tutoring offers.")</p>
                    <form onsubmit="event.preventDefault(); alert('@(isVietnamese ? "Cảm ơn bạn đã đăng ký nhận tin!" : "Thank you for subscribing!")');" class="php-email-form">
                        <div class="newsletter-form">
                            <input type="email" name="email" placeholder="@(isVietnamese ? "Nhập email của bạn..." : "Your email address...")" required>
                            <input type="submit" value="@(isVietnamese ? "Đăng ký" : "Subscribe")">
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="container copyright text-center mt-4 pt-3 border-top">
            <p class="mb-0 text-muted small">
                © <strong>OTSP</strong>. @(isVietnamese ? "Bảo lưu mọi quyền." : "All rights reserved.")
            </p>
        </div>
    </footer>

    <!-- Scroll Top Button -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center" aria-label="Lên đầu trang">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    <div id="preloader"></div>

    <!-- Vendor Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <!-- SignalR for real-time notifications & messages -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>

    <!-- Main Site Script -->
    <script src="~/assets/js/main.js"></script>
    <script src="~/assets/js/preloader.js" asp-append-version="true"></script>
    <script src="~/js/otsp-common.js" asp-append-version="true"></script>

    <!-- Instant Dark/Light Theme Switching Script (No page reload) -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('themeToggleBtn');
            if (!toggleBtn) return;

            toggleBtn.addEventListener('click', function (e) {
                e.preventDefault();
                var html = document.documentElement;
                var currentTheme = html.getAttribute('data-bs-theme') || 'light';
                var nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

                html.setAttribute('data-bs-theme', nextTheme);

                var icon = toggleBtn.querySelector('i');
                if (icon) {
                    if (nextTheme === 'dark') {
                        icon.className = 'bi bi-sun-fill text-warning';
                    } else {
                        icon.className = 'bi bi-moon-stars';
                    }
                }
                toggleBtn.value = nextTheme === 'dark' ? 'light' : 'dark';
                toggleBtn.setAttribute('title', nextTheme === 'dark' ? 'Giao diện sáng' : 'Giao diện tối');

                document.cookie = 'otsp-theme=' + nextTheme + ';path=/;max-age=31536000;SameSite=Lax';

                var form = toggleBtn.closest('form');
                if (form) {
                    var formData = new FormData(form);
                    formData.set('theme', nextTheme);
                    fetch(form.action, { method: 'POST', body: formData }).catch(function () {});
                }
            });
        });

        // Close mobile drawer when clicking backdrop
        document.addEventListener('click', function (e) {
            if (document.body.classList.contains('mobile-nav-active')) {
                var navMenu = document.getElementById('navmenu');
                var navList = navMenu ? navMenu.querySelector('ul') : null;
                var toggleBtn = document.querySelector('.mobile-nav-toggle');
                if (navList && !navList.contains(e.target) && (!toggleBtn || !toggleBtn.contains(e.target))) {
                    document.body.classList.remove('mobile-nav-active');
                    if (toggleBtn) {
                        toggleBtn.classList.remove('bi-x');
                        toggleBtn.classList.add('bi-list');
                    }
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
