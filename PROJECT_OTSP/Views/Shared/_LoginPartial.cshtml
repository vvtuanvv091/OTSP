@using Microsoft.AspNetCore.Identity
@using PROJECT_OTSP.Models
@{
    var isVietnamese = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "vi";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var fallbackName = User.Identity?.Name ?? "";
    var summaryUrl = Url.Action("Summary", "Header", new { area = "" }) ?? "/Header/Summary";
    var notificationsUrl = Url.Action("Index", "Notifications", new { area = "" }) ?? "/Notifications";
    var logoutReturnUrl = Url.Action("Index", "Home", new { area = "" });
}

<style>
/* Notification & Account Tools scoped styles */
.header-account-tools {
    display: inline-flex;
    align-items: center;
    gap: 12px;
}
.header-notifications {
    position: relative;
}
.header-circle-btn,
.header-notification-trigger {
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    min-height: 36px !important;
    max-width: 36px !important;
    max-height: 36px !important;
    border-radius: 50% !important;
    border: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    color: #475569 !important;
    font-size: 16px !important;
    cursor: pointer !important;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 1 !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;
}
.header-circle-btn:hover,
.header-circle-btn[aria-expanded="true"],
.header-notification-trigger:hover,
.header-notification-trigger[aria-expanded="true"] {
    background-color: #fff5f5 !important;
    border-color: #dc3545 !important;
    color: #dc3545 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.15) !important;
    transform: translateY(-1px);
}
.header-circle-btn:active,
.header-notification-trigger:active {
    transform: translateY(0);
}
[data-bs-theme="dark"] .header-circle-btn,
[data-bs-theme="dark"] .header-notification-trigger {
    background: #1e293b !important;
    border-color: #334155 !important;
    color: #cbd5e1 !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2) !important;
}
[data-bs-theme="dark"] .header-circle-btn:hover,
[data-bs-theme="dark"] .header-circle-btn[aria-expanded="true"],
[data-bs-theme="dark"] .header-notification-trigger:hover,
[data-bs-theme="dark"] .header-notification-trigger[aria-expanded="true"] {
    border-color: #ef4444 !important;
    color: #ef4444 !important;
    background-color: rgba(239, 68, 68, 0.15) !important;
}
.header-mark-read {
    background: transparent !important;
    border: none !important;
    color: #4f46e5 !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    padding: 0 !important;
    text-decoration: none !important;
    transition: opacity 0.15s ease !important;
}
.header-mark-read:hover {
    color: #4338ca !important;
    opacity: 0.85;
    text-decoration: underline !important;
}
[data-bs-theme="dark"] .header-mark-read {
    color: #818cf8 !important;
}
[data-bs-theme="dark"] .header-mark-read:hover {
    color: #a5b4fc !important;
}
.header-notification-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #dc3545;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 2px solid #ffffff;
    line-height: 1;
}
[data-bs-theme="dark"] .header-notification-count {
    border-color: #1e293b;
}
.header-notification-menu {
    width: min(380px, calc(100vw - 24px)) !important;
    max-width: 400px;
    padding: 0 !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 14px !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12) !important;
    background: #ffffff !important;
    overflow: hidden !important;
}
[data-bs-theme="dark"] .header-notification-menu {
    background: #1e293b !important;
    border-color: #334155 !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35) !important;
}
.header-dropdown-heading {
    padding: 13px 18px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
}
[data-bs-theme="dark"] .header-dropdown-heading {
    background: #1e293b;
    border-bottom-color: #334155;
}
.header-dropdown-heading strong {
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
}
[data-bs-theme="dark"] .header-dropdown-heading strong {
    color: #f8fafc;
}
.header-notification-list {
    max-height: 380px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
}
.header-notification-item {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start !important;
    gap: 12px !important;
    padding: 13px 18px !important;
    border-bottom: 1px solid #f1f5f9 !important;
    text-decoration: none !important;
    color: inherit !important;
    background: #ffffff !important;
    transition: background-color 0.15s ease !important;
    border-left: 3px solid transparent !important;
}
.header-notification-item:last-child {
    border-bottom: none !important;
}
.header-notification-item:hover {
    background-color: #f8fafc !important;
}
.header-notification-item.is-unread {
    background-color: #f8faff !important;
    border-left: 3px solid #6366f1 !important;
}
.header-notification-item.is-unread:hover {
    background-color: #eff6ff !important;
}
[data-bs-theme="dark"] .header-notification-item {
    background: #1e293b !important;
    border-bottom-color: #334155 !important;
}
[data-bs-theme="dark"] .header-notification-item:hover {
    background-color: #27354a !important;
}
[data-bs-theme="dark"] .header-notification-item.is-unread {
    background-color: #1e2238 !important;
    border-left-color: #818cf8 !important;
}
[data-bs-theme="dark"] .header-notification-item.is-unread:hover {
    background-color: #262c4a !important;
}
.header-notif-icon-wrap {
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    min-height: 36px !important;
    border-radius: 50% !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 15px !important;
    flex-shrink: 0 !important;
    margin-top: 2px !important;
    background: #f1f5f9 !important;
    color: #94a3b8 !important;
}
.header-notif-icon-wrap.is-unread,
.header-notification-item.is-unread .header-notif-icon-wrap {
    background: #eef2ff !important;
    color: #4f46e5 !important;
}
[data-bs-theme="dark"] .header-notif-icon-wrap {
    background: #334155 !important;
    color: #94a3b8 !important;
}
[data-bs-theme="dark"] .header-notif-icon-wrap.is-unread,
[data-bs-theme="dark"] .header-notification-item.is-unread .header-notif-icon-wrap {
    background: rgba(99, 102, 241, 0.2) !important;
    color: #a5b4fc !important;
}
.header-notification-copy {
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    flex: 1 !important;
    min-width: 0 !important;
}
.header-notif-title {
    font-size: 13.5px !important;
    font-weight: 600 !important;
    color: #1e293b !important;
    line-height: 1.35 !important;
    display: block !important;
    margin-bottom: 2px !important;
}
.header-notification-item.is-unread .header-notif-title {
    font-weight: 700 !important;
    color: #0f172a !important;
}
[data-bs-theme="dark"] .header-notif-title {
    color: #e2e8f0 !important;
}
[data-bs-theme="dark"] .header-notification-item.is-unread .header-notif-title {
    color: #ffffff !important;
}
.header-notif-body {
    font-size: 12.5px !important;
    font-weight: 400 !important;
    color: #475569 !important;
    line-height: 1.45 !important;
    display: block !important;
    word-break: break-word !important;
}
[data-bs-theme="dark"] .header-notif-body {
    color: #94a3b8 !important;
}
.header-notif-time {
    font-size: 11.5px !important;
    color: #94a3b8 !important;
    margin-top: 3px !important;
    display: flex !important;
    align-items: center !important;
    gap: 4px !important;
}
[data-bs-theme="dark"] .header-notif-time {
    color: #64748b !important;
}
.header-notifications-empty {
    padding: 36px 16px !important;
    text-align: center !important;
    color: #94a3b8 !important;
    font-size: 14px !important;
    margin: 0 !important;
}
[data-bs-theme="dark"] .header-notifications-empty {
    color: #64748b !important;
}
.header-notifications-all {
    display: block !important;
    text-align: center !important;
    padding: 12px 16px !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    color: #4f46e5 !important;
    text-decoration: none !important;
    background-color: #ffffff !important;
    border-top: 1px solid #f1f5f9 !important;
    transition: all 0.15s ease !important;
}
.header-notifications-all:hover {
    background-color: #f8fafc !important;
    color: #4338ca !important;
    text-decoration: none !important;
}
[data-bs-theme="dark"] .header-notifications-all {
    background-color: #1e293b !important;
    border-top-color: #334155 !important;
    color: #818cf8 !important;
}
[data-bs-theme="dark"] .header-notifications-all:hover {
    background-color: #27354a !important;
    color: #a5b4fc !important;
}
</style>

<div class="header-auth-links">
@if (isSignedIn)
{
    <div class="header-account-tools" id="headerAccountTools"
         data-summary-url="@summaryUrl"
         data-notifications-url="@notificationsUrl"
         data-vi="@(isVietnamese ? "1" : "0")">

        <!-- Notification Bell Dropdown -->
        <div class="dropdown header-notifications">
            <button type="button" class="header-circle-btn header-notification-trigger" data-bs-toggle="dropdown" aria-expanded="false"
                    aria-label="@(isVietnamese ? "Thông báo" : "Notifications")">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="header-notification-count d-none" data-role="unread"></span>
            </button>

            <div class="dropdown-menu dropdown-menu-end header-notification-menu shadow">
                <div class="header-dropdown-heading">
                    <strong>@(isVietnamese ? "Thông báo" : "Notifications")</strong>
                    <button type="button" class="header-mark-read" data-role="mark-read">
                        @(isVietnamese ? "Đánh dấu đã đọc hết" : "Mark all as read")
                    </button>
                </div>

                <p class="header-notifications-empty" data-role="empty">
                    @(isVietnamese ? "Chưa có thông báo nào." : "No notifications yet.")
                </p>
                <div class="header-notification-list" data-role="list"></div>

                <a class="header-notifications-all" asp-area="" asp-controller="Notifications" asp-action="Index">
                    @(isVietnamese ? "Xem tất cả thông báo" : "See all notifications")
                </a>
            </div>
        </div>

        <!-- User Profile Dropdown -->
        <div class="dropdown header-user-dropdown">
            <button type="button" class="header-user-trigger" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="header-user-avatar header-user-avatar-fallback" data-role="avatar-fallback">
                    <i class="bi bi-person-fill" aria-hidden="true"></i>
                </span>
                <img class="header-user-avatar d-none" data-role="avatar" alt="Avatar" referrerpolicy="no-referrer" />
                <span class="header-user-name" data-role="name">@fallbackName</span>
                <i class="bi bi-chevron-down header-user-chevron ms-1" aria-hidden="true"></i>
            </button>

            <div class="dropdown-menu dropdown-menu-end header-user-menu shadow-lg">
                <div class="header-user-menu-heading">
                    <strong data-role="menu-name">@fallbackName</strong>
                    <small data-role="menu-email" class="text-truncate"></small>
                </div>

                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="MyAccount">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>@(isVietnamese ? "Bàn làm việc của tôi" : "My Dashboard")
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="dropdown-item" asp-area="Admin" asp-controller="TutorApprovals" asp-action="Index">
                        <i class="bi bi-person-check" aria-hidden="true"></i>@(isVietnamese ? "Duyệt hồ sơ gia sư" : "Review tutor profiles")
                    </a>
                }

                @if (User.IsInRole("Tutor"))
                {
                    <a class="dropdown-item" asp-area="Tutor" asp-controller="TutorProfile" asp-action="Index">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>@(isVietnamese ? "Hồ sơ gia sư" : "Tutor Profile")
                    </a>
                    <a class="dropdown-item" asp-area="Tutor" asp-controller="TutorConnectionRequest" asp-action="Index">
                        <i class="bi bi-chat-left-text" aria-hidden="true"></i>@(isVietnamese ? "Yêu cầu kết nối" : "Connection Requests")
                    </a>
                }
                else if (User.IsInRole("Student_Parent"))
                {
                    <a class="dropdown-item" asp-area="Student_Parent" asp-controller="Student_Parent_Profile" asp-action="Index">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>@(isVietnamese ? "Hồ sơ học viên" : "Student Profile")
                    </a>
                }

                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-gear" aria-hidden="true"></i>@(isVietnamese ? "Cài đặt tài khoản" : "Account settings")
                </a>

                <div class="dropdown-divider"></div>

                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@logoutReturnUrl" method="post" class="m-0">
                    <button type="submit" class="dropdown-item header-user-logout">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>@(isVietnamese ? "Đăng xuất" : "Log out")
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
    (() => {
        const box = document.getElementById('headerAccountTools');
        if (!box || !box.dataset.summaryUrl) return;

        const q = sel => box.querySelector(sel);
        const isVi = box.dataset.vi === '1';

        fetch(box.dataset.summaryUrl, {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        })
        .then(res => res.ok ? res.json() : null)
        .then(data => { if (data) render(data); })
        .catch(() => { /* Giữ fallback cookie name */ });

        function render({ user, unread, items }) {
            if (user) {
                if (q('[data-role="name"]')) q('[data-role="name"]').textContent = user.name || '';
                if (q('[data-role="menu-name"]')) q('[data-role="menu-name"]').textContent = user.name || '';
                if (q('[data-role="menu-email"]')) q('[data-role="menu-email"]').textContent = user.email || '';

                if (user.avatarUrl) {
                    const img = q('[data-role="avatar"]');
                    const fallback = q('[data-role="avatar-fallback"]');
                    if (img) {
                        img.onerror = () => {
                            img.classList.add('d-none');
                            if (fallback) fallback.classList.remove('d-none');
                        };
                        img.src = user.avatarUrl;
                        img.classList.remove('d-none');
                    }
                    if (fallback) fallback.classList.add('d-none');
                }
            }

            const badge = q('[data-role="unread"]');
            if (badge) {
                if (unread > 0) {
                    badge.textContent = unread > 99 ? '99+' : String(unread);
                    badge.classList.remove('d-none');
                } else {
                    badge.textContent = '';
                    badge.classList.add('d-none');
                }
            }

            const emptyEl = q('[data-role="empty"]');
            const list = q('[data-role="list"]');
            if (items && items.length > 0) {
                if (emptyEl) emptyEl.classList.add('d-none');
                if (list) {
                    list.innerHTML = '';
                    list.classList.remove('d-none');
                    items.forEach(n => list.appendChild(notificationItem(n)));
                }
            } else {
                if (emptyEl) emptyEl.classList.remove('d-none');
                if (list) {
                    list.innerHTML = '';
                    list.classList.add('d-none');
                }
            }
        }

        const markReadBtn = q('[data-role="mark-read"]');
        if (markReadBtn) {
            markReadBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();
                try {
                    const res = await fetch('/Notifications/MarkAllAsRead', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    if (res.ok) {
                        const badge = q('[data-role="unread"]');
                        if (badge) {
                            badge.textContent = '';
                            badge.classList.add('d-none');
                        }
                        box.querySelectorAll('.header-notification-item').forEach(el => {
                            el.classList.remove('is-unread');
                            el.classList.add('is-read');
                            const iconWrap = el.querySelector('.header-notif-icon-wrap');
                            if (iconWrap) {
                                iconWrap.classList.remove('is-unread');
                                iconWrap.classList.add('is-read');
                            }
                        });
                    }
                } catch (err) {
                    console.error('Mark all read error:', err);
                }
            });
        }

        function notificationItem(n) {
            const a = document.createElement('a');
            a.className = 'header-notification-item ' + (n.isRead ? 'is-read' : 'is-unread');
            a.href = n.targetUrl || ('/Notifications/Open?id=' + n.id);

            // Icon wrap
            const iconWrap = document.createElement('div');
            iconWrap.className = 'header-notif-icon-wrap ' + (n.isRead ? 'is-read' : 'is-unread');
            iconWrap.innerHTML = '<i class="bi bi-bell-fill"></i>';

            // Content copy
            const copy = document.createElement('div');
            copy.className = 'header-notification-copy';

            const title = document.createElement('div');
            title.className = 'header-notif-title';
            title.textContent = n.title || (isVi ? 'Thông báo mới' : 'Notification');

            const content = document.createElement('div');
            content.className = 'header-notif-body';
            content.textContent = n.content || '';

            const time = document.createElement('div');
            time.className = 'header-notif-time';
            const dateStr = new Date(n.createdAt).toLocaleString(isVi ? 'vi-VN' : 'en-GB');
            time.innerHTML = '<i class="bi bi-clock me-1"></i> ' + dateStr;

            copy.append(title, content, time);
            a.append(iconWrap, copy);

            a.addEventListener('click', () => {
                if (!n.isRead) {
                    fetch('/Notifications/MarkAsRead?id=' + n.id, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                    }).catch(() => {});
                }
            });

            return a;
        }
    })();
    </script>
}
else
{
    <a class="header-auth-link" asp-area="Identity" asp-page="/Account/Login">
        <i class="bi bi-box-arrow-in-right me-1"></i>@(isVietnamese ? "Đăng nhập" : "Log in")
    </a>
    <a class="header-auth-link header-auth-register" asp-area="Identity" asp-page="/Account/Register">
        <i class="bi bi-person-plus-fill me-1"></i>@(isVietnamese ? "Đăng ký" : "Register")
    </a>
}
</div>
