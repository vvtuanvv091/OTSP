@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    .auth-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        background: var(--bs-tertiary-bg, #f8fafc);
        padding: 40px 0;
    }

    .auth-card {
        width: min(100%, 480px);
        margin: 0 auto;
        padding: clamp(1.5rem, 5vw, 2.5rem);
        color: var(--bs-body-color);
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #e2e8f0);
        border-radius: 16px;
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, .06);
    }

    .auth-icon {
        width: 3.5rem;
        height: 3.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #198754;
        background: #e8f5e9;
        border-radius: 1rem;
        font-size: 1.6rem;
    }

    .auth-card .btn-submit {
        background-color: #198754 !important;
        border-color: #198754 !important;
        color: #fff !important;
        border-radius: 10px;
        padding: 12px;
        font-weight: 600;
        transition: filter .2s;
    }
    .auth-card .btn-submit:hover {
        filter: brightness(.92);
    }
</style>

<div class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <span class="auth-icon mb-3">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                </span>
                <h1 class="h3 fw-bold mb-2">Quên mật khẩu?</h1>
                <p class="text-secondary small mb-0">
                    Nhập địa chỉ email liên kết với tài khoản của bạn để nhận liên kết khôi phục mật khẩu.
                </p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label small fw-semibold text-dark">Email tài khoản</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Input.Email" class="form-control border-start-0 py-2.5" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="w-100 btn btn-submit mb-3 shadow-sm">
                    Gửi yêu cầu khôi phục
                </button>

                <div class="text-center pt-3 border-top mt-3">
                    <a asp-page="./Login" class="small text-decoration-none fw-semibold" style="color: #198754;">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
