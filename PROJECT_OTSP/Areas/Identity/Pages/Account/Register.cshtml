
@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<style>
    .register-section { padding: 40px 0 70px; }
    .register-card {
        color: var(--bs-body-color);
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, .05);
    }
    .register-card h1 { font-size: 30px; font-weight: 700; margin-bottom: 4px; }
    .register-card .sub { color: var(--bs-secondary-color); margin-bottom: 22px; }
    .register-card .form-control,
    .register-card .form-select {
        color: var(--bs-body-color);
        background-color: var(--bs-body-bg);
        border-color: var(--bs-border-color);
    }

    /* Hai thẻ chọn vai trò */
    .role-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 22px; }
    .role-option input { position: absolute; opacity: 0; pointer-events: none; }
    .role-option label {
        display: block; height: 100%; cursor: pointer; text-align: center;
        padding: 16px 12px; border: 2px solid var(--bs-border-color); border-radius: 12px; transition: .2s;
    }
    .role-option label i { display: block; font-size: 28px; color: var(--bs-success); margin-bottom: 4px; }
    .role-option label strong { display: block; }
    .role-option label small { color: var(--bs-secondary-color); }
    .role-option input:checked + label {
        border-color: var(--bs-success);
        background: var(--bs-success-bg-subtle);
    }
    .role-option input:focus-visible + label { outline: 2px solid var(--bs-success); outline-offset: 2px; }

    /* Nút ẩn/hiện mật khẩu */
    .form-floating.has-toggle .form-control { padding-right: 48px; }
    .password-toggle {
        position: absolute; top: 0; right: 4px; height: calc(3.5rem + 2px); width: 44px;
        display: flex; align-items: center; justify-content: center;
        border: 0; background: transparent; color: var(--bs-secondary-color); font-size: 20px; z-index: 5;
    }
    .password-toggle:hover, .password-toggle:focus-visible { color: var(--bs-success); outline: none; }

    .form-section-title { font-weight: 600; margin: 8px 0 12px; }

    .register-card .btn-register {
        width: 100%; padding: 14px; font-size: 18px; border: 0; border-radius: 12px;
        background: var(--bs-success); color: #fff;
    }
    .register-card .btn-register:hover { filter: brightness(.93); }
    .register-card a { color: var(--bs-success-text-emphasis); }

    @@media (max-width: 575.98px) {
        .register-card { padding: 22px 18px; }
        .role-options { grid-template-columns: 1fr; }
    }
</style>

<section class="register-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">
                <div class="register-card">
                    <h1>Tạo tài khoản</h1>
                    <p class="sub">Chọn bạn là ai để chúng tôi hiển thị đúng thông tin cần điền.</p>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <!-- Chọn vai trò -->
                        <div class="role-options">
                            <div class="role-option">
                                <input type="radio" id="roleStudent" asp-for="Input.Role" value="Student_Parent" />
                                <label for="roleStudent">
                                    <i class="bi bi-mortarboard"></i>
                                    <strong>Học viên / Phụ huynh</strong>
                                    <small>Tôi muốn tìm gia sư</small>
                                </label>
                            </div>
                            <div class="role-option">
                                <input type="radio" id="roleTutor" asp-for="Input.Role" value="Tutor" />
                                <label for="roleTutor">
                                    <i class="bi bi-person-workspace"></i>
                                    <strong>Gia sư</strong>
                                    <small>Tôi muốn nhận dạy</small>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Input.Role" class="text-danger"></span>

                        <!-- Thông tin chung -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="Họ và tên" />
                            <label asp-for="Input.FullName">Họ và tên</label>
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.CitizenIdNumber" class="form-control" inputmode="numeric" maxlength="12" placeholder="Số CCCD" />
                            <label asp-for="Input.CitizenIdNumber">Số CCCD (12 chữ số)</label>
                            <span asp-validation-for="Input.CitizenIdNumber" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ResidenceAddress" class="form-control" autocomplete="street-address" placeholder="Nơi ở" />
                            <label asp-for="Input.ResidenceAddress">Nơi ở hiện tại</label>
                            <span asp-validation-for="Input.ResidenceAddress" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.DateOfBirth" type="date" class="form-control" placeholder="Ngày sinh" />
                                    <label asp-for="Input.DateOfBirth">Ngày sinh</label>
                                    <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.PhoneNumber" type="tel" class="form-control" autocomplete="tel" placeholder="Số điện thoại" />
                                    <label asp-for="Input.PhoneNumber">Số điện thoại</label>
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Cảnh báo dưới 18 tuổi (chỉ hiện với học viên) -->
                        <div id="minorAlert" class="alert alert-warning d-none" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Bạn chưa đủ 18 tuổi. Vui lòng nhập thông tin <strong>phụ huynh / người giám hộ</strong> bên dưới để tiếp tục đăng ký.
                        </div>
                        <div id="tutorAgeAlert" class="alert alert-danger d-none" role="alert">
                            <i class="bi bi-x-circle-fill"></i>
                            Gia sư phải từ 18 tuổi trở lên.
                        </div>

                        <!-- Người giám hộ -->
                        <div id="guardianBox" class="d-none">
                            <div class="form-section-title">Thông tin người giám hộ</div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.GuardianFullName" class="form-control" placeholder="Họ tên phụ huynh" />
                                <label asp-for="Input.GuardianFullName">Họ tên phụ huynh / người giám hộ</label>
                                <span asp-validation-for="Input.GuardianFullName" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.GuardianContact" class="form-control" placeholder="Số điện thoại hoặc email" />
                                <label asp-for="Input.GuardianContact">Số điện thoại hoặc email phụ huynh</label>
                                <span asp-validation-for="Input.GuardianContact" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.GuardianCitizenIdNumber" class="form-control" inputmode="numeric" maxlength="12" placeholder="CCCD người giám hộ" />
                                <label asp-for="Input.GuardianCitizenIdNumber">CCCD người giám hộ (12 chữ số)</label>
                                <span asp-validation-for="Input.GuardianCitizenIdNumber" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.GuardianResidenceAddress" class="form-control" placeholder="Nơi ở người giám hộ" />
                                <label asp-for="Input.GuardianResidenceAddress">Nơi ở người giám hộ</label>
                                <span asp-validation-for="Input.GuardianResidenceAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Riêng học viên -->
                        <div id="studentBox">
                            <div class="form-section-title">Nhu cầu học tập (không bắt buộc)</div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.InterestedSubjects" class="form-control" placeholder="Môn quan tâm" />
                                <label asp-for="Input.InterestedSubjects">Môn học quan tâm (ví dụ: Toán, Tiếng Anh)</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Area" class="form-control" placeholder="Khu vực" />
                                <label asp-for="Input.Area">Khu vực (ví dụ: Đồng Nai)</label>
                            </div>
                        </div>

                        <!-- Riêng gia sư -->
                        <div id="tutorBox">
                            <div class="form-section-title">Thông tin giảng dạy</div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.HourlyFee" type="number" min="0" step="1000" class="form-control" placeholder="Học phí mỗi giờ" />
                                <label asp-for="Input.HourlyFee">Học phí mong muốn </label>
                                <span asp-validation-for="Input.HourlyFee" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <textarea asp-for="Input.Introduction" class="form-control" placeholder="Giới thiệu" style="height: 110px"></textarea>
                                <label asp-for="Input.Introduction">Giới thiệu bản thân và kinh nghiệm dạy</label>
                            </div>
                            <div class="alert alert-info small">
                                Sau khi đăng ký, hồ sơ gia sư sẽ ở trạng thái <strong>chờ duyệt</strong>. Bạn bổ sung bằng cấp, môn dạy trong trang hồ sơ để quản trị viên xác minh.
                            </div>
                        </div>

                        <!-- Tài khoản -->
                        <div class="form-section-title">Tài khoản đăng nhập</div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating has-toggle mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Mật khẩu" />
                            <label asp-for="Input.Password">Mật khẩu</label>
                            <button type="button" class="password-toggle" data-target="Input_Password" aria-label="Hiện mật khẩu" title="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="form-floating has-toggle mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                            <label asp-for="Input.ConfirmPassword">Nhập lại mật khẩu</label>
                            <button type="button" class="password-toggle" data-target="Input_ConfirmPassword" aria-label="Hiện mật khẩu" title="Hiện mật khẩu"><i class="bi bi-eye"></i></button>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.AcceptTerms" class="form-check-input" />
                            <label asp-for="Input.AcceptTerms" class="form-check-label">
                                Tôi đồng ý với <a href="#" target="_blank">Điều khoản sử dụng</a>
                            </label>
                            <div><span asp-validation-for="Input.AcceptTerms" class="text-danger"></span></div>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn-register">Đăng ký</button>

                        <p class="text-center mt-3 mb-0">
                            Đã có tài khoản?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const dob = document.getElementById('Input_DateOfBirth');
            const guardianBox = document.getElementById('guardianBox');
            const minorAlert = document.getElementById('minorAlert');
            const tutorAgeAlert = document.getElementById('tutorAgeAlert');
            const studentBox = document.getElementById('studentBox');
            const tutorBox = document.getElementById('tutorBox');

            // Không cho chọn ngày sinh ở tương lai
            dob.max = new Date().toISOString().split('T')[0];

            function currentRole() {
                const checked = document.querySelector('input[name="Input.Role"]:checked');
                return checked ? checked.value : 'Student_Parent';
            }

            function calcAge(value) {
                if (!value) return null;
                const b = new Date(value), t = new Date();
                let age = t.getFullYear() - b.getFullYear();
                const m = t.getMonth() - b.getMonth();
                if (m < 0 || (m === 0 && t.getDate() < b.getDate())) age--;
                return age;
            }

            function refresh() {
                const role = currentRole();
                const age = calcAge(dob.value);
                const isStudent = role === 'Student_Parent';

                studentBox.classList.toggle('d-none', !isStudent);
                tutorBox.classList.toggle('d-none', isStudent);

                const minor = age !== null && age < 18;
                guardianBox.classList.toggle('d-none', !(isStudent && minor));
                minorAlert.classList.toggle('d-none', !(isStudent && minor));
                tutorAgeAlert.classList.toggle('d-none', !(!isStudent && minor));
            }

            // Ẩn/hiện mật khẩu
            document.querySelectorAll('.password-toggle').forEach(btn => {
                btn.addEventListener('click', () => {
                    const input = document.getElementById(btn.dataset.target);
                    const icon = btn.querySelector('i');
                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                    const label = show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu';
                    btn.setAttribute('aria-label', label);
                    btn.title = label;
                });
            });

            document.querySelectorAll('input[name="Input.Role"]').forEach(r => r.addEventListener('change', refresh));
            dob.addEventListener('input', refresh);
            refresh();
        })();
    </script>
}

