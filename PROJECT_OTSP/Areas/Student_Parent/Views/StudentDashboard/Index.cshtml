@model PROJECT_OTSP.Areas.Student_Parent.Controllers.StudentDashboardVm

@{
    ViewData["Title"] = "Tổng quan";
    var moneyCulture = new System.Globalization.CultureInfo("vi-VN");
}

<style>
    .student-dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .student-dash-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 12px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    /* Top Alert Banner for Under 18 / Guardian */
    .student-guardian-alert-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-left: 4px solid #f59e0b;
        border-radius: 10px;
        padding: 16px 20px;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--bs-body-color, #0f172a);
    }

    /* Top Banner Card: Buổi học tiếp theo */
    .student-banner-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-left: 4px solid #dc2626;
        border-radius: 12px;
        padding: 22px 28px;
    }

    .student-banner-label {
        font-size: 0.82rem;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .student-banner-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
        margin-bottom: 6px;
    }

    .student-banner-meta {
        font-size: 0.88rem;
        font-weight: 600;
        color: #dc2626;
    }

    .btn-red-action {
        background-color: #dc2626;
        color: #ffffff;
        font-weight: 600;
        border: 1px solid #dc2626;
        border-radius: 8px;
        padding: 8px 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .btn-red-action:hover, .btn-red-action:focus {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .btn-red-action-sm {
        background-color: #dc2626;
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 6px;
        padding: 6px 18px;
        font-size: 0.84rem;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.15s ease;
    }

    .btn-red-action-sm:hover {
        background-color: #b91c1c;
        color: #ffffff;
    }

    /* 4 KPI Metric Cards */
    .student-kpi-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 10px;
        padding: 18px 20px;
        height: 100%;
        position: relative;
    }

    .student-kpi-title {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 8px;
    }

    .student-kpi-value {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
        line-height: 1.2;
    }

    .student-kpi-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        position: absolute;
        top: 18px;
        right: 18px;
    }

    .kpi-box-pink {
        background-color: #fee2e2;
    }

    .kpi-box-blue {
        background-color: #dbeafe;
    }

    .kpi-box-yellow {
        background-color: #fef3c7;
    }

    .kpi-box-purple {
        background-color: #f3e8ff;
    }

    /* Badges & Buttons */
    .badge-open-later {
        background-color: #fee2e2;
        color: #b91c1c;
        border-radius: 6px;
        padding: 6px 14px;
        font-size: 0.82rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-future-outline {
        border: 1px solid #fca5a5;
        color: #dc2626;
        background-color: transparent;
        border-radius: 6px;
        padding: 5px 14px;
        font-size: 0.82rem;
        font-weight: 500;
        display: inline-block;
    }

    .badge-past {
        background-color: #f1f5f9;
        color: #64748b;
        border-radius: 6px;
        padding: 5px 14px;
        font-size: 0.82rem;
        font-weight: 500;
        display: inline-block;
    }

    /* Table */
    .upcoming-schedule-table {
        margin-bottom: 0;
    }

    .upcoming-schedule-table td {
        border-top: none;
        border-bottom: 1px solid var(--bs-border-color, #f1f5f9);
        padding: 16px 14px;
        vertical-align: middle;
        font-size: 0.92rem;
    }

    .upcoming-schedule-table tr:last-child td {
        border-bottom: none;
    }

    .schedule-time-text {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
        margin-bottom: 2px;
    }

    .schedule-class-text {
        font-size: 0.88rem;
        color: #475569;
    }

    /* Right Column: Pending Payments Card */
    .pending-fee-item {
        border-bottom: 1px solid var(--bs-border-color, #f1f5f9);
        padding: 16px 0;
    }

    .pending-fee-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .pending-fee-item:first-child {
        padding-top: 0;
    }

    .pending-fee-title {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--bs-body-color, #0f172a);
        margin-bottom: 3px;
    }

    .pending-fee-amount {
        font-size: 1rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
    }

    /* Collapse / Hide Toggle Button */
    .btn-toggle-schedule {
        border: 1px solid var(--bs-border-color, #e2e8f0);
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 4px 10px;
        background: transparent;
        transition: all 0.15s ease;
    }

    .btn-toggle-schedule:hover {
        background-color: var(--bs-tertiary-bg, #f1f5f9);
        color: #0f172a;
        border-color: #cbd5e1;
    }

    /* Compact Pagination for dashboard */
    .schedule-pagination-wrapper .pagination-modern {
        margin: 0.85rem 0 0.25rem 0;
        gap: 4px;
    }

    .schedule-pagination-wrapper .pagination-modern .page-link-btn {
        min-width: 32px;
        height: 32px;
        font-size: 0.8rem;
        padding: 0 8px;
        border-radius: 6px;
    }

    [data-bs-theme="dark"] .kpi-box-pink {
        background-color: rgba(220, 38, 38, 0.2);
    }

    [data-bs-theme="dark"] .kpi-box-blue {
        background-color: rgba(59, 130, 246, 0.2);
    }

    [data-bs-theme="dark"] .kpi-box-yellow {
        background-color: rgba(245, 158, 11, 0.2);
    }

    [data-bs-theme="dark"] .kpi-box-purple {
        background-color: rgba(168, 85, 247, 0.2);
    }

    [data-bs-theme="dark"] .badge-future-outline {
        border-color: rgba(220, 38, 38, 0.45);
        color: #f87171;
    }

    [data-bs-theme="dark"] .schedule-class-text {
        color: #94a3b8;
    }

    [data-bs-theme="dark"] .btn-toggle-schedule {
        border-color: #334155;
        color: #94a3b8;
    }

    [data-bs-theme="dark"] .btn-toggle-schedule:hover {
        background-color: #1e293b;
        color: #f1f5f9;
        border-color: #475569;
    }
</style>

<div class="container-fluid py-4 student-dashboard-container">
    <!-- Header -->
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1" style="color: var(--bs-body-color, #0f172a);">Tổng quan</h1>
        <p class="text-secondary mb-0" style="font-size: 0.92rem;">Khu học tập của học viên/phụ huynh</p>
    </div>

    <!-- Thông báo hệ thống (nếu có) -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-1"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- 1. Banner Người Giám Hộ (Hiển thị nếu học viên dưới 18 tuổi hoặc đã có người giám hộ) -->
    @if (Model.IsMinor || !string.IsNullOrWhiteSpace(Model.GuardianName))
    {
        <div class="student-guardian-alert-card mb-4 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                @if (Model.IsMinor)
                {
                    <span>Bạn dưới 18 tuổi. </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.GuardianName))
                {
                    <span>Người giám hộ: <strong>@Model.GuardianName</strong></span>
                }
                else
                {
                    <span class="text-secondary">Chưa đăng ký thông tin người giám hộ.</span>
                }
            </div>
            <a asp-area="Student_Parent" asp-controller="Student_Parent_Profile" asp-action="Index" asp-fragment="guardians" class="btn btn-sm btn-outline-warning text-dark fw-medium rounded-pill px-3 py-1">
                Chi tiết
            </a>
        </div>
    }

    <!-- 2. Banner: Buổi học tiếp theo -->
    <div class="student-banner-card mb-4 shadow-sm">
        @if (Model.NextSession != null)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="student-banner-label">Buổi học tiếp theo</div>
                    <div class="student-banner-title">@Model.NextSession.Title</div>
                    <div class="student-banner-meta">@Model.NextSession.Subtitle</div>
                </div>
                <div>
                    <a href="@Model.NextSession.JoinUrl" target="_blank" class="btn-red-action">
                        Vào lớp
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="student-banner-label">Buổi học tiếp theo</div>
                    <div class="student-banner-title">Chưa có buổi học nào sắp diễn ra</div>
                    <div class="text-secondary small">
                        Bạn chưa có lịch học nào trong thời gian tới. Hãy xem thời khóa biểu hoặc tìm kiếm gia sư để đăng ký học.
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-area="Student_Parent" asp-controller="StudentSchedule" asp-action="Index" class="btn btn-outline-secondary px-3 py-2 fw-semibold">
                        <i class="bi bi-calendar3 me-1"></i> Xem lịch học
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="courses" class="btn btn-danger px-3 py-2 fw-semibold">
                        <i class="bi bi-search me-1"></i> Tìm gia sư
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- 3. Hàng 4 Thẻ Số Liệu (BUỔI HÔM NAY, LỚP ĐANG HỌC, HỌC PHÍ CÒN LẠI, YÊU CẦU ĐANG CHỜ) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Buổi hôm nay -->
        <div class="col-6 col-md-3">
            <div class="student-kpi-card shadow-sm">
                <div class="student-kpi-title">BUỔI HÔM NAY</div>
                <div class="student-kpi-value">@Model.TodaySessionsCount</div>
                <div class="student-kpi-icon-box kpi-box-pink d-flex align-items-center justify-content-center">
                    <i class="bi bi-calendar-check text-danger" style="font-size: 1.15rem;"></i>
                </div>
            </div>
        </div>
        <!-- Card 2: Lớp đang học -->
        <div class="col-6 col-md-3">
            <div class="student-kpi-card shadow-sm">
                <div class="student-kpi-title">LỚP ĐANG HỌC</div>
                <div class="student-kpi-value">@Model.ActiveClassesCount</div>
                <div class="student-kpi-icon-box kpi-box-blue d-flex align-items-center justify-content-center">
                    <i class="bi bi-easel text-primary" style="font-size: 1.15rem;"></i>
                </div>
            </div>
        </div>
        <!-- Card 3: Học phí còn lại -->
        <div class="col-6 col-md-3">
            <div class="student-kpi-card shadow-sm">
                <div class="student-kpi-title">HỌC PHÍ CÒN LẠI</div>
                <div class="student-kpi-value" style="font-size: 1.55rem;">
                    @Model.TotalRemainingFee.ToString("N0", moneyCulture)đ
                </div>
                <div class="student-kpi-icon-box kpi-box-yellow d-flex align-items-center justify-content-center">
                    <i class="bi bi-credit-card-2-front text-warning" style="font-size: 1.15rem;"></i>
                </div>
            </div>
        </div>
        <!-- Card 4: Yêu cầu đang chờ -->
        <div class="col-6 col-md-3">
            <div class="student-kpi-card shadow-sm">
                <div class="student-kpi-title">YÊU CẦU ĐANG CHỜ</div>
                <div class="student-kpi-value">@Model.PendingRequestsCount</div>
                <div class="student-kpi-icon-box kpi-box-purple d-flex align-items-center justify-content-center">
                    <i class="bi bi-clock-history" style="color: #9333ea; font-size: 1.15rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Hai Cột: Lịch sắp tới (Left) & Học phí cần thanh toán (Right) -->
    <div class="row g-4">
        <!-- Cột trái: Lịch sắp tới -->
        <div class="col-12 col-lg-7">
            <div class="student-dash-card shadow-sm p-4 h-100">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="h5 fw-bold mb-0" style="color: var(--bs-body-color, #0f172a);">Lịch sắp tới</h2>
                        @if (Model.Pagination?.TotalItems > 0)
                        {
                            <span class="badge rounded-pill bg-light text-secondary border fw-semibold" style="font-size: 0.75rem;">
                                @Model.Pagination.TotalItems
                            </span>
                        }
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <!-- Ô tìm kiếm tối ưu -->
                        <div class="position-relative" style="width: 175px;">
                            <input type="text"
                                   id="studentScheduleSearchInput"
                                   value="@Model.SearchQuery"
                                   placeholder="Tìm môn, gia sư..."
                                   class="form-control form-control-sm ps-4 pe-2 rounded-pill"
                                   style="font-size: 0.82rem;" />
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size: 0.75rem;"></i>
                        </div>

                        <!-- Nút Thu gọn / Ẩn hiện lịch học -->
                        <button type="button" 
                                class="btn btn-toggle-schedule rounded-pill d-inline-flex align-items-center gap-1"
                                id="btnToggleStudentSchedule"
                                data-bs-toggle="collapse" 
                                data-bs-target="#studentScheduleCollapseArea" 
                                aria-expanded="true" 
                                aria-controls="studentScheduleCollapseArea"
                                title="Thu gọn hoặc mở rộng lịch học">
                            <i class="bi bi-dash-lg toggle-icon" id="studentScheduleToggleIcon"></i>
                            <span id="studentScheduleToggleText">Thu gọn</span>
                        </button>
                    </div>
                </div>

                <!-- Khu vực bảng và phân trang (Có thể thu gọn hoặc ẩn) -->
                <div class="collapse show" id="studentScheduleCollapseArea">
                    @if (Model.UpcomingSessions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table upcoming-schedule-table" id="studentScheduleTable">
                                <tbody>
                                    @foreach (var item in Model.UpcomingSessions)
                                    {
                                        <tr class="schedule-row" data-search-target="@item.ClassDisplay.ToLowerInvariant() @item.TimeFormatted.ToLowerInvariant()">
                                            <td style="width: 72%;">
                                                <div class="schedule-time-text">@item.TimeFormatted</div>
                                                <div class="schedule-class-text">@item.ClassDisplay</div>
                                            </td>
                                            <td style="width: 28%;" class="text-end text-nowrap">
                                                @if (item.BadgeType == "Join")
                                                {
                                                    <a href="@item.JoinUrl" target="_blank" class="btn-red-action-sm">
                                                        Vào lớp
                                                    </a>
                                                }
                                                else if (item.BadgeType == "OpenLater")
                                                {
                                                    <span class="badge-open-later">@item.ActionText</span>
                                                }
                                                else if (item.BadgeType == "Future")
                                                {
                                                    <span class="badge-future-outline">Chưa tới ngày</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-past">@item.ActionText</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang PaginationVm chống tràn bảng -->
                        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
                        {
                            <div class="schedule-pagination-wrapper">
                                @await Html.PartialAsync("_PaginationBar", Model.Pagination)
                            </div>
                        }

                        <div id="noMatchMessage" class="text-center py-4 text-muted d-none" style="font-size: 0.9rem;">
                            <i class="bi bi-search mb-2 fs-4 d-block text-secondary"></i>
                            Không tìm thấy buổi học nào khớp với từ khóa tìm kiếm.
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar2-x fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-2 fw-medium">Chưa có buổi học nào sắp tới.</p>
                            <p class="small text-secondary mb-3">Lịch học từ các lớp bạn tham gia sẽ hiển thị tại đây.</p>
                            <a asp-area="Student_Parent" asp-controller="StudentSchedule" asp-action="Index" class="btn btn-sm btn-outline-danger">
                                Xem lịch học
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Học phí cần thanh toán -->
        <div class="col-12 col-lg-5">
            <div class="student-dash-card shadow-sm p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 fw-bold mb-0" style="color: var(--bs-body-color, #0f172a);">
                        Học phí cần thanh toán
                    </h2>
                    @if (Model.PendingFeeItems.Any())
                    {
                        <span class="badge rounded-pill bg-danger-subtle text-danger fw-semibold" style="font-size: 0.75rem;">
                            @Model.PendingFeeItems.Count khoản
                        </span>
                    }
                </div>

                @if (Model.PendingFeeItems.Any())
                {
                    <div class="d-flex flex-column">
                        @foreach (var fee in Model.PendingFeeItems)
                        {
                            <div class="pending-fee-item d-flex align-items-center justify-content-between gap-3">
                                <div>
                                    <div class="pending-fee-title">@fee.Title</div>
                                    <div class="pending-fee-amount">@fee.Amount.ToString("N0", moneyCulture)đ</div>
                                </div>
                                <div>
                                    <a href="@fee.CheckoutUrl" class="btn-red-action-sm">
                                        Xem
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.PendingFeeItems.Count > 1)
                    {
                        <div class="mt-4 pt-2 border-top text-end">
                            <a asp-area="Student_Parent" asp-controller="StudentParent_Payment" asp-action="Index" class="text-danger small fw-semibold text-decoration-none">
                                Xem tất cả học phí <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                        <p class="mb-1 fw-medium text-dark">Tất cả học phí đã hoàn tất</p>
                        <p class="small text-secondary mb-3">Bạn không có khoản học phí nào cần thanh toán.</p>
                        <a asp-area="Student_Parent" asp-controller="StudentParent_Payment" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            Lịch sử thanh toán
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('studentScheduleSearchInput');
        const table = document.getElementById('studentScheduleTable');
        const noMatch = document.getElementById('noMatchMessage');
        const collapseEl = document.getElementById('studentScheduleCollapseArea');
        const toggleIcon = document.getElementById('studentScheduleToggleIcon');
        const toggleText = document.getElementById('studentScheduleToggleText');

        // 1. Quản lý trạng thái Thu gọn / Mở rộng lịch học học viên
        if (collapseEl) {
            const isCollapsed = localStorage.getItem('otsp_student_schedule_collapsed') === 'true';
            if (isCollapsed) {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseEl, { toggle: false });
                bsCollapse.hide();
                if (toggleIcon) toggleIcon.className = 'bi bi-plus-lg toggle-icon';
                if (toggleText) toggleText.textContent = 'Mở lịch';
            }

            collapseEl.addEventListener('hide.bs.collapse', function () {
                if (toggleIcon) toggleIcon.className = 'bi bi-plus-lg toggle-icon';
                if (toggleText) toggleText.textContent = 'Mở lịch';
                localStorage.setItem('otsp_student_schedule_collapsed', 'true');
            });

            collapseEl.addEventListener('show.bs.collapse', function () {
                if (toggleIcon) toggleIcon.className = 'bi bi-dash-lg toggle-icon';
                if (toggleText) toggleText.textContent = 'Thu gọn';
                localStorage.setItem('otsp_student_schedule_collapsed', 'false');
            });
        }

        // 2. Tìm kiếm tức thời phía Client (nhanh, mượt)
        if (searchInput && table) {
            const rows = table.querySelectorAll('tbody tr.schedule-row');

            searchInput.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();
                let visibleCount = 0;

                // Tự động mở rộng nếu đang thu gọn mà gõ tìm kiếm
                if (collapseEl && !collapseEl.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(collapseEl).show();
                }

                rows.forEach(row => {
                    const searchTarget = row.getAttribute('data-search-target') || '';
                    if (!query || searchTarget.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatch) {
                    if (visibleCount === 0 && query.length > 0) {
                        noMatch.classList.remove('d-none');
                    } else {
                        noMatch.classList.add('d-none');
                    }
                }
            });

            // Nhấn Enter để gửi truy vấn tìm kiếm server kèm phân trang
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const term = encodeURIComponent(this.value.trim());
                    const url = new URL(window.location.href);
                    url.searchParams.set('page', '1');
                    if (term) {
                        url.searchParams.set('q', term);
                    } else {
                        url.searchParams.delete('q');
                    }
                    window.location.href = url.toString();
                }
            });
        }
    });
</script>
