@using PROJECT_OTSP.Dtos
@using static PROJECT_OTSP.Models.Enums
@model TutorDetailsVm
@inject PROJECT_OTSP.Services.IScheduleBlockService BlockService

@{
    ViewData["Title"] = $"Hồ sơ gia sư - {Model.FullName}";
    var money = new System.Globalization.CultureInfo("vi-VN");
    var formatName = Model.TeachingFormat switch
    {
        TeachingFormat.Online => "Trực tuyến",
        TeachingFormat.Offline => "Trực tiếp",
        TeachingFormat.Hybrid => "Trực tuyến & Trực tiếp",
        _ => Model.TeachingFormat.ToString()
    };
}

<style>
    :root {
        --brand: #DB303A;
        --brand-dark: #B7212B;
        --brand-glow: rgba(219, 48, 58, .22);
        --brand-soft: rgba(219, 48, 58, .10);
        --radius-lg: 1.15rem;
        --radius-md: .85rem;
    }

    .tutor-detail-shell {
        max-width: 1280px;
        margin: 0 auto;
    }

    .pro-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #e9ecef);
        border-radius: var(--radius-lg);
        box-shadow: 0 4px 20px rgba(0, 0, 0, .04);
        padding: 1.5rem;
    }

    .tutor-header-card {
        background: linear-gradient(135deg, rgba(219, 48, 58, .04) 0%, rgba(219, 48, 58, .01) 100%);
        border: 1px solid rgba(219, 48, 58, .15);
    }

    .tutor-avatar-xl {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 6px 18px var(--brand-glow);
        border: 3px solid #fff;
    }

    .tutor-avatar-fallback {
        width: 100px;
        height: 100px;
    }

    /* Specific styles for Tutor Details & Booking View */
    .tutor-detail-shell {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: 1rem;
    }

    .timetable-grid {
        width: 100%;
        min-width: 680px;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 3px 4px;
        font-size: 11px;
    }

    .timetable-grid th {
        padding: 6px 3px;
        font-weight: 600;
        text-align: center;
        background: var(--bs-tertiary-bg, #f8f9fa);
        border-radius: 4px;
        color: var(--bs-body-color);
    }

    .timetable-grid th.time-col {
        width: 95px;
        font-weight: 500;
        color: var(--bs-secondary-color);
        background: transparent;
    }

    .timetable-grid td {
        padding: 2px;
        text-align: center;
        vertical-align: middle;
    }

    .slot-cell-empty {
        min-height: 42px;
        background: var(--bs-tertiary-bg, #fafafa);
        border: 1px dashed var(--bs-border-color, #e5e7eb);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--bs-secondary-color, #d1d5db);
        font-size: 11px;
    }

    .slot-cell-btn {
        width: 100%;
        min-height: 42px;
        padding: 4px 2px;
        background: rgba(16, 185, 129, 0.12);
        border: 1.5px solid #10b981;
        border-radius: 4px;
        color: #047857;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease-in-out;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        line-height: 1.2;
    }

    html[data-bs-theme="dark"] .slot-cell-btn {
        color: #34d399;
        background: rgba(16, 185, 129, 0.18);
    }

    .slot-cell-btn:hover {
        background: rgba(16, 185, 129, 0.22);
        border-color: #059669;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(16, 185, 129, .25);
    }

    .slot-cell-btn.is-selected {
        background: #059669 !important;
        border-color: #047857 !important;
        color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, .35) !important;
        animation: pulseSlot .3s ease-in-out;
    }

    .slot-cell-btn .duration-tag {
        font-size: 9px;
        font-weight: 500;
        opacity: .85;
    }

    .slot-cell-btn.is-selected .duration-tag {
        opacity: 1;
        font-weight: 700;
    }

    @@keyframes pulseSlot {
        0% { transform: scale(.95); }
        50% { transform: scale(1.03); }
        100% { transform: scale(1); }
    }

    .tutor-header-card {
        background: linear-gradient(135deg, rgba(219, 48, 58, .05) 0%, rgba(219, 48, 58, .01) 100%);
        border: 1px solid rgba(219, 48, 58, .18);
    }

    .tutor-avatar-xl {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 6px 18px var(--brand-glow);
        border: 3px solid var(--bs-body-bg);
    }

    .tutor-avatar-fallback {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), #ea580c);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        font-size: 2rem;
        font-weight: 700;
        box-shadow: 0 6px 18px var(--brand-glow);
    }

    .stat-pill {
        background: var(--bs-tertiary-bg, #f8f9fa);
        border: 1px solid var(--bs-border-color, #e9ecef);
        border-radius: var(--radius-md);
        padding: .65rem 1rem;
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .badge-soft-brand {
        background-color: var(--brand-soft);
        color: var(--brand);
        font-weight: 600;
        border: 1px solid rgba(219, 48, 58, .2);
    }

    .sticky-card {
        position: sticky;
        top: 90px;
    }

    .section-title {
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        color: var(--bs-heading-color);
    }

    .section-title i {
        color: var(--brand);
    }

    .tag-item {
        background: #f1f5f9;
        color: #334155;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .tag-item {
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        border-radius: 20px;
        padding: .4rem .9rem;
        font-size: .88rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border: 1px solid #e2e8f0;
    }

    .time-slot-tag {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
        border: 1px solid var(--bs-border-color);
    }

    .time-slot-tag {
        background: rgba(16, 185, 129, 0.12);
        color: #047857;
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: var(--radius-md);
        padding: .5rem .75rem;
        font-size: .85rem;
    }

    .btn-brand {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
        font-weight: 600;
        transition: all .2s;
    }

    .btn-brand:hover {
        background: var(--brand-dark);
        border-color: var(--brand-dark);
        color: #fff;
        box-shadow: 0 4px 14px var(--brand-glow);
    }

    .tutor-detail-shell {
        max-width: 1120px;
        padding-inline: 1rem;
    }

    .pro-card {
        border-radius: .75rem;
        padding: 1rem;
        box-shadow: 0 2px 10px rgba(15, 23, 42, .045);
    }

    .tutor-avatar-xl,
    .tutor-avatar-fallback {
        width: 76px;
        height: 76px;
    }

    .tutor-avatar-fallback {
        font-size: 1.75rem;
    }

    .stat-pill {
        padding: .55rem .7rem;
        gap: .5rem;
    }

    .section-title {
        font-size: 1rem;
        margin-bottom: .85rem;
    }

    .sticky-card {
        top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    html[data-bs-theme="dark"] .time-slot-tag {
        color: #34d399;
    }

    .request-steps {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .35rem;
        margin: .85rem 0 1rem;
    }

    .request-step {
        display: flex;
        align-items: center;
        gap: .35rem;
        color: #64748b;
        color: var(--bs-secondary-color);
        font-size: .72rem;
        white-space: nowrap;
    }

    .request-step-number {
        width: 1.35rem;
        height: 1.35rem;
        flex: 0 0 1.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e9ecef;
        color: #64748b;
        background: var(--bs-tertiary-bg);
        color: var(--bs-secondary-color);
        font-size: .7rem;
        font-weight: 700;
    }

    .request-step.is-active {
        color: var(--brand);
        font-weight: 600;
    }

    .request-step.is-active .request-step-number {
        background: var(--brand-soft);
        color: var(--brand);
        border: 1px solid rgba(219, 48, 58, .3);
    }

    .request-step-line {
        height: 1px;
        flex: 1;
        min-width: .35rem;
        background: #dee2e6;
        background: var(--bs-border-color);
    }

    .tutor-chat-card {
        min-height: 300px;
        display: flex;
        flex-direction: column;
    }

    .tutor-chat-history {
        flex: 1;
        min-height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dee2e6;
        border-radius: .65rem;
        background: #f8f9fa;
        color: #94a3b8;
        border: 1px solid var(--bs-border-color);
        border-radius: .65rem;
        background: var(--bs-tertiary-bg);
        color: var(--bs-secondary-color);
        font-size: .8rem;
    }

    @@media (max-width: 991.98px) {
        .sticky-card {
            position: static;
        }
    }

    @@media (max-width: 575.98px) {
        .tutor-detail-shell {
            padding-inline: .75rem;
            padding-inline: .5rem;
        }

        .tutor-avatar-xl,
        .tutor-avatar-fallback {
            width: 68px;
            height: 68px;
            font-size: 1.5rem;
        }

        .request-step {
            font-size: .64rem;
        }

        .request-step-number {
            width: 1.2rem;
            height: 1.2rem;
            flex-basis: 1.2rem;
        }

        .stat-pill {
            padding: .5rem .4rem;
            gap: .3rem;
        }

        .stat-pill .fs-4 {
            font-size: 1.15rem !important;
        }
    }
</style>

<div class="tutor-detail-shell py-4">

    <!-- Breadcrumb & Back button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-area="Student_Parent" asp-controller="Search" asp-action="Index" class="text-decoration-none text-muted">
                        <i class="bi bi-search me-1"></i> Tìm gia sư
                    </a>
                </li>
                <li class="breadcrumb-item active fw-medium text-dark" aria-current="page">Hồ sơ: @Model.FullName</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <a asp-area="Student_Parent" asp-controller="Send_Details_Tutor" asp-action="MyRequests" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-clock-history me-1"></i> Yêu cầu đã gửi
            </a>
            <a asp-area="Student_Parent" asp-controller="Search" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại tìm kiếm
            </a>
        </div>
    </div>

    <!-- Thông báo nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-5 me-2"></i>
            <div>@TempData["Warning"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (Model.HasExistingPendingRequest)
    {
        <div class="alert alert-warning border-warning d-flex align-items-center gap-3 p-3 mb-4 rounded-3 shadow-sm">
            <i class="bi bi-hourglass-split fs-2 text-warning"></i>
            <div>
                <strong class="d-block mb-1">Bạn đã gửi yêu cầu kết nối tới gia sư này!</strong>
                <span class="small text-muted">
                    Yêu cầu môn <strong>@(Model.ExistingRequestSubject ?? "học tập")</strong> gửi ngày @(Model.ExistingRequestDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) đang ở trạng thái <strong>Chờ gia sư phản hồi</strong>.
                    Bạn có thể theo dõi trong mục <a asp-action="MyRequests" class="fw-semibold text-decoration-underline text-warning-emphasis">Yêu cầu đã gửi</a>.
                </span>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Thông tin chi tiết gia sư -->
        <div class="col-lg-8">
            <div class="d-flex flex-column gap-4">

                <!-- Header card: Avatar + Tên + Đánh giá + Học phí -->
                <div class="pro-card tutor-header-card">
                    <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="@Model.FullName" class="tutor-avatar-xl" onerror="this.onerror=null;this.src='/assets/img/default-avatar.svg';" />
                        }
                        else
                        {
                            <div class="tutor-avatar-fallback">@Model.Initials</div>
                        }

                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h1 class="h4 mb-0 fw-bold">@Model.FullName</h1>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                    <i class="bi bi-patch-check-fill me-1"></i> Đã xác thực
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Area))
                            {
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Area
                                </p>
                            }

                            <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                                <div class="d-flex align-items-center text-warning fw-semibold">
                                    <i class="bi bi-star-fill text-warning me-1" style="color: #f59e0b !important;"></i>
                                    <span class="text-dark me-1">@(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "Chưa có")</span>
                                    <span class="text-muted small">(@Model.Reviews.Count đánh giá)</span>
                                </div>
                                <span class="text-muted">•</span>
                                <span class="badge badge-soft-brand py-2 px-3 rounded-pill">
                                    <i class="bi bi-laptop me-1"></i> @formatName
                                </span>
                                <span class="text-muted">•</span>
                                <div class="fs-5 fw-bold text-danger">
                                    @Model.HourlyFee.ToString("N0", money) đ <span class="fs-6 fw-normal text-muted">/ giờ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Thống kê hoạt động tóm tắt -->
                    <div class="row g-2 mt-3 pt-3 border-top">
                        <div class="col-4">
                            <div class="stat-pill">
                                <i class="bi bi-mortarboard fs-4 text-primary"></i>
                                <div>
                                    <div class="fw-bold">@Model.Qualifications.Count</div>
                                    <div class="text-muted small">Bằng cấp</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-pill">
                                <i class="bi bi-check2-circle fs-4 text-success"></i>
                                <div>
                                    <div class="fw-bold">@Model.TotalCompletedSessions</div>
                                    <div class="text-muted small">Buổi đã dạy</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-pill">
                                <i class="bi bi-people fs-4 text-info"></i>
                                <div>
                                    <div class="fw-bold">@Model.TotalStudents</div>
                                    <div class="text-muted small">Học viên</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Giới thiệu bản thân -->
                <div class="pro-card">
                    <h2 class="section-title"><i class="bi bi-person-lines-fill"></i> Giới thiệu bản thân</h2>
                    <div class="text-secondary lh-lg" style="white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.Introduction) ? "Gia sư chưa cập nhật phần tự giới thiệu." : Model.Introduction)
                    </div>
                </div>

                <!-- Môn học & Cấp học giảng dạy -->
                <div class="pro-card">
                    <h2 class="section-title"><i class="bi bi-book"></i> Môn học &amp; Cấp học giảng dạy</h2>
                    @if (Model.TeachingSubjects.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có thông tin môn dạy.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sub in Model.TeachingSubjects)
                            {
                                <span class="tag-item">
                                    <i class="bi bi-bookmark-check-fill text-danger"></i>
                                    <strong>@sub.SubjectName</strong> · @sub.GradeName
                                </span>
                            }
                        </div>
                    }
                </div>

                <!-- Bằng cấp & Chứng chỉ đã duyệt -->
                <div class="pro-card">
                    <h2 class="section-title"><i class="bi bi-award"></i> Bằng cấp &amp; Chứng chỉ xác thực</h2>
                    @if (Model.Qualifications.Count == 0)
                    {
                        <p class="text-muted mb-0">Gia sư chưa tải lên bằng cấp hoặc chứng chỉ.</p>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var q in Model.Qualifications)
                            {
                                <div class="col-sm-6">
                                    <div class="p-3 border rounded-3 d-flex align-items-center justify-content-between bg-light">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-patch-check-fill text-primary fs-5"></i>
                                            <span class="fw-medium text-dark">@q.Title</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(q.FileUrl))
                                        {
                                            <a href="@q.FileUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" title="Xem chứng chỉ">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Lịch rảnh trong tuần -->
                <div class="pro-card">
                    <h2 class="section-title"><i class="bi bi-calendar-week"></i> Khung giờ có thể dạy hàng tuần</h2>
                    <p class="small text-muted">Lịch này chỉ để tham khảo. Lịch học thử có thể được thống nhất vào bất kỳ ngày giờ tương lai nào còn trống.</p>
                    @if (Model.Availabilities.Count == 0)
                    {
                        <p class="text-muted mb-0">Gia sư linh hoạt theo thỏa thuận với học viên.</p>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var slot in Model.Availabilities)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="time-slot-tag d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold">@slot.DayOfWeekName</span>
                                        <span>@slot.TimeRange</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Khung lịch rảnh & Đặt lịch học thử (1 kèm 1) -->
                <div class="pro-card" id="tutorScheduleCard">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <h2 class="section-title mb-0">
                            <i class="bi bi-calendar-week text-danger"></i> Khung lịch rảnh &amp; Đặt giờ học thử (1 kèm 1)
                        </h2>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            Khối 2 tiếng · Bắt buộc đủ 4 tiếng/tuần
                        </span>
                    </div>
                    <p class="small text-muted mb-3">
                        Lịch rảnh thực tế trong 14 ngày tới (đã tự động lọc bỏ giờ gia sư bận). 
                        <strong>Bấm chọn 2 khung giờ (mỗi khung 2 tiếng = đủ 4 tiếng/tuần)</strong> để đề xuất lịch học 1 kèm 1 chia đều trong tuần.
                    </p>

                    @if (Model.AvailableTrialSlots.Count == 0)
                    {
                        <div class="alert alert-light border small text-muted p-3 mb-0">
                            <i class="bi bi-info-circle text-primary me-2"></i>Hiện tại gia sư chưa có khung giờ rảnh trống trong 14 ngày tới. Bạn có thể nêu khung giờ mong muốn ở ô lời nhắn bên dưới.
                        </div>
                    }
                    else
                    {
                        var allSlots = Model.AvailableTrialSlots;
                        var allDates = allSlots.Select(s => DateOnly.FromDateTime(s.SlotUtc.AddHours(7))).Distinct().OrderBy(d => d).ToList();
                        var week1Dates = allDates.Take(7).ToList();
                        var week2Dates = allDates.Skip(7).ToList();
                        var blocksList = BlockService.Blocks;

                        string FormatShortDay(DayOfWeek d) => d switch
                        {
                            DayOfWeek.Monday => "Thứ 2",
                            DayOfWeek.Tuesday => "Thứ 3",
                            DayOfWeek.Wednesday => "Thứ 4",
                            DayOfWeek.Thursday => "Thứ 5",
                            DayOfWeek.Friday => "Thứ 6",
                            DayOfWeek.Saturday => "Thứ 7",
                            DayOfWeek.Sunday => "Chủ Nhật",
                            _ => d.ToString()
                        };

                        <ul class="nav nav-pills nav-fill mb-3 p-1 bg-light rounded border" id="weekTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active py-2 fw-semibold small" id="week1-tab" data-bs-toggle="pill" data-bs-target="#week1-content" type="button" role="tab">
                                    <i class="bi bi-calendar3 me-1"></i>Tuần 1 (@(week1Dates.Count > 0 ? $"{week1Dates.First():dd/MM} – {week1Dates.Last():dd/MM}" : "7 ngày tới"))
                                </button>
                            </li>
                            @if (week2Dates.Count > 0)
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link py-2 fw-semibold small" id="week2-tab" data-bs-toggle="pill" data-bs-target="#week2-content" type="button" role="tab">
                                        <i class="bi bi-calendar3-range me-1"></i>Tuần 2 (@week2Dates.First().ToString("dd/MM") – @week2Dates.Last().ToString("dd/MM"))
                                    </button>
                                </li>
                            }
                        </ul>

                        <div class="tab-content" id="weekTabsContent">
                            <!-- Tuần 1 -->
                            <div class="tab-pane fade show active" id="week1-content" role="tabpanel">
                                <div class="mobile-scroll-hint"><i class="bi bi-arrows-expand"></i> Vuốt ngang để xem đủ các ngày trong tuần</div>
                                <div class="timetable-wrapper mb-2">
                                    <table class="timetable-grid">
                                        <thead>
                                            <tr>
                                                <th class="time-col">Khung giờ</th>
                                                @foreach (var d in week1Dates)
                                                {
                                                    <th>
                                                        <div>@FormatShortDay(d.DayOfWeek)</div>
                                                        <div class="small text-muted" style="font-size:10px;">@d.ToString("dd/MM")</div>
                                                    </th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var block in blocksList)
                                            {
                                                <tr>
                                                    <th class="time-col">@block.Label</th>
                                                    @foreach (var d in week1Dates)
                                                    {
                                                        var matchingSlot = allSlots.FirstOrDefault(s =>
                                                            DateOnly.FromDateTime(s.SlotUtc.AddHours(7)) == d
                                                            && s.StartTime.Hour == block.Start);

                                                        <td>
                                                            @if (matchingSlot != null)
                                                            {
                                                                <button type="button"
                                                                        class="slot-cell-btn trial-slot-picker-btn"
                                                                        data-iso="@matchingSlot.IsoValue"
                                                                        data-date="@matchingSlot.DateLabel"
                                                                        data-time="@matchingSlot.TimeRange"
                                                                        data-display="@matchingSlot.DisplayText"
                                                                        title="Bấm để chọn: @matchingSlot.DisplayText (2 tiếng)">
                                                                    <span>@matchingSlot.StartTime.ToString("HH:mm") – @matchingSlot.EndTime.ToString("HH:mm")</span>
                                                                    <span class="duration-tag"><i class="bi bi-check-circle me-1"></i>2 tiếng</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <div class="slot-cell-empty">-</div>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Tuần 2 (nếu có) -->
                            @if (week2Dates.Count > 0)
                            {
                                <div class="tab-pane fade" id="week2-content" role="tabpanel">
                                    <div class="mobile-scroll-hint"><i class="bi bi-arrows-expand"></i> Vuốt ngang để xem đủ các ngày trong tuần</div>
                                <div class="timetable-wrapper mb-2">
                                        <table class="timetable-grid">
                                            <thead>
                                                <tr>
                                                    <th class="time-col">Khung giờ</th>
                                                    @foreach (var d in week2Dates)
                                                    {
                                                        <th>
                                                            <div>@FormatShortDay(d.DayOfWeek)</div>
                                                            <div class="small text-muted" style="font-size:10px;">@d.ToString("dd/MM")</div>
                                                        </th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var block in blocksList)
                                                {
                                                    <tr>
                                                        <th class="time-col">@block.Label</th>
                                                        @foreach (var d in week2Dates)
                                                        {
                                                            var matchingSlot = allSlots.FirstOrDefault(s =>
                                                                DateOnly.FromDateTime(s.SlotUtc.AddHours(7)) == d
                                                                && s.StartTime.Hour == block.Start);

                                                            <td>
                                                                @if (matchingSlot != null)
                                                                {
                                                                    <button type="button"
                                                                            class="slot-cell-btn trial-slot-picker-btn"
                                                                            data-iso="@matchingSlot.IsoValue"
                                                                            data-date="@matchingSlot.DateLabel"
                                                                            data-time="@matchingSlot.TimeRange"
                                                                            data-display="@matchingSlot.DisplayText"
                                                                            title="Bấm để chọn: @matchingSlot.DisplayText (2 tiếng)">
                                                                        <span>@matchingSlot.StartTime.ToString("HH:mm") – @matchingSlot.EndTime.ToString("HH:mm")</span>
                                                                        <span class="duration-tag"><i class="bi bi-check-circle me-1"></i>2 tiếng</span>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <div class="slot-cell-empty">-</div>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Lớp học nhóm đang mở (nếu có) -->
                @if (Model.Classrooms.Count > 0)
                {
                    <div class="pro-card">
                        <h2 class="section-title"><i class="bi bi-easel"></i> Các lớp học nhóm đang tuyển sinh</h2>
                        <div class="row g-3">
                            @foreach (var cls in Model.Classrooms)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 h-100 d-flex flex-column justify-content-between bg-light">
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(cls.CoverImageUrl))
                                            {
                                                <img src="@cls.CoverImageUrl" alt="Ảnh bìa lớp @cls.Name" class="w-100 rounded mb-2" style="height:140px;object-fit:cover" loading="lazy" />
                                            }
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    @cls.SubjectName · @cls.GradeLevelName
                                                </span>
                                                <span class="fw-bold text-danger">@cls.Fee.ToString("N0", money) đ</span>
                                            </div>
                                            <h6 class="fw-bold mb-1">@cls.Name</h6>
                                            <p class="text-muted small mb-2">@cls.Description</p>
                                            @if (!string.IsNullOrWhiteSpace(cls.ScheduleSummary))
                                            {
                                                <div class="mb-2 p-2 bg-white rounded border small">
                                                    <i class="bi bi-calendar-event text-danger me-1"></i><strong>Lịch học:</strong> @cls.ScheduleSummary
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                                            <span><i class="bi bi-people me-1"></i> @cls.StudentCount / @cls.MaxStudents học viên</span>
                                            <span class="text-success fw-medium">Còn @cls.AvailableSeats chỗ</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Đánh giá từ học viên -->
                <div class="pro-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="section-title mb-0"><i class="bi bi-chat-quote"></i> Đánh giá từ học viên</h2>
                        <span class="badge bg-secondary-subtle text-secondary">@Model.Reviews.Count lượt đánh giá</span>
                    </div>

                    @if (Model.Reviews.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có đánh giá nào cho gia sư này.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var rev in Model.Reviews)
                            {
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(rev.StudentAvatarUrl))
                                            {
                                                <img src="@rev.StudentAvatarUrl" alt="@rev.StudentName" width="32" height="32" class="rounded-circle" onerror="this.onerror=null;this.src='/assets/img/default-avatar.svg';" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:.75rem;">
                                                    @rev.StudentName.FirstOrDefault()
                                                </div>
                                            }
                                            <span class="fw-semibold small">@rev.StudentName</span>
                                        </div>
                                        <div class="text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rev.Score)
                                                {
                                                    <i class="bi bi-star-fill text-warning" style="color:#f59e0b !important;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted"></i>
                                                }
                                            }
                                            <span class="text-muted ms-1">@rev.TimeAgo</span>
                                        </div>
                                    </div>
                                    <p class="mb-0 text-secondary small">@(string.IsNullOrWhiteSpace(rev.Comment) ? "Học viên không để lại lời nhận xét." : rev.Comment)</p>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- Cột phải: Form Gửi yêu cầu kết nối học tập (Sticky) -->
        <div class="col-lg-4">
            <div class="sticky-card">
                <div class="pro-card border-danger-subtle shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <i class="bi bi-send-check-fill text-danger fs-4"></i>
                        <div>
                            <h2 class="h6 mb-0 fw-bold">Gửi yêu cầu kết nối</h2>
                            <small class="text-muted">Đăng ký học trực tiếp với gia sư</small>
                        </div>
                    </div>

                    <div class="request-steps" aria-label="Các bước đăng ký học">
                        <div class="request-step is-active" aria-current="step">
                            <span class="request-step-number">1</span>
                            <span>Gửi yêu cầu</span>
                        </div>
                        <span class="request-step-line" aria-hidden="true"></span>
                        <div class="request-step">
                            <span class="request-step-number">2</span>
                            <span>Đặt lịch thử</span>
                        </div>
                        <span class="request-step-line" aria-hidden="true"></span>
                        <div class="request-step">
                            <span class="request-step-number">3</span>
                            <span>Vào lớp</span>
                        </div>
                    </div>

                    @if (Model.SubjectOptions.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Gia sư này chưa cập nhật môn học giảng dạy cụ thể nên hiện chưa thể gửi yêu cầu.
                        </div>
                    }
                    else
                    {
                        <form asp-area="Student_Parent" asp-controller="Send_Details_Tutor" asp-action="SendRequest" method="post" id="sendRequestForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Request.TutorId" value="@Model.TutorId" />
                            <input type="hidden" asp-for="Request.SubjectId" id="hiddenSubjectId" value="@Model.Request.SubjectId" />
                            <input type="hidden" asp-for="Request.GradeLevelId" id="hiddenGradeLevelId" value="@Model.Request.GradeLevelId" />
                            <input type="hidden" asp-for="Request.ProposedTrialSlotUtc" id="hiddenProposedTrialSlotUtc" />
                            <div id="hiddenSlotsContainer"></div>

                            <!-- Chọn môn học & cấp học -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" for="subjectGradeSelect">
                                    Môn học &amp; Cấp học <span class="text-danger">*</span>
                                </label>
                                <select id="subjectGradeSelect" class="form-select form-select-sm" required>
                                    @foreach (var opt in Model.SubjectOptions)
                                    {
                                        <option value="@opt.Value">@opt.Text</option>
                                    }
                                </select>
                                <span class="text-danger small" asp-validation-for="Request.SubjectId"></span>
                            </div>

                            <!-- Chọn hình thức học -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Hình thức học mong muốn</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="Request.PreferredType" id="typeOneToOne" value="@ClassroomType.OneToOne" checked />
                                        <label class="form-check-label small" for="typeOneToOne">1 kèm 1</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="Request.PreferredType" id="typeGroup" value="@ClassroomType.Group" />
                                        <label class="form-check-label small" for="typeGroup">Lớp nhóm</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Khi chọn 1 kèm 1: Chọn slot học từ lịch rảnh thực tế của gia sư (Bắt buộc đủ 4 tiếng: 2 buổi, mỗi buổi 2 tiếng) -->
                            <div class="mb-3" id="trialSlotSection">
                                <label class="form-label small fw-semibold d-flex justify-content-between align-items-center mb-1">
                                    <span><i class="bi bi-clock-history text-danger me-1"></i> Khung giờ học đề xuất (1 kèm 1) <span class="text-danger">*</span></span>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" id="hoursCountBadge" style="font-size:10px;">0 / 4 tiếng (0/2 buổi)</span>
                                </label>

                                <!-- Thanh tiến độ chọn giờ -->
                                <div class="progress mb-2" style="height: 6px;">
                                    <div id="slotProgressBar" class="progress-bar bg-danger" role="progressbar" style="width: 0%; transition: width .3s ease;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>

                                <div id="noSlotSelectedNotice" class="p-3 border rounded-3 bg-light text-center">
                                    <i class="bi bi-calendar-event text-danger fs-3 d-block mb-1"></i>
                                    <div class="small fw-semibold text-dark">Chưa chọn đủ lịch học</div>
                                    <p class="text-muted small mb-0 mt-1" style="font-size: 11px;">
                                        Bắt buộc chọn <strong>đủ 4 tiếng (2 buổi, mỗi buổi 2 tiếng)</strong> trực tiếp trên <strong>Khung lịch rảnh</strong> bên cạnh để chia đều trong tuần.
                                    </p>
                                </div>

                                <div id="slotSelectedCard" class="p-3 border rounded-3 d-none">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="small fw-bold text-dark" style="font-size: 12px;">Các buổi học đã chọn:</span>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" id="clearAllSlotsBtn" style="font-size: 11px;">
                                            <i class="bi bi-trash3 me-1"></i>Xóa tất cả
                                        </button>
                                    </div>
                                    <div id="selectedSlotsList" class="d-flex flex-column gap-2 mb-2">
                                        <!-- Rendered via JS -->
                                    </div>
                                    <div id="slotStatusAlert">
                                        <!-- Alert status via JS -->
                                    </div>
                                </div>

                                <div class="form-text small text-muted mt-1" style="font-size: 11px;">
                                    <i class="bi bi-shield-check text-success me-1"></i>Lớp 1 kèm 1 yêu cầu chọn đúng 2 buổi (mỗi buổi 2 tiếng) để đạt đủ 4 tiếng/tuần.
                                </div>
                            </div>

                            <!-- Khi chọn Lớp nhóm: Chọn lớp nhóm có sẵn kèm thông tin lịch học cố định -->
                            <div class="mb-3 d-none" id="classroomSelectBox">
                                <label class="form-label small fw-semibold" asp-for="Request.ClassroomId">
                                    <i class="bi bi-easel text-danger me-1"></i> Chọn lớp nhóm gia sư đang tuyển sinh <span class="text-danger">*</span>
                                </label>
                                @if (Model.Classrooms.Count == 0)
                                {
                                    <div class="alert alert-warning small p-2 mb-0">
                                        Gia sư hiện chưa mở lớp nhóm nào còn chỗ. Vui lòng chọn hình thức <strong>1 kèm 1</strong>.
                                    </div>
                                }
                                else
                                {
                                    <select asp-for="Request.ClassroomId" class="form-select form-select-sm" id="classroomSelect">
                                        <option value="">-- Chọn lớp nhóm mở sẵn --</option>
                                        @foreach (var cls in Model.Classrooms)
                                        {
                                            <option value="@cls.Id" data-schedule="@cls.ScheduleSummary" data-fee="@cls.Fee.ToString("N0", money)">
                                                @cls.Name (@cls.SubjectName - @cls.GradeLevelName) · Còn @cls.AvailableSeats chỗ
                                            </option>
                                        }
                                    </select>
                                    <div id="classroomScheduleBadge" class="mt-2 p-2 bg-light border rounded small d-none">
                                        <div class="text-danger fw-semibold"><i class="bi bi-calendar-check me-1"></i>Lịch học cố định:</div>
                                        <div class="text-dark" id="classroomScheduleText"></div>
                                    </div>
                                }
                            </div>

                            <!-- Lời nhắn -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold" asp-for="Request.Message">
                                    Lời nhắn / Mục tiêu học tập
                                </label>
                                <textarea asp-for="Request.Message" class="form-control form-control-sm" rows="4"
                                          placeholder="Ví dụ: Em muốn ôn thi vào lớp 10 môn Toán, mục tiêu 8.5+, mong muốn học 2 buổi/tuần vào các buổi tối thứ 3 và thứ 6..."></textarea>
                                <span class="text-danger small" asp-validation-for="Request.Message"></span>
                            </div>

                            <!-- Cam kết & Gửi -->
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-brand w-100 py-2" id="submitBtn">
                                    <i class="bi bi-send-fill me-1"></i> Gửi yêu cầu ngay
                                </button>
                            </div>

                            <div class="mt-3 text-center">
                                <small class="text-muted d-block">
                                    <i class="bi bi-shield-check text-success me-1"></i>
                                    Thông tin kết nối được bảo mật an toàn. Gia sư sẽ nhận được thông báo tức thì.
                                </small>
                            </div>
                        </form>
                    }
                </div>

                <section class="pro-card tutor-chat-card" aria-labelledby="tutorChatTitle">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h2 class="h6 fw-bold mb-0" id="tutorChatTitle">
                            <i class="bi bi-chat-dots text-danger me-1"></i> Trò chuyện
                        </h2>
                        @if (Model.ExistingRequestStatus == RequestStatus.Accepted)
                        {
                            <span class="badge bg-success-subtle text-success">Đã kết nối</span>
                        }
                        else
                        {
                            <span class="small text-muted">Chưa kết nối</span>
                        }
                    </div>
                    <p class="small text-muted mb-3">
                        <i class="bi bi-lock me-1"></i> Bạn có thể trò chuyện sau khi gia sư chấp nhận yêu cầu.
                    </p>
                    @if (Model.ExistingRequestStatus == RequestStatus.Accepted)
                    {
                        <a asp-area="" asp-controller="Chat" asp-action="Index" asp-route-contactId="@Model.UserId" class="btn btn-sm btn-danger w-100 mb-2">
                            <i class="bi bi-chat-dots-fill me-1"></i> Mở trò chuyện với gia sư
                        </a>
                    }
                    else
                    {
                        <div class="tutor-chat-history mb-2" role="status">Chưa có tin nhắn</div>
                    }
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" placeholder="Nhập tin nhắn..." aria-label="Tin nhắn" disabled />
                        <button class="btn btn-outline-secondary" type="button" aria-label="Gửi tin nhắn" disabled>
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const select = document.getElementById('subjectGradeSelect');
            const hiddenSubject = document.getElementById('hiddenSubjectId');
            const hiddenGrade = document.getElementById('hiddenGradeLevelId');
            const radioOneToOne = document.getElementById('typeOneToOne');
            const radioGroup = document.getElementById('typeGroup');
            const classroomBox = document.getElementById('classroomSelectBox');
            const trialSlotSection = document.getElementById('trialSlotSection');
            const hiddenTrialSlot = document.getElementById('hiddenProposedTrialSlotUtc');
            const classroomSelect = document.getElementById('classroomSelect');
            const scheduleBadge = document.getElementById('classroomScheduleBadge');
            const scheduleText = document.getElementById('classroomScheduleText');

            const noSlotNotice = document.getElementById('noSlotSelectedNotice');
            const slotSelectedCard = document.getElementById('slotSelectedCard');
            const clearAllSlotsBtn = document.getElementById('clearAllSlotsBtn');
            const selectedSlotsList = document.getElementById('selectedSlotsList');
            const slotStatusAlert = document.getElementById('slotStatusAlert');
            const hoursCountBadge = document.getElementById('hoursCountBadge');
            const slotProgressBar = document.getElementById('slotProgressBar');
            const hiddenSlotsContainer = document.getElementById('hiddenSlotsContainer');
            const sendRequestForm = document.getElementById('sendRequestForm');

            function syncSubjectGrade() {
                if (!select) return;
                const val = select.value;
                if (val && val.includes('_')) {
                    const parts = val.split('_');
                    hiddenSubject.value = parts[0];
                    hiddenGrade.value = parts[1];
                }
            }

            if (select) {
                select.addEventListener('change', syncSubjectGrade);
                syncSubjectGrade();
            }

            if (radioGroup && radioOneToOne && classroomBox) {
                radioGroup.addEventListener('change', function () {
                    if (this.checked) classroomBox.classList.remove('d-none');
                });
                radioOneToOne.addEventListener('change', function () {
                    if (this.checked) classroomBox.classList.add('d-none');
            function toggleType() {
                if (radioGroup && radioGroup.checked) {
                    if (classroomBox) classroomBox.classList.remove('d-none');
                    if (trialSlotSection) trialSlotSection.classList.add('d-none');
                } else {
                    if (classroomBox) classroomBox.classList.add('d-none');
                    if (trialSlotSection) trialSlotSection.classList.remove('d-none');
                    if (classroomSelect) classroomSelect.value = '';
                    if (scheduleBadge) scheduleBadge.classList.add('d-none');
                }
            }

            if (radioGroup) radioGroup.addEventListener('change', toggleType);
            if (radioOneToOne) radioOneToOne.addEventListener('change', toggleType);

            const slotBtns = document.querySelectorAll('.trial-slot-picker-btn');

            // Quản lý danh sách các slot đã chọn (Bắt buộc đủ 4 tiếng: 2 buổi, mỗi buổi 2 tiếng)
            let selectedSlots = [];
            const MAX_SLOTS = 2; // 2 buổi x 2 tiếng = 4 tiếng/tuần

            function updateSlotsUi() {
                // 1. Cập nhật giao diện trên các nút trong bảng lịch
                slotBtns.forEach(btn => {
                    const btnIso = btn.dataset.iso;
                    const slotIndex = selectedSlots.findIndex(s => s.iso === btnIso);
                    const tagEl = btn.querySelector('.duration-tag');
                    if (slotIndex >= 0) {
                        btn.classList.add('is-selected');
                        if (tagEl) tagEl.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i>Buổi ${slotIndex + 1}`;
                    } else {
                        btn.classList.remove('is-selected');
                        if (tagEl) tagEl.innerHTML = `<i class="bi bi-clock me-1"></i>2 tiếng`;
                    }
                });

                // 2. Cập nhật các input hidden gửi lên server
                if (hiddenSlotsContainer) {
                    hiddenSlotsContainer.innerHTML = '';
                    selectedSlots.forEach(s => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'Request.ProposedTrialSlotsUtc';
                        input.value = s.iso;
                        hiddenSlotsContainer.appendChild(input);
                    });
                }
                if (hiddenTrialSlot) {
                    hiddenTrialSlot.value = selectedSlots.length > 0 ? selectedSlots[0].iso : '';
                }

                // 3. Cập nhật tiến độ & huy hiệu
                const count = selectedSlots.length;
                const hours = count * 2;
                const percent = Math.min(100, Math.round((hours / 4) * 100));

                if (hoursCountBadge) {
                    hoursCountBadge.textContent = `${hours} / 4 tiếng (${count}/2 buổi)`;
                    if (count >= 2) {
                        hoursCountBadge.className = 'badge bg-success text-white border border-success';
                    } else if (count === 1) {
                        hoursCountBadge.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                    } else {
                        hoursCountBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle';
                    }
                }

                if (slotProgressBar) {
                    slotProgressBar.style.width = `${percent}%`;
                    if (count >= 2) {
                        slotProgressBar.className = 'progress-bar bg-success';
                    } else if (count === 1) {
                        slotProgressBar.className = 'progress-bar bg-warning';
                    } else {
                        slotProgressBar.className = 'progress-bar bg-danger';
                    }
                }

                // 4. Render danh sách buổi đã chọn trong card
                if (count === 0) {
                    if (noSlotNotice) noSlotNotice.classList.remove('d-none');
                    if (slotSelectedCard) slotSelectedCard.classList.add('d-none');
                } else {
                    if (noSlotNotice) noSlotNotice.classList.add('d-none');
                    if (slotSelectedCard) {
                        slotSelectedCard.classList.remove('d-none');
                        if (count >= 2) {
                            slotSelectedCard.className = 'p-3 border border-success rounded-3 bg-success-subtle';
                        } else {
                            slotSelectedCard.className = 'p-3 border border-warning rounded-3 bg-warning-subtle';
                        }
                    }

                    if (selectedSlotsList) {
                        selectedSlotsList.innerHTML = selectedSlots.map((s, idx) => `
                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white border">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge ${idx === 0 ? 'bg-primary' : 'bg-success'} text-white rounded-circle d-flex align-items-center justify-content-center" style="width:20px;height:20px;font-size:10px;">${idx + 1}</span>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size:12px;">${s.date}</div>
                                        <div class="text-secondary small" style="font-size:11px;">${s.time} (Khối 2 tiếng)</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 btn-remove-single-slot" data-iso="${s.iso}" title="Bỏ chọn buổi này" style="font-size:11px;">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        `).join('');

                        selectedSlotsList.querySelectorAll('.btn-remove-single-slot').forEach(btn => {
                            btn.addEventListener('click', function (e) {
                                e.stopPropagation();
                                const isoToRemove = this.dataset.iso;
                                selectedSlots = selectedSlots.filter(s => s.iso !== isoToRemove);
                                updateSlotsUi();
                            });
                        });
                    }

                    if (slotStatusAlert) {
                        if (count >= 2) {
                            slotStatusAlert.className = 'small p-2 rounded bg-success text-white d-flex align-items-center gap-2 mt-2';
                            slotStatusAlert.innerHTML = '<i class="bi bi-check-circle-fill fs-6"></i><span><strong>Đã chọn đủ 4 tiếng (2 buổi/tuần)!</strong> Bạn đã sẵn sàng gửi yêu cầu.</span>';
                        } else {
                            slotStatusAlert.className = 'small p-2 rounded bg-warning text-dark d-flex align-items-center gap-2 mt-2';
                            slotStatusAlert.innerHTML = '<i class="bi bi-exclamation-circle-fill fs-6"></i><span><strong>Đã chọn 2/4 tiếng.</strong> Vui lòng bấm chọn thêm 1 buổi (2 tiếng) nữa trên lịch rảnh để đủ 4 tiếng.</span>';
                        }
                    }
                }
            }

            function deselectAllSlots() {
                selectedSlots = [];
                updateSlotsUi();
            }

            slotBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    const isoVal = this.dataset.iso;
                    const dateText = this.dataset.date;
                    const timeText = this.dataset.time;
                    const displayText = this.dataset.display || `${dateText} ${timeText}`;

                    const existingIndex = selectedSlots.findIndex(s => s.iso === isoVal);
                    if (existingIndex >= 0) {
                        // Bấm lại ô đang chọn để hủy chọn
                        selectedSlots.splice(existingIndex, 1);
                        updateSlotsUi();
                        return;
                    }

                    // Nếu đã chọn đủ 2 buổi (4 tiếng) mà cố chọn thêm
                    if (selectedSlots.length >= MAX_SLOTS) {
                        alert('Bạn đã chọn đủ 4 tiếng (2 buổi/tuần). Nếu muốn đổi khung giờ, vui lòng bấm nút (X) bỏ chọn bớt 1 buổi trước.');
                        return;
                    }

                    selectedSlots.push({
                        iso: isoVal,
                        date: dateText,
                        time: timeText,
                        display: displayText
                    });

                    // Tự động chuyển radio sang 1 kèm 1 nếu đang ở nhóm
                    if (radioOneToOne && !radioOneToOne.checked) {
                        radioOneToOne.checked = true;
                        toggleType();
                    }

                    updateSlotsUi();

                    // Cuộn nhẹ tới form nếu trên màn hình nhỏ
                    if (window.innerWidth < 992 && slotSelectedCard) {
                        slotSelectedCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                });
            });

            if (clearAllSlotsBtn) {
                clearAllSlotsBtn.addEventListener('click', function () {
                    deselectAllSlots();
                });
            }

            // Kiểm tra ràng buộc khi gửi form: 1 kèm 1 bắt buộc phải chọn ĐỦ 4 TIẾNG (2 buổi x 2 tiếng)
            if (sendRequestForm) {
                sendRequestForm.addEventListener('submit', function (e) {
                    if (radioOneToOne && radioOneToOne.checked) {
                        if (selectedSlots.length < 2) {
                            e.preventDefault();
                            const currentHours = selectedSlots.length * 2;
                            alert(`Lớp 1 kèm 1 bắt buộc phải chọn đủ 4 tiếng (2 buổi học, mỗi buổi 2 tiếng) chia đều trong tuần.\nHiện tại bạn mới chọn ${currentHours}/4 tiếng (${selectedSlots.length}/2 buổi).`);
                            const schedCard = document.getElementById('tutorScheduleCard');
                            if (schedCard) {
                                schedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                schedCard.classList.add('border-danger', 'shadow');
                                setTimeout(() => schedCard.classList.remove('border-danger', 'shadow'), 2500);
                            }
                            return false;
                        }
                    }
                });
            }

            if (classroomSelect && scheduleBadge && scheduleText) {
                classroomSelect.addEventListener('change', function () {
                    const opt = this.options[this.selectedIndex];
                    const sched = opt ? opt.getAttribute('data-schedule') : null;
                    if (sched) {
                        scheduleText.textContent = sched;
                        scheduleBadge.classList.remove('d-none');
                    } else {
                        scheduleBadge.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}
