@using static PROJECT_OTSP.Models.Enums
@model PROJECT_OTSP.Dtos.Student.StudentSchedulePageVm
@inject PROJECT_OTSP.Services.IScheduleBlockService BlockService

@{
    Layout = "_Layout_Student";
    ViewData["Title"] = "Lịch học sinh viên";

    var days = new[]
    {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };

    var dayShortLabels = new Dictionary<DayOfWeek, string>
    {
        [DayOfWeek.Monday] = "Thứ 2",
        [DayOfWeek.Tuesday] = "Thứ 3",
        [DayOfWeek.Wednesday] = "Thứ 4",
        [DayOfWeek.Thursday] = "Thứ 5",
        [DayOfWeek.Friday] = "Thứ 6",
        [DayOfWeek.Saturday] = "Thứ 7",
        [DayOfWeek.Sunday] = "Chủ nhật"
    };

    var blocks = BlockService.Blocks;
    var rows = new List<(int Start, int End, bool IsRest)>();
    for (var b = 0; b < blocks.Count; b++)
    {
        rows.Add((blocks[b].Start, blocks[b].End, false));
    }

    Func<int, string> periodOf = startHour => startHour < 12 ? "Sáng" : startHour < 17 ? "Chiều" : "Tối";
    Func<int, int> spanFrom = index =>
    {
        var p = periodOf(rows[index].Start);
        var n = 0;
        for (var k = index; k < rows.Count && !rows[k].IsRest && periodOf(rows[k].Start) == p; k++) n++;
        return n;
    };
}

<style>
    .schedule-page {
        --availability-accent: var(--bs-danger, #DB303A);
        --availability-accent-text: #B7212B;
        --availability-accent-soft: #FDE8E8;
        --availability-accent-border: #FCA5A5;
        --availability-border: var(--bs-border-color, #E5E7EB);
        --availability-busy-bg: #374151;
        --availability-busy-border: #1F2937;
        --availability-busy-text: #FFFFFF;
    }

    .schedule-card {
        background: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--availability-border);
        border-radius: 8px;
    }

    [data-bs-theme="dark"] .schedule-card {
        background: #1e293b !important;
        border-color: #334155 !important;
    }

    .schedule-table-wrap {
        overflow-x: auto;
    }

    .schedule-table {
        width: 100%;
        min-width: 820px;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 3px 4px;
        font-size: 12px;
    }

    .schedule-table th {
        padding: 6px 4px;
        color: var(--bs-body-color);
        font-weight: 500;
        text-align: center;
        white-space: nowrap;
    }

    .schedule-table th.period-column {
        width: 48px;
    }

    .schedule-table th.time-column {
        width: 104px;
    }

    .schedule-table td {
        padding: 0 1px;
        text-align: center;
        vertical-align: middle;
    }

    .schedule-period-label {
        color: var(--availability-accent-text);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .schedule-time-label {
        color: var(--bs-secondary-color);
        font-size: 11px;
        white-space: nowrap;
    }

    .schedule-table th.day-column {
        background: var(--bs-tertiary-bg);
        border-radius: 4px;
    }

    .schedule-table th.day-column.is-today {
        background: var(--availability-accent-soft);
        color: var(--availability-accent-text);
        border: 1px solid var(--availability-accent-border);
    }

    .day-title {
        font-size: 12px;
        font-weight: 700;
        line-height: 1.2;
    }

    .day-date {
        font-size: 11px;
        color: var(--bs-secondary-color);
    }

    .is-today .day-date {
        color: var(--availability-accent-text);
        font-weight: 600;
    }

    .schedule-slot-empty {
        width: 100%;
        min-height: 48px;
        border: 1px solid var(--availability-border);
        border-radius: 4px;
        background: #ffffff;
        transition: background-color .15s ease;
    }

    .schedule-session-card {
        border-radius: 4px;
        padding: 6px 8px;
        text-align: left;
        font-size: 11px;
        line-height: 1.3;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-left: 3px solid #334155;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        transition: all 0.15s ease;
    }

    .schedule-session-card.status-inprogress {
        border-left-color: #0284c7;
        background: #f0f9ff;
    }

    .schedule-session-card.status-done {
        border-left-color: #15803d;
        background: #f0fdf4;
    }

    .schedule-session-card.status-trial {
        border-left-color: #dc2626;
        background: #fef2f2;
    }

    .schedule-session-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(0,0,0,0.08);
    }

    .session-time {
        font-size: 11px;
        font-weight: 600;
        color: var(--bs-body-color, #1e293b);
    }

    .session-tutor {
        font-weight: 600;
        color: var(--bs-heading-color, #0f172a);
        margin-top: 2px;
    }

    .session-sub {
        font-size: 10px;
        color: var(--bs-secondary-color, #64748b);
    }

    [data-bs-theme="dark"] .schedule-session-card {
        background: #1e293b !important;
        border-color: #334155 !important;
    }
    [data-bs-theme="dark"] .schedule-session-card.status-inprogress {
        border-left-color: #38bdf8 !important;
        background: rgba(2, 132, 199, 0.2) !important;
    }
    [data-bs-theme="dark"] .schedule-session-card.status-done {
        border-left-color: #22c55e !important;
        background: rgba(21, 128, 61, 0.2) !important;
    }
    [data-bs-theme="dark"] .schedule-session-card.status-trial {
        border-left-color: #f87171 !important;
        background: rgba(220, 38, 38, 0.2) !important;
    }
    [data-bs-theme="dark"] .session-time {
        color: #f1f5f9 !important;
    }
    [data-bs-theme="dark"] .session-tutor {
        color: #ffffff !important;
    }
    [data-bs-theme="dark"] .session-sub {
        color: #94a3b8 !important;
    }

    .btn-danger-custom {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
        color: #ffffff !important;
        border-radius: 4px;
    }

    .availability-mobile-day-picker {
        display: none;
    }

    .availability-day-button {
        border: 1px solid var(--availability-border);
        border-radius: var(--bs-border-radius);
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        padding: .45rem .6rem;
        font-size: .85rem;
    }

    .availability-day-button[aria-pressed="true"] {
        border-color: var(--availability-accent);
        background: var(--availability-accent);
        color: #fff;
    }

    @@media (max-width: 767.98px) {
        .availability-mobile-day-picker {
            display: flex;
            gap: .3rem;
            overflow-x: auto;
            padding: .1rem .1rem .5rem;
        }

        .schedule-table th[data-day-column],
        .schedule-table td[data-day-column] {
            display: none;
        }

        .schedule-page[data-active-day="1"] .schedule-table [data-day-column="1"],
        .schedule-page[data-active-day="2"] .schedule-table [data-day-column="2"],
        .schedule-page[data-active-day="3"] .schedule-table [data-day-column="3"],
        .schedule-page[data-active-day="4"] .schedule-table [data-day-column="4"],
        .schedule-page[data-active-day="5"] .schedule-table [data-day-column="5"],
        .schedule-page[data-active-day="6"] .schedule-table [data-day-column="6"],
        .schedule-page[data-active-day="0"] .schedule-table [data-day-column="0"] {
            display: table-cell;
        }
    }
</style>

<div class="container-fluid py-4 schedule-page" data-active-day="@((int)Model.TodayVn.DayOfWeek)">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1 fw-bold">Lịch học sinh viên</h1>
            <p class="text-body-secondary mb-0">Thời khóa biểu học tập của bạn theo giờ Việt Nam (GMT+7). Mỗi buổi học được xếp theo khối 2 tiếng.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Student_Parent" asp-controller="StudentClassroom" asp-action="Index" class="btn btn-outline-danger">
                <i class="bi bi-mortarboard me-1" aria-hidden="true"></i>Xem lớp của tôi
            </a>
            <a asp-area="Student_Parent" asp-controller="Search" asp-action="Index" class="btn btn-danger-custom">
                <i class="bi bi-search me-1" aria-hidden="true"></i>Tìm gia sư
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="status">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Điều hướng tuần -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Index" asp-route-weekOffset="@(Model.WeekOffset - 1)" class="btn btn-outline-secondary btn-sm" aria-label="Tuần trước">
                        <i class="bi bi-chevron-left me-1"></i>Tuần trước
                    </a>
                    <a asp-action="Index" asp-route-weekOffset="0" class="btn btn-outline-danger btn-sm @(Model.WeekOffset == 0 ? "active" : "")">
                        Tuần này
                    </a>
                    <a asp-action="Index" asp-route-weekOffset="@(Model.WeekOffset + 1)" class="btn btn-outline-secondary btn-sm" aria-label="Tuần sau">
                        Tuần sau<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>

                <div class="fw-bold text-body fs-6 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-danger" aria-hidden="true"></i>
                    <span>Từ @Model.SelectedMonday.ToString("dd/MM/yyyy") đến @Model.SelectedSunday.ToString("dd/MM/yyyy")</span>
                </div>

                <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                    <label for="jumpDateInput" class="small text-body-secondary mb-0 d-none d-sm-inline">Đến ngày:</label>
                    <input id="jumpDateInput" type="date" name="jumpDate" class="form-control form-control-sm"
                           value="@Model.SelectedMonday.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </form>
            </div>
        </div>
    </div>

    <!-- Khối Bảng Thời Khóa Biểu (Chuẩn theo Image 2) -->
    <div class="schedule-card p-3 shadow-sm mb-4">
        <!-- Chú thích -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-2 border-bottom">
            <div class="d-flex flex-wrap align-items-center gap-3 small text-body-secondary">
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge text-bg-primary" style="font-size: 8px;">Đang diễn ra</span> Buổi học đang mở phòng
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge text-bg-success" style="font-size: 8px;">Đã học</span> Buổi học đã hoàn thành
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge text-bg-secondary" style="font-size: 8px;">Sắp tới</span> Lịch học đã xếp
                </span>
            </div>
            <div class="small text-body-secondary">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>Bấm "Vào lớp" khi tới giờ học để tham gia phòng học trực tuyến.
            </div>
        </div>

        <!-- Mobile day picker -->
        <div class="availability-mobile-day-picker mb-2" role="group" aria-label="Chọn ngày trong tuần">
            @for (var i = 0; i < 7; i++)
            {
                var dayDate = Model.SelectedMonday.AddDays(i);
                var isToday = dayDate == Model.TodayVn;
                var active = i == 0;
                <button type="button" class="availability-day-button"
                        data-mobile-day="@((int)dayDate.DayOfWeek)" aria-pressed="@(active ? "true" : "false")">
                    @dayShortLabels[dayDate.DayOfWeek] @dayDate.ToString("dd/MM") @(isToday ? "•" : "")
                </button>
            }
        </div>

        <!-- Table Grid -->
        <div class="mobile-scroll-hint px-3 pt-2"><i class="bi bi-arrows-expand"></i> Vuốt ngang để xem đủ các ngày trong tuần</div>
        <div class="schedule-table-wrap">
            <table class="schedule-table mb-0" aria-label="Thời khóa biểu lịch học trong tuần">
                <thead>
                    <tr>
                        <th class="period-column" scope="col">Buổi</th>
                        <th class="time-column" scope="col">Khung giờ</th>
                        @for (var i = 0; i < 7; i++)
                        {
                            var dayDate = Model.SelectedMonday.AddDays(i);
                            var isToday = dayDate == Model.TodayVn;
                            var dayTitle = dayShortLabels[dayDate.DayOfWeek];
                            <th scope="col" class="day-column @(isToday ? "is-today" : "")" data-day-column="@((int)dayDate.DayOfWeek)">
                                <div class="day-title">@dayTitle</div>
                                <div class="day-date">@dayDate.ToString("dd/MM")</div>
                                @if (isToday)
                                {
                                    <span class="badge rounded-pill text-bg-danger mt-1" style="font-size: 9px;">Hôm nay</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var r = 0; r < rows.Count; r++)
                    {
                        var row = rows[r];
                        var period = periodOf(row.Start);
                        var isFirstOfPeriod = r == 0 || rows[r - 1].IsRest || periodOf(rows[r - 1].Start) != period;
                        <tr>
                            @if (isFirstOfPeriod)
                            {
                                <th class="schedule-period-label" scope="rowgroup" rowspan="@spanFrom(r)">@period</th>
                            }
                            <th class="schedule-time-label" scope="row">
                                @string.Format("{0:00}:00 - {1:00}:00", row.Start, row.End)
                            </th>
                            @for (var i = 0; i < 7; i++)
                            {
                                var dayDate = Model.SelectedMonday.AddDays(i);
                                var dayOfWeek = dayDate.DayOfWeek;

                                // Buổi học nằm trong khối nếu giờ bắt đầu (giờ VN) rơi vào [Start, End)
                                var sessions = Model.Sessions
                                    .Where(s => s.Date == dayDate && s.Hour >= row.Start && s.Hour < row.End)
                                    .ToList();

                                <td data-day-column="@((int)dayOfWeek)">
                                    @if (sessions.Count > 0)
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var session in sessions)
                                            {
                                                var isDone = session.Status == SessionStatus.Done;
                                                var isInProgress = session.Status == SessionStatus.InProgress;
                                                var isCancelled = session.Status == SessionStatus.Cancelled;

                                                var statusBadgeClass = isDone ? "text-bg-success" 
                                                    : isInProgress ? "text-bg-primary" 
                                                    : isCancelled ? "text-bg-danger" 
                                                    : session.IsMakeup ? "text-bg-info text-white" 
                                                    : "text-bg-dark";

                                                var statusBadgeLabel = isDone ? "Đã học" 
                                                    : isInProgress ? "Đang diễn ra" 
                                                    : isCancelled ? "Gia sư báo bận" 
                                                    : session.IsMakeup ? "Buổi học bù" 
                                                    : "Sắp tới";

                                                var cardClass = isDone ? "status-done" 
                                                    : isInProgress ? "status-inprogress" 
                                                    : isCancelled ? "status-cancelled border-danger-subtle bg-danger-subtle" 
                                                    : session.IsTrial ? "status-trial" 
                                                    : "";

                                                <div class="schedule-session-card @cardClass" title="@session.ClassroomName">
                                                    <div class="d-flex align-items-center justify-content-between gap-1">
                                                        <span class="session-time"><i class="bi bi-clock me-1"></i>@session.ScheduledAtVn.ToString("HH:mm")</span>
                                                        <span class="badge @statusBadgeClass" style="font-size: 8px; padding: 2px 4px;">@statusBadgeLabel</span>
                                                    </div>
                                                    <div class="session-tutor text-truncate" title="@session.TutorName">@session.TutorName</div>
                                                    <div class="session-sub text-truncate">@session.SubjectName · @(session.ClassroomType == ClassroomType.OneToOne ? "1-1" : "Nhóm")</div>

                                                    @if (session.CanJoin && session.SessionId > 0 && !isCancelled)
                                                    {
                                                        <form asp-area="" asp-controller="ClassSession" asp-action="Join" method="post" class="mt-1">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@session.SessionId" />
                                                            <button type="submit" class="btn btn-danger-custom btn-sm w-100 py-0" style="font-size: 10px; line-height: 1.5;">
                                                                <i class="bi bi-camera-video me-1"></i>Vào lớp
                                                            </button>
                                                        </form>
                                                    }
                                                    else if (isCancelled)
                                                    {
                                                        <span class="badge text-bg-light border border-danger-subtle text-danger w-100 mt-1 py-1" style="font-size: 8px;">
                                                            <i class="bi bi-clock-history me-1"></i>Chờ gia sư xếp lịch bù
                                                        </span>
                                                    }
                                                    else if (isDone)
                                                    {
                                                        @if (session.HasReviewed)
                                                        {
                                                            <span class="badge text-bg-light border text-success w-100 mt-1 py-1" style="font-size: 8px;">
                                                                <i class="bi bi-check-circle me-1"></i>Đã đánh giá
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <a asp-area="Student_Parent" asp-controller="StudentClassroom" asp-action="Index"
                                                               class="btn btn-outline-danger btn-sm w-100 py-0 mt-1" style="font-size: 9px; line-height: 1.4;">
                                                                Đánh giá
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="schedule-slot-empty"></div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    (() => {
        // Mobile day picker
        const page = document.querySelector('.schedule-page');
        if (page) {
            page.querySelectorAll('[data-mobile-day]').forEach(button => {
                button.addEventListener('click', () => {
                    page.dataset.activeDay = button.dataset.mobileDay;
                    page.querySelectorAll('[data-mobile-day]').forEach(dayBtn => {
                        dayBtn.setAttribute('aria-pressed', String(dayBtn === button));
                    });
                });
            });
        }
    })();
</script>
