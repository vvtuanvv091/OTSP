@using static PROJECT_OTSP.Models.Enums
@model PROJECT_OTSP.Dtos.SearchPageVm
@{
    ViewData["Title"] = "Tìm gia sư & lớp học";
    var isClasses = Model.Tab == "classes";
}

@* Khác bản công khai ở đúng một chỗ: thẻ <section> có thêm 2 thuộc tính data-*-url.
   area = "" để luôn trỏ về controller công khai /Search/..., không bị dính /Student_Parent/. *@
<section id="searchRoot" class="container py-4" data-tab="@Model.Tab"
         data-tutors-url="@Url.Action("Tutors", "Search", new { area = "" })"
         data-classes-url="@Url.Action("Classes", "Search", new { area = "" })">
    <h1 class="otsp-title mb-3">Tìm gia sư &amp; lớp học</h1>

    <form id="searchForm" class="otsp-filter mb-3" role="search" novalidate>
        <div class="row g-2 g-md-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label small mb-1" for="keyword">Tên hoặc môn</label>
                <input id="keyword" name="keyword" type="search" class="form-control"
                       value="@Model.Query.Keyword" placeholder="Ví dụ: Minh Anh, Toán" autocomplete="off">
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="subjectId">Môn học</label>
                <select id="subjectId" name="subjectId" class="form-select" asp-items="Model.Subjects"></select>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="gradeLevelId">Cấp học</label>
                <select id="gradeLevelId" name="gradeLevelId" class="form-select" asp-items="Model.GradeLevels"></select>
            </div>

            <!-- Hình thức: chỉ hiện ở tab Gia sư -->
            <div class="col-6 col-md-3 col-xl-2 @(isClasses ? "d-none" : "")" id="formatBox">
                <label class="form-label small mb-1" for="format">Hình thức</label>
                <select id="format" name="format" class="form-select">
                    <option value="" selected="@(Model.Query.Format is null)">Tất cả</option>
                    <option value="Online" selected="@(Model.Query.Format == TeachingFormat.Online)">Trực tuyến</option>
                    <option value="Offline" selected="@(Model.Query.Format == TeachingFormat.Offline)">Trực tiếp</option>
                </select>
            </div>

            <!-- Loại lớp: chỉ hiện ở tab Lớp học -->
            <div class="col-6 col-md-3 col-xl-2 @(isClasses ? "" : "d-none")" id="classTypeBox">
                <label class="form-label small mb-1" for="classType">Loại lớp</label>
                <select id="classType" name="classType" class="form-select">
                    <option value="" selected="@(Model.Query.ClassType is null)">Tất cả</option>
                    <option value="OneToOne" selected="@(Model.Query.ClassType == ClassroomType.OneToOne)">1 kèm 1</option>
                    <option value="Group" selected="@(Model.Query.ClassType == ClassroomType.Group)">Nhóm</option>
                </select>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="maxFee">Học phí tối đa</label>
                <select id="maxFee" name="maxFee" class="form-select">
                    <option value="" selected="@(Model.Query.MaxFee is null)">Không giới hạn</option>
                    <option value="150000" selected="@(Model.Query.MaxFee == 150000)">≤ 150.000đ</option>
                    <option value="200000" selected="@(Model.Query.MaxFee == 200000)">≤ 200.000đ</option>
                    <option value="300000" selected="@(Model.Query.MaxFee == 300000)">≤ 300.000đ</option>
                    <option value="500000" selected="@(Model.Query.MaxFee == 500000)">≤ 500.000đ</option>
                </select>
            </div>

            <div class="col-12 col-xl-1 d-grid">
                <button type="submit" class="btn btn-otsp">Lọc</button>
            </div>
        </div>

        <div class="text-end mt-2">
            <button type="button" id="clearBtn" class="btn btn-sm btn-outline-otsp">Xóa lọc</button>
        </div>
    </form>

    <ul class="nav nav-underline border-bottom mb-3" role="tablist">
        <li class="nav-item">
            <button type="button" class="nav-link @(isClasses ? "" : "active")"
                    data-tab="tutors" role="tab">
                Gia sư
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(isClasses ? "active" : "")"
                    data-tab="classes" role="tab">
                Lớp học
            </button>
        </li>
    </ul>

    <div class="mb-3">
        <span id="resultCount" class="small text-body-secondary" aria-live="polite"></span>
    </div>

    <div id="loadingState" class="row g-3 d-none" aria-hidden="true">
        @for (var i = 0; i < 6; i++)
        {
            <div class="col-12 col-md-6 col-lg-4"><div class="otsp-skeleton"></div></div>
        }
    </div>

    <div id="grid" class="row g-3 g-md-4"></div>

    <div id="emptyState" class="text-center py-5 d-none">
        <i class="bi bi-search fs-1 text-body-secondary"></i>
        <p class="mt-2 mb-0">Không có kết quả phù hợp. Thử bỏ bớt bộ lọc.</p>
    </div>

    <div id="errorState" class="alert alert-danger d-none" role="alert">
        <span id="errorText">Không tải được dữ liệu, vui lòng thử lại.</span>
    </div>

    <nav id="pager" class="d-flex justify-content-center align-items-center gap-2 mt-4" aria-label="Phân trang"></nav>
</section>

@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
}
