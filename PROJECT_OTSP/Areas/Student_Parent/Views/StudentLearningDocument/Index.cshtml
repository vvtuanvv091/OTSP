@using static PROJECT_OTSP.Models.Enums
@using PROJECT_OTSP.Dtos.Student
@model IReadOnlyList<StudentLearningDocumentDto>

@{
    Layout = "_Layout_Student";
    ViewData["Title"] = "Tài liệu lớp học của tôi";
    var selectedClassroomId = ViewBag.SelectedClassroomId as int?;
    var myClassrooms = (ViewBag.MyClassrooms as List<StudentClassroomFilterOptionDto>) ?? new List<StudentClassroomFilterOptionDto>();
    var search = (ViewBag.Search as string) ?? "";
    var totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : Model.Count;
    var currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
}

<style>
    .docs-page-shell { max-width: 1100px; margin: 0 auto; }
    .doc-type-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .icon-pdf { background-color: #fee2e2; color: #dc2626; }
    .icon-word { background-color: #e0e7ff; color: #3730a3; }
    .icon-excel { background-color: #dcfce7; color: #166534; }
    .icon-ppt { background-color: #ffedd5; color: #c2410c; }
    .icon-file { background-color: #f1f5f9; color: #475569; }
</style>

<div class="docs-page-shell py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-body">Tài liệu lớp học của tôi</h1>
            <p class="text-secondary small mb-0">Kho tài liệu ôn tập, đề cương và bài giảng do gia sư chia sẻ riêng cho các lớp học bạn đang theo học.</p>
        </div>
        <div>
            <a asp-area="Student_Parent" asp-controller="StudentClassroom" asp-action="Index" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-easel me-1"></i> Lớp học của tôi
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="card border shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center justify-content-between gap-3 m-0">
                <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                    @if (myClassrooms.Count > 0)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 small text-secondary text-nowrap fw-semibold">Lọc theo lớp:</label>
                            <select name="classroomId" class="form-select form-select-sm" style="min-width: 220px;" onchange="this.form.submit()">
                                <option value="">-- Tất cả lớp của tôi --</option>
                                @foreach (var c in myClassrooms)
                                {
                                    var typeBadge = c.Type == ClassroomType.OneToOne ? "[1-1]" : "[Nhóm]";
                                    <option value="@c.Id" selected="@(selectedClassroomId == c.Id ? "selected" : null)">
                                        @typeBadge @c.Name (@c.SubjectName)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="input-group input-group-sm" style="max-width: 320px;">
                        <input type="text" name="search" class="form-control" placeholder="Tìm tên tài liệu, bài giảng..." value="@search" />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(search) || selectedClassroomId.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ps-1" title="Xóa lọc">
                            <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                        </a>
                    }
                </div>

                <div class="text-secondary small">
                    Tổng cộng: <strong class="text-dark">@totalItems</strong> tài liệu
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách Tài liệu Lớp học -->
    <div class="card border shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
            <h2 class="h6 fw-bold mb-0 text-dark">
                <i class="bi bi-folder2-open me-2 text-danger"></i>
                Danh sách tài liệu lớp học
                <span class="badge border border-secondary text-secondary ms-1 fw-normal">@totalItems tài liệu</span>
            </h2>
        </div>
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-folder-x fs-1 text-secondary d-block mb-2"></i>
                    <h5 class="fw-semibold text-dark">Chưa có tài liệu nào</h5>
                    <p class="small text-secondary mb-0">
                        @(selectedClassroomId.HasValue
                            ? "Lớp học này hiện chưa có tài liệu nào được gia sư tải lên."
                            : "Gia sư các lớp của bạn chưa tải tài liệu lên cho lớp học.")
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="min-width: 250px;">Tài liệu</th>
                                <th style="min-width: 140px;">Môn - Cấp học</th>
                                <th style="min-width: 180px;">Thuộc lớp học</th>
                                <th style="min-width: 150px;">Gia sư</th>
                                <th style="min-width: 110px;">Ngày tải</th>
                                <th style="min-width: 130px;" class="text-end pe-3">Tải về</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var idx = (currentPage - 1) * 8;
                            }
                            @foreach (var doc in Model)
                            {
                                idx++;
                                var ext = (doc.FileExtension ?? "").ToLowerInvariant();
                                var iconClass = ext switch
                                {
                                    ".pdf" => "bi-file-earmark-pdf icon-pdf",
                                    ".doc" or ".docx" => "bi-file-earmark-word icon-word",
                                    ".xls" or ".xlsx" => "bi-file-earmark-excel icon-excel",
                                    ".ppt" or ".pptx" => "bi-file-earmark-ppt icon-ppt",
                                    _ => "bi-file-earmark-text icon-file"
                                };

                                <tr>
                                    <td class="text-center text-muted small">@idx</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2.5">
                                            <div class="doc-type-icon @iconClass.Split(' ')[1]">
                                                <i class="bi @iconClass.Split(' ')[0]"></i>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="fw-semibold text-dark text-break">@doc.Title</div>
                                                @if (!string.IsNullOrWhiteSpace(doc.Description))
                                                {
                                                    <div class="text-muted small text-truncate" style="max-width: 280px; font-size: 0.82rem;">
                                                        @doc.Description
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-dark small">@doc.SubjectName · @doc.GradeLevelName</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            <span class="fw-medium text-dark small">@(doc.ClassroomName ?? "Lớp học")</span>
                                            @if (doc.ClassroomType == ClassroomType.OneToOne)
                                            {
                                                <span class="badge border border-info text-info bg-transparent" style="font-size: 0.7rem;">1-1</span>
                                            }
                                            else if (doc.ClassroomType == ClassroomType.Group)
                                            {
                                                <span class="badge border border-dark text-dark bg-transparent" style="font-size: 0.7rem;">Nhóm</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <div class="student-avatar-circle" style="width: 26px; height: 26px; font-size: 11px; border-radius: 50%; background: #e2e8f0; color: #334155; display: inline-flex; align-items: center; justify-content: center; font-weight: 600;">
                                                @(string.IsNullOrWhiteSpace(doc.TutorName) ? "G" : doc.TutorName.Trim().Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="text-dark small">@doc.TutorName</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary small text-nowrap">
                                        @doc.UploadedAt.AddHours(7).ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-outline-success btn-sm py-1 px-2.5 text-nowrap d-inline-flex align-items-center gap-1" title="Tải xuống tệp">
                                            <i class="bi bi-download"></i> Tải về
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Phân trang chuẩn ‹ Trước 1 2 ... Sau › -->
        @if (ViewBag.Pagination is PROJECT_OTSP.Dtos.PaginationVm pagination)
        {
            <div class="card-footer bg-white border-top py-3">
                @await Html.PartialAsync("_PaginationBar", pagination)
            </div>
        }
    </div>
</div>
