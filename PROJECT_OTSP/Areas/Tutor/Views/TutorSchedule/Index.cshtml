@using static PROJECT_OTSP.Models.Enums
@model PROJECT_OTSP.Dtos.TutorSchedulePageVm
@inject PROJECT_OTSP.Services.IScheduleBlockService BlockService

@{
    ViewData["Title"] = "Lịch dạy";
    var days = new[]
    {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
    var dayShortLabels = new Dictionary<DayOfWeek, string>
    {
        [DayOfWeek.Monday] = "T2",
        [DayOfWeek.Tuesday] = "T3",
        [DayOfWeek.Wednesday] = "T4",
        [DayOfWeek.Thursday] = "T5",
        [DayOfWeek.Friday] = "T6",
        [DayOfWeek.Saturday] = "T7",
        [DayOfWeek.Sunday] = "CN"
    };

    // Các hàng của bảng: mỗi khối 2 tiếng là 1 hàng, khoảng trống giữa 2 khối (nghỉ trưa) là 1 hàng mờ
    var blocks = BlockService.Blocks;
    var rows = new List<(int Start, int End, bool IsRest)>();
    for (var b = 0; b < blocks.Count; b++)
    {
        // if (b > 0 && blocks[b - 1].End < blocks[b].Start)
        //     rows.Add((blocks[b - 1].End, blocks[b].Start, true));
        rows.Add((blocks[b].Start, blocks[b].End, false));
    }

    Func<int, string> periodOf = startHour => startHour < 12 ? "Sáng" : startHour < 17 ? "Chiều" : "Tối";
    Func<int, int> spanFrom = index =>
    {
        var p = periodOf(rows[index].Start);
        var n = 0;
        for (var k = index; k < rows.Count && !rows[k].IsRest && periodOf(rows[k].Start) == p; k++) n++;
        return n;
    };
}

<style>
    .schedule-page {
        --availability-accent: var(--bs-danger, #DB303A);
        --availability-accent-text: #B7212B;
        --availability-accent-soft: #FDE8E8;
        --availability-accent-border: #FCA5A5;
        --availability-border: var(--bs-border-color, #E5E7EB);
        --availability-busy-bg: #374151;
        --availability-busy-border: #1F2937;
        --availability-busy-text: #FFFFFF;
    }

    .schedule-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--availability-border);
        border-radius: 8px;
    }

    .schedule-table-wrap {
        overflow-x: auto;
    }

    .schedule-table {
        width: 100%;
        min-width: 760px;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 3px 4px;
        font-size: 12px;
    }

        .schedule-table th {
            padding: 5px 3px;
            color: var(--bs-body-color);
            font-weight: 500;
            text-align: center;
            white-space: nowrap;
        }

            .schedule-table th.period-column {
                width: 44px;
            }

            .schedule-table th.time-column {
                width: 104px;
            }

        .schedule-table td {
            padding: 0 1px;
            text-align: center;
            vertical-align: middle;
        }

    .schedule-period-label {
        color: var(--availability-accent-text);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .schedule-time-label {
        color: var(--bs-secondary-color);
        font-size: 11px;
        white-space: nowrap;
    }

    .schedule-table th.day-column {
        background: var(--bs-tertiary-bg);
        border-radius: 4px;
    }

        .schedule-table th.day-column.is-today {
            background: var(--availability-accent-soft);
            color: var(--availability-accent-text);
            border: 1px solid var(--availability-accent-border);
        }

    .day-title {
        font-size: 12px;
        font-weight: 700;
        line-height: 1.2;
    }

    .day-date {
        font-size: 11px;
        color: var(--bs-secondary-color);
    }

    .is-today .day-date {
        color: var(--availability-accent-text);
        font-weight: 600;
    }

    .availability-slot {
        position: relative;
        display: flex;
        width: 100%;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--availability-border);
        border-radius: 4px;
        background: var(--bs-body-bg);
        font-size: 11px;
        line-height: 1;
        transition: all .15s ease-in-out;
    }

        .availability-slot.is-free {
            border-color: var(--availability-accent-border);
            background: var(--availability-accent-soft);
            color: var(--availability-accent-text);
            font-weight: 600;
            cursor: pointer;
        }

            .availability-slot.is-free:hover {
                filter: brightness(.95);
                transform: translateY(-1px);
                box-shadow: 0 2px 4px rgba(219, 48, 58, .15);
            }

        .availability-slot.is-empty {
            background: var(--bs-body-bg);
            border-color: var(--availability-border);
        }

        .availability-slot.is-rest {
            min-height: 24px;
            border-style: dashed;
            background: var(--bs-tertiary-bg);
            color: var(--bs-secondary-color);
            font-size: 10px;
        }

    .schedule-session-card {
        border: 1px solid var(--availability-border);
        border-left: 3px solid #DB303A;
        border-radius: 4px;
        padding: 4px 6px;
        background: var(--bs-body-bg);
        text-align: left;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .05);
    }

        .schedule-session-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, .1);
        }

        .schedule-session-card.status-inprogress {
            border-left-color: #0d6efd;
            background: rgba(13, 110, 253, .05);
        }

        .schedule-session-card.status-done {
            border-left-color: #6c757d;
            background: rgba(108, 117, 125, .05);
        }

        .schedule-session-card.status-scheduled {
            border-left-color: #198754;
            background: rgba(25, 135, 84, .05);
        }

        .schedule-session-card.status-cancelled {
            border-left-color: #dc3545;
            background: rgba(220, 53, 69, .05);
        }

        .schedule-session-card .session-time {
            font-size: 10px;
            font-weight: 700;
            line-height: 1;
        }

        .schedule-session-card .session-student {
            font-size: 11px;
            font-weight: 600;
            line-height: 1.2;
        }

        .schedule-session-card .session-subject {
            font-size: 10px;
            color: var(--bs-secondary-color);
            line-height: 1.2;
        }

    .availability-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        color: var(--bs-secondary-color);
        font-size: 12px;
        align-items: center;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .legend-swatch {
        width: 14px;
        height: 14px;
        border: 1px solid var(--availability-border);
        border-radius: 3px;
        background: var(--bs-body-bg);
    }

        .legend-swatch.is-free {
            border-color: var(--availability-accent-border);
            background: var(--availability-accent-soft);
        }

        .legend-swatch.is-busy {
            border-color: var(--availability-busy-border);
            background: var(--availability-busy-bg);
        }

    .card-highlight-pulse {
        animation: cardPulse 1.8s ease-in-out;
    }

    @@keyframes cardPulse {
        0% {
            outline: 3px solid rgba(219, 48, 58, .8);
            box-shadow: 0 0 16px rgba(219, 48, 58, .4);
        }

        50% {
            outline: 3px solid rgba(219, 48, 58, .4);
            box-shadow: 0 0 10px rgba(219, 48, 58, .2);
        }

        100% {
            outline: 3px solid transparent;
            box-shadow: none;
        }
    }

    .availability-mobile-day-picker {
        display: none;
    }

    .availability-day-button {
        border: 1px solid var(--availability-border);
        border-radius: var(--bs-border-radius);
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        padding: .45rem .6rem;
        font-size: .85rem;
    }

        .availability-day-button[aria-pressed="true"] {
            border-color: var(--availability-accent);
            background: var(--availability-accent);
            color: #fff;
        }

    @@media (max-width: 767.98px) {
        .availability-mobile-day-picker {
            display: flex;
            gap: .3rem;
            overflow-x: auto;
            padding: .1rem .1rem .5rem;
            scrollbar-width: thin;
        }

        .availability-day-button {
            flex: 1 0 auto;
            min-width: 2.35rem;
            padding: .4rem .35rem;
        }

        .schedule-table {
            min-width: 100%;
            border-spacing: 2px 4px;
            font-size: .72rem;
        }

            .schedule-table th.period-column {
                width: 2.45rem;
            }

            .schedule-table th.time-column {
                width: 5.6rem;
            }

            .schedule-table th[data-day-column],
            .schedule-table td[data-day-column] {
                display: none;
            }

        .schedule-page[data-active-day="1"] .schedule-table [data-day-column="1"],
        .schedule-page[data-active-day="2"] .schedule-table [data-day-column="2"],
        .schedule-page[data-active-day="3"] .schedule-table [data-day-column="3"],
        .schedule-page[data-active-day="4"] .schedule-table [data-day-column="4"],
        .schedule-page[data-active-day="5"] .schedule-table [data-day-column="5"],
        .schedule-page[data-active-day="6"] .schedule-table [data-day-column="6"],
        .schedule-page[data-active-day="0"] .schedule-table [data-day-column="0"] {
            display: table-cell;
        }

        .availability-slot {
            min-height: 2.4rem;
            font-size: .75rem;
        }
    }
</style>

<div class="container-fluid py-4 schedule-page" data-active-day="1">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1">Lịch dạy</h1>
            <p class="text-body-secondary mb-0">Thời khóa biểu giảng dạy theo giờ Việt Nam (GMT+7). Mỗi buổi học là một khối 2 tiếng. Yêu cầu chỉ xuất hiện tại đây sau khi gia sư chấp nhận.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createSessionModal">
                <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Tự tạo lịch học / Dạy bù
            </button>
            <a asp-area="Tutor" asp-controller="TutorAvailability" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-calendar-range me-1" aria-hidden="true"></i>Cài đặt lịch rảnh
            </a>
            <a asp-area="Tutor" asp-controller="TutorConnectionRequest" asp-action="Index" class="btn btn-outline-danger">
                <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Xem yêu cầu kết nối
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="status">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Weekly timetable -->
    <div class="schedule-card p-3 mb-4 shadow-sm">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" asp-route-weekOffset="@(Model.WeekOffset - 1)" class="btn btn-outline-secondary btn-sm" title="Tuần trước">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> Tuần trước
                </a>
                <a asp-action="Index" asp-route-weekOffset="0" class="btn @(Model.WeekOffset == 0 ? "btn-danger" : "btn-outline-danger") btn-sm">
                    Tuần này
                </a>
                <a asp-action="Index" asp-route-weekOffset="@(Model.WeekOffset + 1)" class="btn btn-outline-secondary btn-sm" title="Tuần sau">
                    Tuần sau <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </div>

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar-week text-danger fs-5" aria-hidden="true"></i>
                <span class="h6 mb-0 fw-bold">
                    @Model.SelectedMonday.ToString("dd/MM/yyyy") – @Model.SelectedSunday.ToString("dd/MM/yyyy")
                </span>
                @if (Model.WeekOffset != 0)
                {
                    <span class="badge bg-secondary-subtle text-secondary border">
                        @(Model.WeekOffset > 0 ? $"+{Model.WeekOffset} tuần" : $"{Model.WeekOffset} tuần")
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-1">
                    <label for="jumpDateInput" class="visually-hidden">Chọn ngày xem lịch</label>
                    <input id="jumpDateInput" type="date" name="jumpDate" class="form-control form-control-sm"
                           value="@Model.SelectedMonday.ToString("yyyy-MM-dd")" onchange="this.form.submit()" title="Chọn ngày xem lịch" />
                </form>
            </div>
        </div>

        <!-- Legend -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div class="availability-legend">
                <span class="legend-item"><span class="legend-swatch is-free" aria-hidden="true"></span>Rảnh - có thể nhận lớp</span>
                <span class="legend-item"><span class="legend-swatch is-busy" aria-hidden="true"></span>Đã có lớp / Buổi học</span>
                <span class="legend-item"><span class="legend-swatch" aria-hidden="true"></span>Không dạy</span>
            </div>
            <div class="small text-body-secondary">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>Nhấp vào buổi học để cuộn đến thẻ chi tiết bên dưới.
            </div>
        </div>

        <!-- Mobile day picker -->
        <div class="availability-mobile-day-picker mb-2" role="group" aria-label="Chọn ngày trong tuần">
            @for (var i = 0; i < 7; i++)
            {
                var dayDate = Model.SelectedMonday.AddDays(i);
                var isToday = dayDate == Model.TodayVn;
                var active = i == 0;
                <button type="button" class="availability-day-button"
                        data-mobile-day="@((int)dayDate.DayOfWeek)" aria-pressed="@(active ? "true" : "false")">
                    @dayShortLabels[dayDate.DayOfWeek] @dayDate.ToString("dd/MM") @(isToday ? "•" : "")
                </button>
            }
        </div>

        <!-- Table grid -->
        <div class="mobile-scroll-hint px-3 pt-2"><i class="bi bi-arrows-expand"></i> Vuốt ngang để xem đủ các ngày trong tuần</div>
        <div class="schedule-table-wrap">
            <table class="schedule-table mb-0" aria-label="Thời khóa biểu lịch dạy trong tuần">
                <thead>
                    <tr>
                        <th class="period-column" scope="col">Buổi</th>
                        <th class="time-column" scope="col">Khung giờ</th>
                        @for (var i = 0; i < 7; i++)
                        {
                            var dayDate = Model.SelectedMonday.AddDays(i);
                            var isToday = dayDate == Model.TodayVn;
                            var dayTitle = i switch
                            {
                                0 => "Thứ 2",
                                1 => "Thứ 3",
                                2 => "Thứ 4",
                                3 => "Thứ 5",
                                4 => "Thứ 6",
                                5 => "Thứ 7",
                                _ => "Chủ nhật"
                            };
                            <th scope="col" class="day-column @(isToday ? "is-today" : "")" data-day-column="@((int)dayDate.DayOfWeek)">
                                <div class="day-title">@dayTitle</div>
                                <div class="day-date">@dayDate.ToString("dd/MM")</div>
                                @if (isToday)
                                {
                                    <span class="badge rounded-pill text-bg-danger mt-1" style="font-size: 9px;">Hôm nay</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var r = 0; r < rows.Count; r++)
                    {
                        var row = rows[r];
                        var period = periodOf(row.Start);
                        var isFirstOfPeriod = !row.IsRest
                                              && (r == 0 || rows[r - 1].IsRest || periodOf(rows[r - 1].Start) != period);
                        <tr>
                            @if (row.IsRest)
                            {
                                <th class="schedule-period-label" scope="rowgroup"></th>
                            }
                            else if (isFirstOfPeriod)
                            {
                                <th class="schedule-period-label" scope="rowgroup" rowspan="@spanFrom(r)">@period</th>
                            }
                            <th class="schedule-time-label" scope="row">
                                @string.Format("{0:00}:00 - {1:00}:00", row.Start, row.End)
                            </th>
                            @for (var i = 0; i < 7; i++)
                            {
                                var dayDate = Model.SelectedMonday.AddDays(i);
                                var dayOfWeek = dayDate.DayOfWeek;

                                // Buổi học nằm trong khối nếu giờ bắt đầu (giờ VN) rơi vào [Start, End)
                                var sessions = Model.CalendarSessions
                                    .Where(s => s.Date == dayDate && s.Hour >= row.Start && s.Hour < row.End)
                                    .ToList();
                                var isFree = !row.IsRest && Model.Availabilities.Any(a => a.DayOfWeek == dayOfWeek
                                    && a.StartTime <= new TimeOnly(row.Start, 0)
                                    && a.EndTime >= new TimeOnly(row.End, 0));

                                <td data-day-column="@((int)dayOfWeek)">
                                    @if (sessions.Count > 0)
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var session in sessions)
                                            {
                                                var sessionStatusClass = session.Status switch
                                                {
                                                    SessionStatus.InProgress => "status-inprogress",
                                                    SessionStatus.Done => "status-done",
                                                    SessionStatus.Cancelled => "status-cancelled",
                                                    _ => "status-scheduled"
                                                };
                                                var sessionBadgeClass = session.Status switch
                                                {
                                                    SessionStatus.InProgress => "text-bg-primary",
                                                    SessionStatus.Done => "text-bg-success",
                                                    SessionStatus.Cancelled => "text-bg-danger",
                                                    _ => session.IsMakeup ? "text-bg-info text-white" : "text-bg-success"
                                                };
                                                var sessionBadgeLabel = session.Status switch
                                                {
                                                    SessionStatus.InProgress => "Đang diễn ra",
                                                    SessionStatus.Done => "Đã học",
                                                    SessionStatus.Cancelled => "Báo bận / Hủy",
                                                    _ => session.IsMakeup ? "Lịch dạy bù" : "Đã xác nhận"
                                                };
                                                <div class="schedule-session-card @sessionStatusClass"
                                                     data-schedule-target="@(session.RequestId.HasValue ? $"schedule-card-{session.RequestId.Value}" : "")"
                                                     title="@session.StudentName · @session.SubjectName (@session.ScheduledAtVn.ToString("HH:mm"))">
                                                    <div class="d-flex align-items-center justify-content-between gap-1">
                                                        <span class="session-time"><i class="bi bi-clock me-1"></i>@session.ScheduledAtVn.ToString("HH:mm")</span>
                                                        <span class="badge @sessionBadgeClass" style="font-size: 8px; padding: 2px 4px;">@sessionBadgeLabel</span>
                                                    </div>
                                                    <div class="session-student text-truncate" title="@session.StudentName">@session.StudentName</div>
                                                    <div class="session-subject text-truncate">@session.SubjectName · @(session.ClassroomType == ClassroomType.Group ? "Lớp nhóm" : "1-1")</div>
                                                    @if (session.SessionId > 0 && session.Status is SessionStatus.Scheduled or SessionStatus.InProgress)
                                                    {
                                                        <form asp-area="" asp-controller="ClassSession" asp-action="Join" method="post" class="mt-1" onclick="event.stopPropagation();">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@session.SessionId" />
                                                            <button type="submit" class="btn btn-success btn-sm w-100 py-0" style="font-size: 10px; line-height: 1.4;">
                                                                <i class="bi bi-camera-video me-1" aria-hidden="true"></i>@(session.Status == SessionStatus.InProgress ? "Vào lại" : "Vào lớp")
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (session.SessionId > 0 && session.Status == SessionStatus.Scheduled)
                                                    {
                                                        <button type="button" class="btn btn-outline-danger btn-sm w-100 py-0 mt-1 btn-cancel-session"
                                                                data-session-id="@session.SessionId"
                                                                data-student="@session.StudentName"
                                                                data-date="@session.ScheduledAtVn.ToString("dd/MM/yyyy HH:mm")"
                                                                onclick="event.stopPropagation();"
                                                                style="font-size: 10px; line-height: 1.4;">
                                                            <i class="bi bi-calendar-x me-1"></i>Báo bận
                                                        </button>
                                                    }
                                                    @if (session.Status == SessionStatus.Cancelled && session.ClassroomId > 0)
                                                    {
                                                        <button type="button" class="btn btn-outline-primary btn-sm w-100 py-0 mt-1 btn-quick-makeup"
                                                                data-classroom-id="@session.ClassroomId"
                                                                data-classroom-name="@session.ClassroomName"
                                                                onclick="event.stopPropagation();"
                                                                style="font-size: 10px; line-height: 1.4;">
                                                            <i class="bi bi-calendar-plus me-1"></i>Lên lịch bù
                                                        </button>
                                                    }
                                                    @if (session.SessionId > 0 && session.Status == SessionStatus.InProgress)
                                                    {
                                                        <form asp-area="" asp-controller="ClassSession" asp-action="End" method="post" class="mt-1" onclick="event.stopPropagation();" onsubmit="return confirm('Bạn có chắc muốn kết thúc buổi học này?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@session.SessionId" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-0" style="font-size: 10px; line-height: 1.4;">
                                                                <i class="bi bi-stop-circle me-1" aria-hidden="true"></i>Kết thúc
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (isFree)
                                    {
                                        <div class="availability-slot is-free"
                                             data-slot-date="@dayDate.ToString("yyyy-MM-dd")"
                                             data-slot-start="@row.Start"
                                             title="Khối rảnh (@dayDate.ToString("dd/MM/yyyy") @string.Format("{0:00}:00 - {1:00}:00", row.Start, row.End)). Bấm để điền vào form xác nhận lịch học bên dưới.">
                                            <span>Rảnh</span>
                                        </div>
                                    }
                                   
                                    else
                                    {
                                        <div class="availability-slot is-empty"></div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Request details -->
    <div class="mt-4 pt-2" id="teaching-requests-section">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
                <h2 class="h5 mb-1">
                    <i class="bi bi-person-lines-fill text-danger me-2" aria-hidden="true"></i>Chi tiết lịch dạy & yêu cầu kết nối
                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle fs-6 align-middle ms-2">@Model.Requests.Count</span>
                </h2>
                <p class="text-body-secondary small mb-0">Quản lý các buổi học thử, trạng thái phòng học trực tuyến và xếp lịch với học viên.</p>
            </div>
        </div>

        @if (Model.Requests.Count == 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body py-5 text-center">
                    <i class="bi bi-calendar-event fs-1 text-body-secondary" aria-hidden="true"></i>
                    <h3 class="h5 mt-3">Chưa có lịch dạy</h3>
                    <p class="text-body-secondary mb-0">Khi bạn chấp nhận yêu cầu kết nối, học viên sẽ xuất hiện tại đây để xác nhận lịch học thử.</p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.Requests)
                {
                    <article class="card border-0 shadow-sm" id="schedule-card-@item.RequestId">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                                <div>
                                    <h3 class="h5 mb-1">@item.StudentName</h3>
                                    <div class="text-body-secondary">@item.SubjectName · @item.GradeLevelName · @(item.PreferredType == ClassroomType.Group ? "Lớp nhóm" : "1 kèm 1")</div>
                                </div>
                                @if (item.IsOfficialRequest || item.IsOfficialEnrolled)
                                {
                                    @if (!item.HasPaid)
                                    {
                                        <span class="badge text-bg-warning"><i class="bi bi-hourglass-split me-1"></i>Chờ học viên thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success"><i class="bi bi-patch-check-fill me-1"></i>Đã thanh toán · Lớp chính thức</span>
                                    }
                                }
                                else if (item.TrialStatus == ScheduleStatus.Confirmed && item.TrialScheduledAt.HasValue)
                                {
                                    var sessionBadge = item.ClassSessionStatus switch
                                    {
                                        SessionStatus.InProgress => "text-bg-primary",
                                        SessionStatus.Done => "text-bg-success",
                                        SessionStatus.Cancelled => "text-bg-danger",
                                        _ => "text-bg-success"
                                    };
                                    var sessionLabel = item.ClassSessionStatus switch
                                    {
                                        SessionStatus.InProgress => "Đang diễn ra",
                                        SessionStatus.Done => "Đã học",
                                        SessionStatus.Cancelled => "Báo bận / Đã hủy",
                                        _ => "Đã xác nhận lịch học thử"
                                    };
                                    <span class="badge @sessionBadge" data-class-session-status="@item.ClassSessionId">@sessionLabel</span>
                                }
                                else if (item.TrialStatus == ScheduleStatus.Pending)
                                {
                                    <span class="badge text-bg-warning">Đang chờ xác nhận lịch</span>
                                }
                                else if (item.TrialStatus == ScheduleStatus.Rejected)
                                {
                                    <span class="badge text-bg-secondary">Lịch trước đó đã bị từ chối</span>
                                }
                            </div>

                            @if (item.IsOfficialRequest || item.IsOfficialEnrolled)
                            {
                                <div class="mt-3">
                                    <div class="p-3 border rounded-3 bg-light mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom flex-wrap gap-2">
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark">
                                                    <i class="bi bi-calendar3-range text-danger me-1"></i>Lịch học cố định hàng tuần (Lớp 1-1 chính thức)
                                                </h6>
                                                <small class="text-muted">Tiêu chuẩn: <strong>3 buổi/tuần = 6 tiếng/tuần</strong> (mỗi buổi 2 tiếng)</small>
                                            </div>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                Học phí: @((item.MonthlyFee > 0 ? item.MonthlyFee : item.HourlyFee * 24).ToString("N0")) đ / tháng
                                            </span>
                                        </div>

                                        <div class="row g-2">
                                            @if (item.WeeklyScheduleSummaries.Count > 0)
                                            {
                                                @for (int sIdx = 0; sIdx < item.WeeklyScheduleSummaries.Count; sIdx++)
                                                {
                                                    <div class="col-md-4">
                                                        <div class="card h-100 border-0 shadow-none bg-white p-2 border rounded-2">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="badge bg-danger text-white" style="font-size: 10px;">Buổi @(sIdx + 1)</span>
                                                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">2 tiếng</span>
                                                            </div>
                                                            <div class="fw-semibold small text-dark">@item.WeeklyScheduleSummaries[sIdx]</div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else if (item.ProposedTrialSlotsUtc.Count > 0)
                                            {
                                                @for (int sIdx = 0; sIdx < item.ProposedTrialSlotsUtc.Count; sIdx++)
                                                {
                                                    var pVn = item.ProposedTrialSlotsUtc[sIdx].AddHours(7);
                                                    <div class="col-md-4">
                                                        <div class="card h-100 border-0 shadow-none bg-white p-2 border rounded-2">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="badge bg-danger text-white" style="font-size: 10px;">Buổi @(sIdx + 1)</span>
                                                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">2 tiếng</span>
                                                            </div>
                                                            <div class="fw-semibold small text-dark">@pVn.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                                                            <div class="small text-muted">@pVn.ToString("HH:mm") - @pVn.AddHours(2).ToString("HH:mm")</div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    @if (!item.HasPaid)
                                    {
                                        <div class="p-3 rounded border border-warning-subtle d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: #FFFBEB !important;">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-hourglass-split text-warning fs-4"></i>
                                                <div>
                                                    <span class="fw-bold text-dark">Đang chờ học viên thanh toán học phí qua SePay VietQR</span>
                                                    <div class="small text-muted">
                                                        Học phí tháng: <strong class="text-danger">@item.MonthlyFee.ToString("N0") đ</strong> (3 buổi = 6 tiếng/tuần · 24 tiếng/tháng). Sau khi học viên thanh toán, hệ thống sẽ tự động kích hoạt phòng học trực tuyến.
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                @if (item.ClassroomId.HasValue)
                                                {
                                                    <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-eye me-1"></i>Xem lớp
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.StudentUserId))
                                                {
                                                    <a asp-area="" asp-controller="Chat" asp-action="Index" asp-route-contactId="@item.StudentUserId" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-chat-dots me-1"></i>Nhắn tin
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-3 rounded border border-success-subtle d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: #DCFCE7 !important;">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-patch-check-fill text-success fs-4"></i>
                                                <div>
                                                    <span class="fw-bold text-success">Đã nhận vào lớp chính thức: @(item.ClassroomName ?? "Lớp 1-1")</span>
                                                    <div class="small text-muted">Học viên đã hoàn tất thanh toán học phí. Lịch dạy 3 buổi/tuần (6 tiếng/tuần) đã sẵn sàng và đồng bộ vào Lịch dạy của gia sư.</div>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                @if (item.ClassroomId.HasValue)
                                                {
                                                    <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i>Xem lớp học
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.StudentUserId))
                                                {
                                                    <a asp-area="" asp-controller="Chat" asp-action="Index" asp-route-contactId="@item.StudentUserId" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-chat-dots me-1"></i>Nhắn tin
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (item.TrialStatus == ScheduleStatus.Confirmed && item.TrialScheduledAt.HasValue)
                            {
                                var trialVn = item.TrialScheduledAt.Value.AddHours(7);
                                var trialBlock = BlockService.Containing(trialVn.Hour);
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                                    <p class="mb-0"><i class="bi bi-calendar-check me-2" aria-hidden="true"></i>Lịch học thử: <strong>@trialVn.ToString("dd/MM/yyyy") @(trialBlock?.Label ?? trialVn.ToString("HH:mm")) (GMT+7)</strong></p>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (item.ClassSessionId.HasValue && item.ClassSessionStatus is SessionStatus.Scheduled or SessionStatus.InProgress)
                                        {
                                            <form asp-area="" asp-controller="ClassSession" asp-action="Join" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ClassSessionId.Value" />
                                                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-camera-video me-1" aria-hidden="true"></i>@(item.ClassSessionStatus == SessionStatus.InProgress ? "Tham gia lại" : "Tham gia lớp")</button>
                                            </form>
                                        }
                                        @if (item.ClassSessionId.HasValue && item.ClassSessionStatus == SessionStatus.Scheduled)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm btn-cancel-session"
                                                    data-session-id="@item.ClassSessionId.Value"
                                                    data-student="@item.StudentName"
                                                    data-date="@trialVn.ToString("dd/MM/yyyy HH:mm")">
                                                <i class="bi bi-calendar-x me-1"></i>Báo bận / Hủy buổi
                                            </button>
                                        }
                                        @if (item.ClassSessionId.HasValue && item.ClassSessionStatus == SessionStatus.InProgress)
                                        {
                                            <form asp-area="" asp-controller="ClassSession" asp-action="End" method="post" onsubmit="return confirm('Kết thúc buổi học cho tất cả mọi người?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ClassSessionId.Value" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-stop-circle me-1" aria-hidden="true"></i>Kết thúc buổi học</button>
                                            </form>
                                        }
                                        @if (item.ClassSessionId.HasValue && item.ClassSessionStatus == SessionStatus.Done)
                                        {
                                            <form asp-area="" asp-controller="ClassSession" asp-action="Reopen" method="post" onsubmit="return confirm('Mở lại buổi học để các thành viên có thể tham gia?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ClassSessionId.Value" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Mở lại buổi học</button>
                                            </form>
                                        }
                                    </div>
                                </div>

                                @if (item.ClassSessionStatus == SessionStatus.Cancelled)
                                {
                                    <div class="mt-3 p-3 bg-danger-subtle rounded border border-danger-subtle d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <div class="text-danger small">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Buổi học đã báo bận / hủy. Vui lòng sắp xếp lịch dạy bù cho học viên.
                                        </div>
                                        @if (item.ClassroomId.HasValue)
                                        {
                                            <button type="button" class="btn btn-danger btn-sm btn-quick-makeup"
                                                    data-classroom-id="@item.ClassroomId.Value"
                                                    data-classroom-name="@(item.ClassroomName ?? item.StudentName)">
                                                <i class="bi bi-calendar-plus me-1"></i>Lên lịch dạy bù ngay
                                            </button>
                                        }
                                    </div>
                                }

                                @if (item.IsOfficialEnrolled)
                                {
                                    <div class="mt-3 p-3 rounded border border-success-subtle d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: #DCFCE7 !important;">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-patch-check-fill text-success fs-5"></i>
                                            <div>
                                                <span class="fw-bold text-success">Đã nhận vào lớp chính thức: @(item.ClassroomName ?? "Lớp 1-1")</span>
                                                <div class="small text-muted">Lịch học định kỳ hàng tuần đã được kích hoạt và đồng bộ vào Lịch dạy của gia sư &amp; Lịch học của học viên.</div>
                                            </div>
                                        </div>
                                        @if (item.ClassroomId.HasValue)
                                        {
                                            <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>Xem lớp học
                                            </a>
                                        }
                                    </div>
                                }
                                else if (item.ClassSessionStatus == SessionStatus.Done || (item.TrialScheduledAt.HasValue && item.TrialScheduledAt.Value.AddHours(2) <= DateTime.UtcNow && item.ClassSessionStatus != SessionStatus.Cancelled))
                                {
                                    <div class="mt-3 p-3 bg-light-subtle rounded border border-success-subtle">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                            <span class="fw-bold text-success"><i class="bi bi-patch-check-fill me-1" aria-hidden="true"></i>Buổi học thử đã hoàn thành</span>
                                            <span class="small text-muted">Đánh giá và cấu hình lịch học chính thức (tối đa 3 buổi = 6 tiếng/tuần)</span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="collapse" data-bs-target="#promote-box-@item.RequestId">
                                                <i class="bi bi-mortarboard-fill me-1" aria-hidden="true"></i>Nhận vào lớp chính thức
                                            </button>
                                            <form asp-action="CloseTrialRequest" method="post" onsubmit="return confirm('Xác nhận không nhận học viên này vào lớp chính?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Không nhận học viên
                                                </button>
                                            </form>
                                        </div>

                                        <div class="collapse mt-3" id="promote-box-@item.RequestId">
                                            <form asp-action="PromoteToOfficialClassroom" method="post" class="card card-body border-0 shadow-sm">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                                <div class="mb-2">
                                                    @if (item.PreferredType == ClassroomType.OneToOne)
                                                    {
                                                        var trialVn = item.TrialScheduledAt?.AddHours(7);
                                                        var d1 = trialVn?.DayOfWeek ?? DayOfWeek.Monday;
                                                        var h1 = trialVn?.Hour ?? 19;
                                                        if (h1 < 8 || h1 > 19) h1 = 19;

                                                        var d2 = d1 switch
                                                        {
                                                            DayOfWeek.Monday => DayOfWeek.Wednesday,
                                                            DayOfWeek.Tuesday => DayOfWeek.Thursday,
                                                            DayOfWeek.Wednesday => DayOfWeek.Friday,
                                                            _ => DayOfWeek.Wednesday
                                                        };
                                                        var d3 = d1 switch
                                                        {
                                                            DayOfWeek.Monday => DayOfWeek.Friday,
                                                            DayOfWeek.Tuesday => DayOfWeek.Saturday,
                                                            DayOfWeek.Wednesday => DayOfWeek.Sunday,
                                                            _ => DayOfWeek.Friday
                                                        };

                                                        <div class="p-3 border rounded-3 bg-light mb-3">
                                                            <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom flex-wrap gap-2">
                                                                <div>
                                                                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar3-range text-danger me-1"></i>Xếp lịch học cố định hàng tuần (Lớp 1-1 chính thức)</h6>
                                                                    <small class="text-muted">Chọn các buổi học định kỳ trong tuần cho học viên. Tiêu chuẩn <strong>3 buổi/tuần = 6 tiếng/tuần</strong> (mỗi buổi 2 tiếng).</small>
                                                                </div>
                                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                                    Đơn giá: @item.HourlyFee.ToString("N0") đ/giờ
                                                                </span>
                                                            </div>

                                                            <!-- 3 Cards chọn buổi 1, buổi 2, buổi 3 -->
                                                            <div class="row g-2 mb-3">
                                                                <!-- Buổi 1 (Bắt buộc) -->
                                                                <div class="col-md-4">
                                                                    <div class="card h-100 border-primary-subtle shadow-none">
                                                                        <div class="card-header bg-primary-subtle text-primary py-1 px-2 fw-semibold small d-flex justify-content-between align-items-center">
                                                                            <span><i class="bi bi-1-circle-fill me-1"></i>Buổi 1 (Bắt buộc)</span>
                                                                            <span class="badge bg-primary text-white" style="font-size: 10px;">2 tiếng</span>
                                                                        </div>
                                                                        <div class="card-body p-2">
                                                                            <label class="form-label small mb-1 fw-semibold">Thứ trong tuần:</label>
                                                                            <select name="scheduleDays" class="form-select form-select-sm mb-2" required>
                                                                                <option value="Monday" selected="@(d1 == DayOfWeek.Monday)">Thứ Hai</option>
                                                                                <option value="Tuesday" selected="@(d1 == DayOfWeek.Tuesday)">Thứ Ba</option>
                                                                                <option value="Wednesday" selected="@(d1 == DayOfWeek.Wednesday)">Thứ Tư</option>
                                                                                <option value="Thursday" selected="@(d1 == DayOfWeek.Thursday)">Thứ Năm</option>
                                                                                <option value="Friday" selected="@(d1 == DayOfWeek.Friday)">Thứ Sáu</option>
                                                                                <option value="Saturday" selected="@(d1 == DayOfWeek.Saturday)">Thứ Bảy</option>
                                                                                <option value="Sunday" selected="@(d1 == DayOfWeek.Sunday)">Chủ Nhật</option>
                                                                            </select>

                                                                            <label class="form-label small mb-1 fw-semibold">Khung giờ học:</label>
                                                                            <select name="scheduleStartHours" class="form-select form-select-sm promote-hour-select" data-fee="@item.HourlyFee" data-req="@item.RequestId" required>
                                                                                <option value="8" selected="@(h1 == 8)">08:00 - 10:00 (Sáng)</option>
                                                                                <option value="10" selected="@(h1 == 10)">10:00 - 12:00 (Sáng)</option>
                                                                                <option value="13" selected="@(h1 == 13)">13:00 - 15:00 (Chiều)</option>
                                                                                <option value="15" selected="@(h1 == 15)">15:00 - 17:00 (Chiều)</option>
                                                                                <option value="17" selected="@(h1 == 17)">17:00 - 19:00 (Tối)</option>
                                                                                <option value="19" selected="@(h1 == 19 || (h1 != 8 && h1 != 10 && h1 != 13 && h1 != 15 && h1 != 17))">19:00 - 21:00 (Tối)</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Buổi 2 -->
                                                                <div class="col-md-4">
                                                                    <div class="card h-100 border-info-subtle shadow-none">
                                                                        <div class="card-header bg-info-subtle text-info-emphasis py-1 px-2 fw-semibold small d-flex justify-content-between align-items-center">
                                                                            <span><i class="bi bi-2-circle-fill me-1"></i>Buổi 2</span>
                                                                            <span class="badge bg-info text-white" style="font-size: 10px;">2 tiếng</span>
                                                                        </div>
                                                                        <div class="card-body p-2">
                                                                            <label class="form-label small mb-1 fw-semibold">Thứ trong tuần:</label>
                                                                            <select name="scheduleDays" class="form-select form-select-sm mb-2">
                                                                                <option value="Monday" selected="@(d2 == DayOfWeek.Monday)">Thứ Hai</option>
                                                                                <option value="Tuesday" selected="@(d2 == DayOfWeek.Tuesday)">Thứ Ba</option>
                                                                                <option value="Wednesday" selected="@(d2 == DayOfWeek.Wednesday)">Thứ Tư</option>
                                                                                <option value="Thursday" selected="@(d2 == DayOfWeek.Thursday)">Thứ Năm</option>
                                                                                <option value="Friday" selected="@(d2 == DayOfWeek.Friday)">Thứ Sáu</option>
                                                                                <option value="Saturday" selected="@(d2 == DayOfWeek.Saturday)">Thứ Bảy</option>
                                                                                <option value="Sunday" selected="@(d2 == DayOfWeek.Sunday)">Chủ Nhật</option>
                                                                            </select>

                                                                            <label class="form-label small mb-1 fw-semibold">Khung giờ học:</label>
                                                                            <select name="scheduleStartHours" class="form-select form-select-sm promote-hour-select" data-fee="@item.HourlyFee" data-req="@item.RequestId">
                                                                                <option value="-1">-- Không chọn buổi này --</option>
                                                                                <option value="8">08:00 - 10:00 (Sáng)</option>
                                                                                <option value="10">10:00 - 12:00 (Sáng)</option>
                                                                                <option value="13">13:00 - 15:00 (Chiều)</option>
                                                                                <option value="15">15:00 - 17:00 (Chiều)</option>
                                                                                <option value="17">17:00 - 19:00 (Tối)</option>
                                                                                <option value="19" selected>19:00 - 21:00 (Tối)</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Buổi 3 -->
                                                                <div class="col-md-4">
                                                                    <div class="card h-100 border-success-subtle shadow-none">
                                                                        <div class="card-header py-1 px-2 fw-semibold small d-flex justify-content-between align-items-center" style="background-color: #DCFCE7 !important; color: #14532D !important; border-bottom: 1px solid #86EFAC !important;">
                                                                            <span style="color: #14532D !important;"><i class="bi bi-3-circle-fill me-1"></i>Buổi 3 (Đủ 6h/tuần)</span>
                                                                            <span class="badge text-white" style="background-color: #166534 !important; font-size: 10px;">2 tiếng</span>
                                                                        </div>
                                                                        <div class="card-body p-2">
                                                                            <label class="form-label small mb-1 fw-semibold">Thứ trong tuần:</label>
                                                                            <select name="scheduleDays" class="form-select form-select-sm mb-2">
                                                                                <option value="Monday" selected="@(d3 == DayOfWeek.Monday)">Thứ Hai</option>
                                                                                <option value="Tuesday" selected="@(d3 == DayOfWeek.Tuesday)">Thứ Ba</option>
                                                                                <option value="Wednesday" selected="@(d3 == DayOfWeek.Wednesday)">Thứ Tư</option>
                                                                                <option value="Thursday" selected="@(d3 == DayOfWeek.Thursday)">Thứ Năm</option>
                                                                                <option value="Friday" selected="@(d3 == DayOfWeek.Friday)">Thứ Sáu</option>
                                                                                <option value="Saturday" selected="@(d3 == DayOfWeek.Saturday)">Thứ Bảy</option>
                                                                                <option value="Sunday" selected="@(d3 == DayOfWeek.Sunday)">Chủ Nhật</option>
                                                                            </select>

                                                                            <label class="form-label small mb-1 fw-semibold">Khung giờ học:</label>
                                                                            <select name="scheduleStartHours" class="form-select form-select-sm promote-hour-select" data-fee="@item.HourlyFee" data-req="@item.RequestId">
                                                                                <option value="-1">-- Không chọn buổi này --</option>
                                                                                <option value="8">08:00 - 10:00 (Sáng)</option>
                                                                                <option value="10">10:00 - 12:00 (Sáng)</option>
                                                                                <option value="13">13:00 - 15:00 (Chiều)</option>
                                                                                <option value="15">15:00 - 17:00 (Chiều)</option>
                                                                                <option value="17">17:00 - 19:00 (Tối)</option>
                                                                                <option value="19" selected>19:00 - 21:00 (Tối)</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Tóm tắt học phí & chính sách SePay 20% hoa hồng -->
                                                            <div class="alert alert-info py-2 px-3 small mb-0 d-flex flex-column gap-1">
                                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                                    <div>
                                                                        <strong><i class="bi bi-cash-stack me-1"></i>Dự tính học phí tháng (4 tuần):</strong>
                                                                        <span class="text-danger fw-bold ms-1" id="promote-fee-preview-@item.RequestId">
                                                                            @((item.HourlyFee * 2 * 3 * 4).ToString("N0")) đ / tháng
                                                                        </span>
                                                                        <span class="text-muted ms-1" id="promote-hours-preview-@item.RequestId">(3 buổi = 6 tiếng/tuần · 24 tiếng/tháng)</span>
                                                                    </div>
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                                        <i class="bi bi-shield-check me-1"></i>SePay VietQR Admin · Hoa hồng 20%
                                                                    </span>
                                                                </div>
                                                                <div class="text-muted" style="font-size: 11px;">
                                                                    Hệ thống tự động cấu hình lịch 4 tuần vào Lịch học của học viên &amp; Lịch dạy của gia sư, đồng thời tạo mã thanh toán VietQR gửi học viên. Admin nhận tiền qua SePay và đối soát chi trả 80% cho gia sư theo chu kỳ hàng tháng.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <label class="form-label small fw-semibold" for="target-class-@item.RequestId">Xác nhận lớp nhóm nhận học viên:</label>
                                                        <select id="target-class-@item.RequestId" name="targetClassroomId" class="form-select form-select-sm mb-2" required>
                                                            @if (item.ClassroomId.HasValue)
                                                            {
                                                                <option value="@item.ClassroomId.Value" selected>@item.ClassroomName (Lớp học viên đã chọn)</option>
                                                            }
                                                            @if (ViewBag.OpenGroupClasses != null)
                                                            {
                                                                foreach (var gc in (IEnumerable<dynamic>)ViewBag.OpenGroupClasses)
                                                                {
                                                                    if (!item.ClassroomId.HasValue || gc.Id != item.ClassroomId.Value)
                                                                    {
                                                                        <option value="@gc.Id">@gc.Name (@gc.CurrentCount/@gc.MaxStudents học viên)</option>
                                                                    }
                                                                }
                                                            }
                                                        </select>
                                                    }
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-sm align-self-start">
                                                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Xác nhận vào lớp chính &amp; đồng bộ lịch
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                @if (item.ProposedTrialSlotsUtc.Count > 0)
                                {
                                    <div class="alert alert-warning py-2 px-3 small mt-2">
                                        <div class="fw-bold mb-1">
                                            <i class="bi bi-calendar-check text-warning me-1" aria-hidden="true"></i>
                                            Học viên đề xuất lịch học (@(item.ProposedTrialSlotsUtc.Count * 2) tiếng/tuần):
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            @for (int sIdx = 0; sIdx < item.ProposedTrialSlotsUtc.Count; sIdx++)
                                            {
                                                var pVn = item.ProposedTrialSlotsUtc[sIdx].AddHours(7);
                                                <div class="d-flex align-items-center justify-content-between gap-2 p-1 bg-white rounded border">
                                                    <div>
                                                        <span class="badge bg-danger me-1">Buổi @(sIdx + 1)</span>
                                                        <strong>@pVn.ToString("dddd, dd/MM/yyyy · HH:mm", new System.Globalization.CultureInfo("vi-VN"))</strong> (2 tiếng)
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-outline-dark py-0 px-2 btn-apply-proposed"
                                                            data-date="@pVn.ToString("yyyy-MM-dd")"
                                                            data-hour="@pVn.Hour"
                                                            data-form="trial-form-@item.RequestId">
                                                        Điền giờ này
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (item.ProposedTrialSlotUtc.HasValue)
                                {
                                    var propVn = item.ProposedTrialSlotUtc.Value.AddHours(7);
                                    <div class="alert alert-warning py-2 px-3 small d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
                                        <div>
                                            <i class="bi bi-lightning-charge-fill text-warning me-1" aria-hidden="true"></i>
                                            Học viên đề xuất: <strong>@propVn.ToString("dddd, dd/MM/yyyy · HH:mm", new System.Globalization.CultureInfo("vi-VN")) (GMT+7)</strong>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-dark py-0 px-2 btn-apply-proposed"
                                                data-date="@propVn.ToString("yyyy-MM-dd")"
                                                data-hour="@propVn.Hour"
                                                data-form="trial-form-@item.RequestId">
                                            Sử dụng giờ này
                                        </button>
                                    </div>
                                }

                                <form id="trial-form-@item.RequestId" asp-action="ConfirmTrialSchedule" method="post" class="row g-2 align-items-end mt-2 trial-schedule-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@item.RequestId" />
                                    <input type="hidden" name="scheduledAtUtc" />
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="trial-date-@item.RequestId">Ngày học</label>
                                        <input id="trial-date-@item.RequestId" type="date" class="form-control trial-date" required />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="trial-block-@item.RequestId">Khối giờ (2 tiếng)</label>
                                        <select id="trial-block-@item.RequestId" class="form-select trial-block" required>
                                            <option value="">Chọn khối giờ</option>
                                            @foreach (var b in blocks)
                                            {
                                                <option value="@b.Start">@b.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-auto">
                                        <button type="submit" class="btn btn-success">Xác nhận lịch học thử</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

<script>
    (() => {
        // Mobile day picker
        const page = document.querySelector('.schedule-page');
        if (page) {
            page.querySelectorAll('[data-mobile-day]').forEach(button => {
                button.addEventListener('click', () => {
                    page.dataset.activeDay = button.dataset.mobileDay;
                    page.querySelectorAll('[data-mobile-day]').forEach(dayBtn => {
                        dayBtn.setAttribute('aria-pressed', String(dayBtn === button));
                    });
                });
            });
        }

        const pulse = el => {
            el.classList.remove('card-highlight-pulse');
            void el.offsetWidth;
            el.classList.add('card-highlight-pulse');
        };

        // Bấm vào buổi học trên lịch: cuộn tới thẻ chi tiết bên dưới
        document.querySelectorAll('.schedule-session-card[data-schedule-target]').forEach(card => {
            card.addEventListener('click', () => {
                const targetId = card.dataset.scheduleTarget;
                if (!targetId) return;
                const targetEl = document.getElementById(targetId);
                if (targetEl) {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    pulse(targetEl);
                }
            });
        });

        // Bấm vào khối "Rảnh": điền ngày + khối giờ vào form đang chờ xác nhận
        document.querySelectorAll('.availability-slot.is-free[data-slot-date]').forEach(slot => {
            slot.addEventListener('click', () => {
                const form = document.querySelector('.trial-schedule-form');
                if (!form) return;

                form.querySelector('.trial-date').value = slot.dataset.slotDate;
                form.querySelector('.trial-block').value = slot.dataset.slotStart;

                const formCard = form.closest('article.card');
                if (formCard) {
                    formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    pulse(formCard);
                }
                form.querySelector('.trial-date').focus();
            });
        });

        // Ghép ngày + khối giờ (theo giờ Việt Nam GMT+7) thành thời điểm UTC khi gửi
        document.querySelectorAll('.trial-schedule-form').forEach(form => {
            const dateInput = form.querySelector('.trial-date');
            const blockSelect = form.querySelector('.trial-block');
            const utcInput = form.querySelector('input[name="scheduledAtUtc"]');
            if (!dateInput || !blockSelect || !utcInput) return;

            const today = new Date();
            dateInput.min = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

            form.addEventListener('submit', event => {
                const hour = String(blockSelect.value).padStart(2, '0');
                const selected = new Date(`${dateInput.value}T${hour}:00:00+07:00`);

                if (!dateInput.value || !blockSelect.value || Number.isNaN(selected.getTime()) || selected <= new Date()) {
                    event.preventDefault();
                    dateInput.setCustomValidity('Vui lòng chọn ngày và khối giờ trong tương lai.');
                    dateInput.reportValidity();
                    dateInput.setCustomValidity('');
                    return;
                }
                utcInput.value = selected.toISOString();
            });
        });

        // Áp dụng giờ đề xuất của học viên vào form
        document.querySelectorAll('.btn-apply-proposed').forEach(btn => {
            btn.addEventListener('click', () => {
                const formId = btn.dataset.form;
                const form = document.getElementById(formId);
                if (!form) return;
                const dateInput = form.querySelector('.trial-date');
                const blockSelect = form.querySelector('.trial-block');
                if (dateInput && btn.dataset.date) dateInput.value = btn.dataset.date;
                if (blockSelect && btn.dataset.hour) blockSelect.value = btn.dataset.hour;
                pulse(form);
            });
        });

        // ── Xử lý Modal Tự tạo lịch học / Dạy bù ──
        const createSessionForm = document.getElementById('createSessionForm');
        if (createSessionForm) {
            const createDate = document.getElementById('createSessionDate');
            const createBlock = document.getElementById('createSessionBlock');
            const createUtc = document.getElementById('createSessionScheduledAtUtc');

            const today = new Date();
            if (createDate) {
                createDate.min = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
            }

            createSessionForm.addEventListener('submit', event => {
                if (!createDate || !createBlock || !createUtc) return;
                const hour = String(createBlock.value).padStart(2, '0');
                const selected = new Date(`${createDate.value}T${hour}:00:00+07:00`);

                if (!createDate.value || !createBlock.value || Number.isNaN(selected.getTime()) || selected <= new Date()) {
                    event.preventDefault();
                    createDate.setCustomValidity('Vui lòng chọn ngày và khối giờ trong tương lai.');
                    createDate.reportValidity();
                    createDate.setCustomValidity('');
                    return;
                }
                createUtc.value = selected.toISOString();
            });
        }

        // ── Xử lý bấm nút "Báo bận" ──
        document.querySelectorAll('.btn-cancel-session').forEach(btn => {
            btn.addEventListener('click', () => {
                const modalEl = document.getElementById('cancelSessionModal');
                if (!modalEl) return;
                const sessionIdInput = document.getElementById('cancelSessionId');
                const studentNameSpan = document.getElementById('cancelStudentName');
                const sessionDateSpan = document.getElementById('cancelSessionDate');

                if (sessionIdInput) sessionIdInput.value = btn.dataset.sessionId || '';
                if (studentNameSpan) studentNameSpan.textContent = btn.dataset.student || '';
                if (sessionDateSpan) sessionDateSpan.textContent = btn.dataset.date || '';

                if (window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        });

        // ── Xử lý bấm nút "Lên lịch bù" ──
        document.querySelectorAll('.btn-quick-makeup').forEach(btn => {
            btn.addEventListener('click', () => {
                const modalEl = document.getElementById('createSessionModal');
                if (!modalEl) return;
                const classSelect = document.getElementById('createClassroomId');
                const makeupRadio = document.getElementById('sessionTypeMakeup');
                const noteInput = document.getElementById('createSessionNote');

                if (classSelect && btn.dataset.classroomId) classSelect.value = btn.dataset.classroomId;
                if (makeupRadio) makeupRadio.checked = true;
                if (noteInput) noteInput.value = `Dạy bù cho lớp ${btn.dataset.classroomName || ''}`;

                if (window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        });

        @if (TempData["PromptMakeupClassroomId"] is int makeupClassId)
        {
            <text>
            setTimeout(() => {
                const classSelect = document.getElementById('createClassroomId');
                if (classSelect) classSelect.value = '@makeupClassId';
                const makeupRadio = document.getElementById('sessionTypeMakeup');
                if (makeupRadio) makeupRadio.checked = true;
                const noteInput = document.getElementById('createSessionNote');
                if (noteInput) noteInput.value = 'Dạy bù cho buổi học vừa báo bận';
                const modalEl = document.getElementById('createSessionModal');
                if (modalEl && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            }, 300);
            </text>
        }
    })();
</script>

<!-- ==================== MODAL TỰ TẠO LỊCH HỌC / DẠY BÙ ==================== -->
<div class="modal fade" id="createSessionModal" tabindex="-1" aria-labelledby="createSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CreateSession" method="post" id="createSessionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduledAtUtc" id="createSessionScheduledAtUtc" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title h6 fw-bold" id="createSessionModalLabel">
                        <i class="bi bi-calendar-plus-fill text-danger me-2"></i>Tự tạo lịch học / Lên lịch dạy bù
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="createClassroomId">
                            Lớp học / Học viên <span class="text-danger">*</span>
                        </label>
                        <select name="classroomId" id="createClassroomId" class="form-select form-select-sm" required>
                            <option value="">-- Chọn lớp học --</option>
                            @if (ViewBag.ActiveClassrooms != null)
                            {
                                foreach (var cls in (IEnumerable<dynamic>)ViewBag.ActiveClassrooms)
                                {
                                    var typeLabel = cls.Type == ClassroomType.OneToOne ? "1 kèm 1" : "Lớp nhóm";
                                    var studentDesc = !string.IsNullOrWhiteSpace(cls.StudentNames) ? $" · HV: {cls.StudentNames}" : "";
                                    <option value="@cls.Id">
                                        [@typeLabel] @cls.Name (@cls.SubjectName - @cls.GradeLevelName)@studentDesc
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mục đích buổi học</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="isMakeup" id="sessionTypeRegular" value="false" checked />
                                <label class="form-check-label small" for="sessionTypeRegular">
                                    <i class="bi bi-calendar-check text-success me-1"></i>Buổi học thường
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="isMakeup" id="sessionTypeMakeup" value="true" />
                                <label class="form-check-label small" for="sessionTypeMakeup">
                                    <i class="bi bi-arrow-repeat text-danger me-1"></i>Buổi dạy bù (Bận dạy bù)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label small fw-semibold" for="createSessionDate">
                                Ngày học <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="createSessionDate" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-semibold" for="createSessionBlock">
                                Khối giờ (2 tiếng) <span class="text-danger">*</span>
                            </label>
                            <select id="createSessionBlock" class="form-select form-select-sm" required>
                                <option value="">-- Chọn khối giờ --</option>
                                @foreach (var b in blocks)
                                {
                                    <option value="@b.Start">@b.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="createSessionNote">Ghi chú / Lý do (tùy chọn)</label>
                        <input type="text" name="note" id="createSessionNote" class="form-control form-control-sm"
                               placeholder="Ví dụ: Dạy bù cho buổi ngày 22/10 do gia sư bận việc đột xuất" />
                    </div>

                    <div class="alert alert-light border small text-muted p-2 mb-0">
                        <i class="bi bi-info-circle text-primary me-1"></i> Buổi học sẽ kéo dài <strong>đúng 2 tiếng</strong> và tự động đồng bộ vào Lịch học của học viên và Lịch dạy của gia sư.
                    </div>
                </div>
                <div class="modal-footer border-top p-2 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-check-circle me-1"></i>Tạo lịch học ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== MODAL BÁO BẬN / HỦY BUỔI HỌC ==================== -->
<div class="modal fade" id="cancelSessionModal" tabindex="-1" aria-labelledby="cancelSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CancelSession" method="post" id="cancelSessionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="sessionId" id="cancelSessionId" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title h6 fw-bold text-danger" id="cancelSessionModalLabel">
                        <i class="bi bi-calendar-x-fill text-danger me-2"></i>Báo bận / Hủy buổi học
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-dark mb-2">
                        Bạn đang báo bận buổi học của học viên <strong id="cancelStudentName"></strong> vào ngày <strong id="cancelSessionDate"></strong>.
                    </p>
                    <div class="alert alert-warning small p-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Buổi học sẽ chuyển sang trạng thái <strong>Báo bận / Đã hủy</strong>. Sau đó bạn hãy lên lịch dạy bù cho học viên để đảm bảo tiến độ.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="cancelReason">Lý do báo bận (thông báo tới học viên):</label>
                        <input type="text" name="reason" id="cancelReason" class="form-control form-control-sm"
                               placeholder="Ví dụ: Gia sư có việc gia đình đột xuất xin phép dời lịch" required />
                    </div>
                </div>
                <div class="modal-footer border-top p-2 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Xác nhận báo bận
                    </button>
                </div>
