@model IReadOnlyList<PROJECT_OTSP.Dtos.TutorLearningDocumentDto>

@{
    var teachingPairs = ViewBag.TeachingPairs as IReadOnlyList<PROJECT_OTSP.Dtos.TutorSubjectDto>
        ?? Array.Empty<PROJECT_OTSP.Dtos.TutorSubjectDto>();
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
    ViewData["Title"] = "Tài liệu ôn tập";
}
<style>
    .h1_left_le.mb-1 {
        margin-bottom: .25rem !important;
        margin-left: 20px;
    }

    .textleft_le.text-body-secondary {
        margin-left: 20px;
    }

</style>
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 h1_left_le">Tài liệu ôn tập</h1>
            <p class="textleft_le text-body-secondary mb-0">Quản lý tài liệu theo môn học và cấp học bạn đang dạy.</p>
        </div>
        <span class="badge text-bg-success rounded-pill px-3 py-2">@totalItems tài liệu</span>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (teachingPairs.Count == 0)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span>Thêm cặp môn học và cấp học trước để phân loại tài liệu.</span>
            <a asp-area="Tutor" asp-controller="TutorSubject" asp-action="Index" class="btn btn-success btn-sm">Quản lý môn và cấp học</a>
        </div>
    }
    else
    {
        <section class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Tải tài liệu lên</h2>
                <form asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3">
                    <div class="col-12 col-lg-4">
                        <label for="title" class="form-label">Tên tài liệu</label>
                        <input id="title" name="title" class="form-control" maxlength="255" required />
                    </div>
                    <div class="col-12 col-lg-4">
                        <label for="tutorSubjectId" class="form-label">Môn và cấp học</label>
                        <select id="tutorSubjectId" name="tutorSubjectId" class="form-select" required>
                            @foreach (var pair in teachingPairs)
                            {
                                <option value="@pair.Id">@pair.SubjectName · @pair.GradeLevelName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-lg-4">
                        <label for="file" class="form-label">Tệp (PDF, Word, PowerPoint, Excel; tối đa 20 MB)</label>
                        <input id="file" name="file" type="file" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx" required />
                    </div>
                    <div class="col-12">
                        <label for="description" class="form-label">Mô tả <span class="text-body-secondary fw-normal">(không bắt buộc)</span></label>
                        <textarea id="description" name="description" class="form-control" rows="2" maxlength="2000"></textarea>
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-success"><i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i>Tải lên</button>
                    </div>
                </form>
            </div>
        </section>
    }

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Tài liệu đã tải lên</h2>
            @if (Model.Count == 0)
            {
                <div class="text-center text-body-secondary py-4">
                    <i class="bi bi-folder2-open fs-2 d-block mb-2" aria-hidden="true"></i>
                    Chưa có tài liệu nào.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var document in Model)
                    {
                        <article class="border rounded-3 p-3">
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="h6 mb-1 text-break">@document.Title</h3>
                                    <div class="small text-body-secondary">@document.SubjectName · @document.GradeLevelName · Tải lên @document.UploadedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") (GMT+7)</div>
                                    @if (!string.IsNullOrWhiteSpace(document.Description))
                                    {
                                        <p class="mb-0 mt-2 text-body-secondary text-break">@document.Description</p>
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                    <a asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Download" asp-route-id="@document.Id" class="btn btn-outline-success btn-sm">Tải xuống</a>
                                    <form asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Delete" asp-route-id="@document.Id" method="post">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-4" aria-label="Phân trang tài liệu">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Trước</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li>
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </section>
</div>
