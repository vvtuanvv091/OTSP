@{
    Layout = "_Layout";

    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var areaName = ViewContext.RouteData.Values["area"]?.ToString();
    bool inTutorArea = string.Equals(areaName, "Tutor", StringComparison.OrdinalIgnoreCase);

    var initialName = User.Identity?.Name ?? "";
    var summaryUrl = Url.Action("Summary", "Header", new { area = "" }) ?? "/Header/Summary";
}

<link href="~/css/student-sidebar.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/tutor-sidebar.css" rel="stylesheet" asp-append-version="true" />

<div id="tutor-realtime-config" class="d-none"
     data-hub-url="@Url.Content("~/hubs/connection-requests")"
     data-requests-url="@Url.Action("Index", "TutorConnectionRequest", new { area = "Tutor" })"></div>

<div class="student-dashboard-shell tutor-dashboard-shell">
    <aside class="student-sidebar" id="studentSidebar" aria-label="Thanh điều hướng gia sư">

        <div class="student-sidebar-user" id="studentSidebarUser" data-info-url="@summaryUrl">
            <img class="student-sidebar-avatar d-none" style="width: 40px; height: 40px; max-width: 40px; max-height: 40px; object-fit: cover; border-radius: 50%;" data-role="avatar-img" alt="" referrerpolicy="no-referrer" />
            <span class="student-sidebar-avatar" data-role="avatar-icon"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
            <div class="student-sidebar-user-info">
                <strong data-role="name">@initialName</strong>
                <small>Gia sư · Đã xác minh</small>
            </div>
        </div>

        <nav class="student-sidebar-nav">
            <span class="student-sidebar-heading">TỔNG QUAN</span>
            <a asp-area="Tutor" asp-controller="TutorProfile" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorProfile" ? "active" : "")">
                <i class="bi bi-grid" aria-hidden="true"></i><span>Tổng quan</span>
            </a>

            <span class="student-sidebar-heading">GIẢNG DẠY</span>
            <a asp-area="Tutor" asp-controller="TutorSchedule" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorSchedule" ? "active" : "")">
                <i class="bi bi-calendar3" aria-hidden="true"></i><span>Lịch dạy</span>
            </a>
            <a asp-area="Tutor" asp-controller="TutorConnectionRequest" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorConnectionRequest" ? "active" : "")">
                <i class="bi bi-person-plus" aria-hidden="true"></i><span>Yêu cầu kết nối</span>
            </a>
            <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorClassroom" ? "active" : "")">
                <i class="bi bi-easel" aria-hidden="true"></i><span>Lớp đang dạy</span>
            </a>
            <a asp-area="Tutor" asp-controller="TutorAvailability" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorAvailability" ? "active" : "")">
                <i class="bi bi-clock-history" aria-hidden="true"></i><span>Lịch rảnh</span>
            </a>
            <a asp-area="Tutor" asp-controller="TutorStudent" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorStudent" ? "active" : "")">
                <i class="bi bi-people" aria-hidden="true"></i><span>Học viên của tôi</span>
            </a>
            <a asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorLearningDocument" ? "active" : "")">
                <i class="bi bi-folder2-open" aria-hidden="true"></i><span>Tài liệu</span>
            </a>

            <span class="student-sidebar-heading">TƯƠNG TÁC</span>
            <a asp-area="Tutor" asp-controller="TutorReview" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorReview" ? "active" : "")">
                <i class="bi bi-star" aria-hidden="true"></i><span>Đánh giá</span>
            </a>
            <a asp-area="" asp-controller="Chat" asp-action="Index"
               class="student-sidebar-link @(controllerName == "Chat" ? "active" : "")">
                <i class="bi bi-chat-dots" aria-hidden="true"></i><span>Tin nhắn</span>
            </a>
            <a asp-area="" asp-controller="Notifications" asp-action="Index"
               class="student-sidebar-link @(controllerName == "Notifications" ? "active" : "")">
                <i class="bi bi-bell" aria-hidden="true"></i><span>Thông báo</span>
            </a>

            <span class="student-sidebar-heading">TÀI CHÍNH</span>
            <span class="student-sidebar-link is-disabled" aria-disabled="true"><i class="bi bi-credit-card" aria-hidden="true"></i><span>Thu nhập</span></span>

            <span class="student-sidebar-heading">TÀI KHOẢN</span>
            <a asp-area="Tutor" asp-controller="TutorProfile" asp-action="Index"
               class="student-sidebar-link @(inTutorArea && controllerName == "TutorProfile" ? "active" : "")">
                <i class="bi bi-person-vcard" aria-hidden="true"></i><span>Hồ sơ</span>
            </a>
        </nav>
    </aside>

    <button type="button" class="student-menu-toggle" id="studentMenuToggle"
            aria-label="Thu gọn thanh điều hướng" aria-controls="studentSidebar" aria-expanded="true">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
    <button type="button" class="student-sidebar-backdrop" id="studentSidebarBackdrop" aria-label="Đóng thanh điều hướng"></button>

    <main id="tutorPageContent" role="main" class="student-dashboard-main tutor-dashboard-main pb-3">
        @RenderBody()
    </main>
</div>

<script>
    (() => {
        // Tên và avatar đầy đủ của gia sư, tải sau khi trang đã hiện
        const box = document.getElementById('studentSidebarUser');
        if (box && box.dataset.infoUrl) {
            fetch(box.dataset.infoUrl, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(res => res.ok ? res.json() : null)
                .then(data => {
                    const user = data && data.user;
                    if (!user) return;
                    const nameEl = box.querySelector('[data-role="name"]');
                    if (nameEl) nameEl.textContent = user.name || '';
                    if (user.avatarUrl) {
                        const img = box.querySelector('[data-role="avatar-img"]');
                        const icon = box.querySelector('[data-role="avatar-icon"]');
                        if (img) {
                            img.onerror = () => {
                                img.classList.add('d-none');
                                if (icon) icon.classList.remove('d-none');
                            };
                            img.src = user.avatarUrl;
                            img.classList.remove('d-none');
                            if (icon) icon.classList.add('d-none');
                        }
                    }
                })
                .catch(() => { /* giữ tên tạm */ });
        }

        // Mở/đóng sidebar: máy tính mở sẵn, điện thoại đóng sẵn
        const toggle = document.getElementById('studentMenuToggle');
        const backdrop = document.getElementById('studentSidebarBackdrop');
        const mobileQuery = window.matchMedia('(max-width: 991.98px)');

        function setSidebarOpen(open) {
            document.body.classList.toggle('student-sidebar-open', open);
            document.body.classList.toggle('student-sidebar-collapsed', !open && !mobileQuery.matches);
            if (toggle) {
                toggle.setAttribute('aria-expanded', String(open));
                const icon = toggle.querySelector('i');
                if (icon) icon.className = open ? 'bi bi-x-lg' : 'bi bi-list';
            }
        }

        if (toggle && backdrop) {
            setSidebarOpen(!mobileQuery.matches);
            toggle.addEventListener('click', () => setSidebarOpen(!document.body.classList.contains('student-sidebar-open')));
            backdrop.addEventListener('click', () => setSidebarOpen(false));
            mobileQuery.addEventListener('change', e => setSidebarOpen(!e.matches));
        }

        // Tự động đồng bộ chiều cao Header để thanh Sidebar và Nút Menu không bị đè khuất
        const header = document.getElementById('header');
        const shell = document.querySelector('.student-dashboard-shell');
        if (header && shell) {
            const syncHeaderOffset = () => {
                shell.style.setProperty('--student-header-offset', header.offsetHeight + 'px');
            };
            syncHeaderOffset();
            window.addEventListener('resize', syncHeaderOffset);
            if (window.ResizeObserver) {
                new ResizeObserver(syncHeaderOffset).observe(header);
            }
        }
    })();
</script>

<!-- SignalR for connection requests & session changes -->
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
<script>
    (() => {
        const config = document.getElementById("tutor-realtime-config");
        if (!config || !window.signalR) return;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(config.dataset.hubUrl)
            .withAutomaticReconnect()
            .build();

        const showNotice = message => {
            const notice = document.createElement("div");
            notice.className = "alert alert-info shadow position-fixed top-0 end-0 m-3";
            notice.style.zIndex = "1080";
            notice.setAttribute("role", "status");
            notice.textContent = message + " ";

            const link = document.createElement("a");
            link.href = config.dataset.requestsUrl;
            link.className = "alert-link";
            link.textContent = "Xem yêu cầu";
            notice.appendChild(link);
            document.body.appendChild(notice);
            window.setTimeout(() => notice.remove(), 10000);
        };

        const currentController = '@controllerName';

        connection.on("ConnectionRequestReceived", update => {
            showNotice(`Có yêu cầu kết nối mới từ ${update.studentName} cho môn ${update.subjectName}.`);
            if (currentController === "TutorConnectionRequest")
                window.setTimeout(() => window.location.reload(), 500);
        });

        connection.on("ConnectionRequestCancelled", () => {
            showNotice("Học viên đã hủy yêu cầu kết nối.");
            if (currentController === "TutorConnectionRequest")
                window.setTimeout(() => window.location.reload(), 500);
        });

        connection.start().catch(error => console.error("SignalR connection failed:", error));
    })();
</script>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
