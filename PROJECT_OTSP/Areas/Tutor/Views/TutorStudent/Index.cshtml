@using static PROJECT_OTSP.Models.Enums
@model IReadOnlyList<PROJECT_OTSP.Dtos.TutorStudentItemVm>
@{
    ViewData["Title"] = "Học viên của tôi";
    var activeTab = (ViewBag.ActiveTab as string) ?? "all";
}

<div class="tutor-page-container">
    <!-- Header -->
    <div class="tutor-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="tutor-page-title">Học viên của tôi</h1>
            <p class="tutor-page-subtitle mb-0">Quản lý danh sách học viên theo từng lớp học và theo dõi tiến độ buổi dạy.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-easel me-1"></i> Quản lý lớp học
            </a>
            <a asp-area="Tutor" asp-controller="TutorSchedule" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-calendar3 me-1"></i> Lịch dạy
            </a>
        </div>
    </div>

    <!-- Filter Tabs (Tất cả / Chính thức / Học thử) -->
    <div class="mb-4">
        <ul class="nav nav-pills gap-2 bg-light p-1.5 rounded-3 border d-inline-flex">
            <li class="nav-item">
                <a class="nav-link py-1.5 px-3 fw-semibold small @(activeTab == "all" ? "active bg-danger text-white shadow-sm" : "text-secondary")"
                   asp-action="Index" asp-route-tab="all">
                    <i class="bi bi-people me-1"></i> Tất cả
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link py-1.5 px-3 fw-semibold small @(activeTab == "official" ? "active bg-danger text-white shadow-sm" : "text-secondary")"
                   asp-action="Index" asp-route-tab="official">
                    <i class="bi bi-mortarboard-fill me-1"></i> Học chính thức
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link py-1.5 px-3 fw-semibold small @(activeTab == "trial" ? "active bg-danger text-white shadow-sm" : "text-secondary")"
                   asp-action="Index" asp-route-tab="trial">
                    <i class="bi bi-lightning-charge me-1"></i> Học thử
                </a>
            </li>
        </ul>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="tutor-card-table-wrapper p-5 text-center">
            <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold">Không tìm thấy học viên nào</h5>
            <p class="text-secondary small mb-0">Khi bạn chấp nhận yêu cầu kết nối học thử hoặc chính thức, học viên sẽ hiển thị tại đây.</p>
        </div>
    }
    else
    {
        <!-- ==================== DESKTOP TABLE VIEW (>= 768px) ==================== -->
        <div class="d-none d-md-block tutor-card-table-wrapper">
            <table class="tutor-custom-table">
                <thead>
                    <tr>
                        <th scope="col" style="width: 20%;">Học viên</th>
                        <th scope="col" style="width: 24%;">Lớp học</th>
                        <th scope="col" style="width: 13%;">Môn</th>
                        <th scope="col" style="width: 13%;">Tiến độ</th>
                        <th scope="col" style="width: 14%;">Buổi tiếp theo</th>
                        <th scope="col" style="min-width: 210px; text-align: right; white-space: nowrap;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="student-avatar-circle" style="width:36px;height:36px;font-size:13px;border-radius:50%;background:#e0e7ff;color:#3730a3;display:flex;align-items:center;justify-content:center;font-weight:700;">
                                        @(string.IsNullOrWhiteSpace(student.StudentName) ? "H" : student.StudentName.Trim().Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="cell-student-name fw-semibold">@student.StudentName</div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@student.ClassroomName</div>
                                @if (student.IsTrial)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-0.5 px-1.5 mt-1" style="font-size: 11px;">
                                        <i class="bi bi-lightning-charge me-1"></i>Học thử
                                    </span>
                                }
                                else if (student.ClassroomType == ClassroomType.Group)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0.5 px-1.5 mt-1" style="font-size: 11px;">
                                        <i class="bi bi-people me-1"></i>Lớp nhóm
                                    </span>
                                }
                                else if (student.ClassroomType == ClassroomType.OneToOne)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-0.5 px-1.5 mt-1" style="font-size: 11px;">
                                        <i class="bi bi-person me-1"></i>1 kèm 1
                                    </span>
                                }
                            </td>
                            <td><span class="fw-medium text-secondary">@student.SubjectName</span></td>
                            <td>
                                <span class="fw-semibold @(student.IsTrial ? "text-primary" : "text-danger")">@student.Progress</span>
                            </td>
                            <td>
                                <div class="slot-time-text fw-medium" style="font-size: 12.5px;">@student.NextSessionFormatted</div>
                            </td>
                            <td style="min-width: 210px; text-align: right; white-space: nowrap;">
                                <div class="d-flex justify-content-end align-items-center gap-1 flex-nowrap">
                                    @if (student.IsTrial)
                                    {
                                        <a asp-controller="TutorSchedule" asp-action="Index" class="btn btn-sm btn-outline-success py-1 px-2 text-nowrap d-inline-flex align-items-center" style="white-space: nowrap; height: 32px; font-size: 12px; font-weight: 500;" title="Nhận vào lớp chính thức (Xếp lịch 6h/tuần)">
                                            <i class="bi bi-mortarboard-fill me-1"></i>Nhận vào lớp chính
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(student.VideoRoom))
                                    {
                                        <a href="/ClassSession/Room?room=@student.VideoRoom" target="_blank" class="btn btn-sm btn-success d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" title="Vào phòng video học">
                                            <i class="bi bi-camera-video-fill"></i>
                                        </a>
                                    }
                                    <a asp-area="" asp-controller="Chat" asp-action="Index" asp-route-contactId="@student.StudentUserId" asp-route-requestId="@student.RequestId" class="btn-tutor-outline-red d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" title="Nhắn tin với học viên">
                                        <i class="bi bi-chat-dots"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ==================== MOBILE CARD VIEW (< 768px) ==================== -->
        <div class="d-block d-md-none tutor-mobile-list">
            @foreach (var student in Model)
            {
                <div class="tutor-mobile-card mb-3 p-3 border rounded-3 bg-white shadow-sm">
                    <div class="tutor-m-card-header d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <div class="tutor-m-student-info d-flex align-items-center gap-2">
                            <div class="student-avatar-circle" style="width:34px;height:34px;font-size:12px;border-radius:50%;background:#e0e7ff;color:#3730a3;display:flex;align-items:center;justify-content:center;font-weight:700;">
                                @(string.IsNullOrWhiteSpace(student.StudentName) ? "H" : student.StudentName.Trim().Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <div class="tutor-m-name fw-bold text-dark">@student.StudentName</div>
                                <div class="tutor-m-subject small text-muted">@student.SubjectName</div>
                            </div>
                        </div>
                        <span class="badge @(student.IsTrial ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") py-1 px-2 fw-semibold">
                            @student.Progress
                        </span>
                    </div>

                    <div class="tutor-m-card-body small mb-3">
                        <div class="tutor-m-data-row d-flex justify-content-between mb-1">
                            <span class="text-muted"><i class="bi bi-mortarboard me-1"></i>Lớp học:</span>
                            <span class="fw-semibold text-dark text-end">
                                @student.ClassroomName
                                @if (student.IsTrial)
                                {
                                    <span class="badge bg-danger-subtle text-danger ms-1" style="font-size: 10px;">Học thử</span>
                                }
                                else if (student.ClassroomType == ClassroomType.Group)
                                {
                                    <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 10px;">Nhóm</span>
                                }
                                else if (student.ClassroomType == ClassroomType.OneToOne)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis ms-1" style="font-size: 10px;">1-1</span>
                                }
                            </span>
                        </div>
                        <div class="tutor-m-data-row d-flex justify-content-between mb-1">
                            <span class="text-muted"><i class="bi bi-calendar-event me-1"></i>Buổi tiếp theo:</span>
                            <span class="fw-semibold text-danger text-end">@student.NextSessionFormatted</span>
                        </div>
                    </div>

                    <div class="tutor-m-card-footer d-flex flex-wrap gap-2">
                        @if (student.IsTrial)
                        {
                            <a asp-controller="TutorSchedule" asp-action="Index" class="btn btn-sm btn-outline-success w-100 py-1.5 d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-mortarboard"></i> Nhận vào lớp chính (Xếp lịch 6h/tuần)
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(student.VideoRoom))
                        {
                            <a href="/ClassSession/Room?room=@student.VideoRoom" target="_blank" class="btn btn-sm btn-success flex-grow-1 py-1.5 d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-camera-video-fill"></i> Vào phòng học
                            </a>
                        }
                        <a asp-area="" asp-controller="Chat" asp-action="Index" asp-route-contactId="@student.StudentUserId" asp-route-requestId="@student.RequestId" class="btn btn-sm btn-outline-danger flex-grow-1 py-1.5 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-chat-dots"></i> Nhắn tin
                        </a>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Pagination -->
    @if (ViewBag.Pagination is PROJECT_OTSP.Dtos.PaginationVm pagination)
    {
        <div class="mt-4">
            @await Html.PartialAsync("_PaginationBar", pagination)
        </div>
    }
</div>
