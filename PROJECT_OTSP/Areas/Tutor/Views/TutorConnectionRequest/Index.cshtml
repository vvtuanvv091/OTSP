@using static PROJECT_OTSP.Models.Enums
@model IReadOnlyList<PROJECT_OTSP.Dtos.TutorConnectionRequestDto>

@{
    ViewData["Title"] = "Yêu cầu kết nối";
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    var currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    var selectedStatus = ViewBag.SelectedStatus as RequestStatus?;
}

<div class="tutor-page-container" id="tutor-requests-page" data-hub-url="@Url.Content("~/hubs/connection-requests")">
    <!-- Header -->
    <div class="tutor-page-header">
        <h1 class="tutor-page-title">Yêu cầu kết nối</h1>
        <p class="tutor-page-subtitle">Học viên gửi yêu cầu kèm khung giờ học thử. Hệ thống đối chiếu với lịch rảnh của bạn.</p>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="tutor-card-table-wrapper p-5 text-center">
            <i class="bi bi-person-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold">Chưa có yêu cầu kết nối nào</h5>
            <p class="text-secondary small mb-0">Khi có học viên gửi đề xuất học thử, thông tin sẽ hiển thị tại đây.</p>
        </div>
    }
    else
    {
        <!-- ==================== DESKTOP TABLE VIEW (>= 768px) ==================== -->
        <div class="d-none d-md-block tutor-card-table-wrapper">
            <table class="tutor-custom-table">
                <thead>
                    <tr>
                        <th scope="col" style="width: 20%;">Học viên</th>
                        <th scope="col" style="width: 20%;">Môn / Cấp</th>
                        <th scope="col" style="width: 28%;">Giờ học thử đề xuất</th>
                        <th scope="col" style="width: 16%;">Trạng thái</th>
                        <th scope="col" style="width: 16%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        var statusLabel = request.Status switch
                        {
                            RequestStatus.Pending => "Chờ duyệt",
                            RequestStatus.Accepted => "Đã chấp nhận",
                            RequestStatus.Rejected => "Đã từ chối",
                            RequestStatus.Cancelled => "Đã hủy",
                            _ => request.Status.ToString()
                        };

                        var badgeClass = request.Status switch
                        {
                            RequestStatus.Pending => "tutor-pill-pending",
                            RequestStatus.Accepted => "tutor-pill-accepted",
                            RequestStatus.Rejected => "tutor-pill-rejected",
                            _ => "tutor-pill-cancelled"
                        };

                        string formattedSlot = "Lịch linh hoạt";
                        if (request.ProposedTrialSlotUtc.HasValue)
                        {
                            var s = request.ProposedTrialSlotUtc.Value.AddHours(7);
                            var day = s.DayOfWeek switch
                            {
                                DayOfWeek.Sunday => "Chủ nhật",
                                DayOfWeek.Monday => "Thứ 2",
                                DayOfWeek.Tuesday => "Thứ 3",
                                DayOfWeek.Wednesday => "Thứ 4",
                                DayOfWeek.Thursday => "Thứ 5",
                                DayOfWeek.Friday => "Thứ 6",
                                DayOfWeek.Saturday => "Thứ 7",
                                _ => ""
                            };
                            formattedSlot = $"{day}, {s:dd/MM} · {s:HH:mm}-{s.AddHours(1):HH:mm}";
                        }
                        else if (request.ProposedTrialSlotsUtc.Count > 0)
                        {
                            var s = request.ProposedTrialSlotsUtc[0].AddHours(7);
                            var day = s.DayOfWeek switch
                            {
                                DayOfWeek.Sunday => "Chủ nhật",
                                DayOfWeek.Monday => "Thứ 2",
                                DayOfWeek.Tuesday => "Thứ 3",
                                DayOfWeek.Wednesday => "Thứ 4",
                                DayOfWeek.Thursday => "Thứ 5",
                                DayOfWeek.Friday => "Thứ 6",
                                DayOfWeek.Saturday => "Thứ 7",
                                _ => ""
                            };
                            formattedSlot = $"{day}, {s:dd/MM} · {s:HH:mm}-{s.AddHours(1):HH:mm}";
                        }

                        <tr data-request-row="@request.Id">
                            <td>
                                <div class="cell-student-name">@request.StudentName</div>
                            </td>
                            <td>
                                <span>@request.SubjectName</span>
                                @if (!string.IsNullOrWhiteSpace(request.GradeLevelName))
                                {
                                    <span> · @request.GradeLevelName</span>
                                }
                            </td>
                            <td>
                                <div class="slot-time-text">@formattedSlot</div>
                                @if (request.MatchesAvailability)
                                {
                                    <div class="slot-match-note">
                                        <span class="match-check">✓</span> Khớp lịch rảnh
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="tutor-pill-badge @badgeClass">@statusLabel</span>
                            </td>
                            <td>
                                @if (request.Status == RequestStatus.Pending)
                                {
                                    <div class="tutor-action-group">
                                        @if (request.Id < 0)
                                        {
                                            <button type="button" class="btn-tutor-accept" onclick="alert('Đã chấp nhận yêu cầu của @request.StudentName.'); location.reload();">
                                                Chấp nhận
                                            </button>
                                            <button type="button" class="btn-tutor-reject" onclick="alert('Đã từ chối yêu cầu.'); location.reload();">
                                                Từ chối
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="Accept" asp-route-id="@request.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn-tutor-accept">Chấp nhận</button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@request.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn-tutor-reject">Từ chối</button>
                                            </form>
                                        }
                                    </div>
                                }
                                else if (request.Status == RequestStatus.Accepted)
                                {
                                    <span class="tutor-text-action">Đã học thử</span>
                                }
                                else if (request.Status == RequestStatus.Rejected)
                                {
                                    <span class="text-muted small">Đã từ chối</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Đã hủy</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ==================== MOBILE CARD VIEW (< 768px) ==================== -->
        <div class="d-block d-md-none tutor-mobile-list">
            @foreach (var request in Model)
            {
                var statusLabel = request.Status switch
                {
                    RequestStatus.Pending => "Chờ duyệt",
                    RequestStatus.Accepted => "Đã chấp nhận",
                    RequestStatus.Rejected => "Đã từ chối",
                    RequestStatus.Cancelled => "Đã hủy",
                    _ => request.Status.ToString()
                };

                var badgeClass = request.Status switch
                {
                    RequestStatus.Pending => "tutor-pill-pending",
                    RequestStatus.Accepted => "tutor-pill-accepted",
                    RequestStatus.Rejected => "tutor-pill-rejected",
                    _ => "tutor-pill-cancelled"
                };

                string formattedSlot = "Lịch linh hoạt";
                if (request.ProposedTrialSlotUtc.HasValue)
                {
                    var s = request.ProposedTrialSlotUtc.Value.AddHours(7);
                    var day = s.DayOfWeek switch
                    {
                        DayOfWeek.Sunday => "Chủ nhật",
                        DayOfWeek.Monday => "Thứ 2",
                        DayOfWeek.Tuesday => "Thứ 3",
                        DayOfWeek.Wednesday => "Thứ 4",
                        DayOfWeek.Thursday => "Thứ 5",
                        DayOfWeek.Friday => "Thứ 6",
                        DayOfWeek.Saturday => "Thứ 7",
                        _ => ""
                    };
                    formattedSlot = $"{day}, {s:dd/MM} · {s:HH:mm}-{s.AddHours(1):HH:mm}";
                }
                else if (request.ProposedTrialSlotsUtc.Count > 0)
                {
                    var s = request.ProposedTrialSlotsUtc[0].AddHours(7);
                    var day = s.DayOfWeek switch
                    {
                        DayOfWeek.Sunday => "Chủ nhật",
                        DayOfWeek.Monday => "Thứ 2",
                        DayOfWeek.Tuesday => "Thứ 3",
                        DayOfWeek.Wednesday => "Thứ 4",
                        DayOfWeek.Thursday => "Thứ 5",
                        DayOfWeek.Friday => "Thứ 6",
                        DayOfWeek.Saturday => "Thứ 7",
                        _ => ""
                    };
                    formattedSlot = $"{day}, {s:dd/MM} · {s:HH:mm}-{s.AddHours(1):HH:mm}";
                }

                <div class="tutor-mobile-card" data-request-row="@request.Id">
                    <div class="tutor-m-card-header">
                        <div class="tutor-m-student-info">
                            <div class="student-avatar-circle">
                                @(string.IsNullOrWhiteSpace(request.StudentName) ? "H" : request.StudentName.Trim().Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <div class="tutor-m-name">@request.StudentName</div>
                                <div class="tutor-m-subject">
                                    @request.SubjectName
                                    @if (!string.IsNullOrWhiteSpace(request.GradeLevelName))
                                    {
                                        <span> · @request.GradeLevelName</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <span class="tutor-pill-badge @badgeClass">@statusLabel</span>
                    </div>

                    <div class="tutor-m-card-body">
                        <div class="tutor-m-data-row">
                            <span class="tutor-m-label"><i class="bi bi-clock me-1"></i>Học thử:</span>
                            <span class="tutor-m-value">@formattedSlot</span>
                        </div>
                        @if (request.MatchesAvailability)
                        {
                            <div class="slot-match-note justify-content-end">
                                <span class="match-check">✓</span> Khớp lịch rảnh
                            </div>
                        }
                    </div>

                    <div class="tutor-m-card-footer">
                        @if (request.Status == RequestStatus.Pending)
                        {
                            @if (request.Id < 0)
                            {
                                <button type="button" class="btn-tutor-accept" onclick="alert('Đã chấp nhận yêu cầu của @request.StudentName.'); location.reload();">
                                    Chấp nhận
                                </button>
                                <button type="button" class="btn-tutor-reject" onclick="alert('Đã từ chối yêu cầu.'); location.reload();">
                                    Từ chối
                                </button>
                            }
                            else
                            {
                                <form asp-action="Accept" asp-route-id="@request.Id" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn-tutor-accept w-100">Chấp nhận</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@request.Id" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn-tutor-reject w-100">Từ chối</button>
                                </form>
                            }
                        }
                        else if (request.Status == RequestStatus.Accepted)
                        {
                            <span class="tutor-text-action text-center w-100 py-1">Đã học thử</span>
                        }
                        else if (request.Status == RequestStatus.Rejected)
                        {
                            <span class="text-muted small text-center w-100 py-1">Đã từ chối</span>
                        }
                        else
                        {
                            <span class="text-muted small text-center w-100 py-1">Đã hủy</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Phân trang yêu cầu kết nối">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-status="@selectedStatus" asp-route-page="@(currentPage - 1)" aria-label="Trang trước">Trước</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-status="@selectedStatus" asp-route-page="@(currentPage + 1)" aria-label="Trang sau">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
