@model PROJECT_OTSP.Areas.Tutor.Controllers.TutorDashboardVm

@{
    ViewData["Title"] = "Tổng quan";
    var moneyCulture = new System.Globalization.CultureInfo("vi-VN");
}

<style>
    .tutor-dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .tutor-dash-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 12px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .tutor-kpi-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 10px;
        padding: 18px 20px;
        height: 100%;
    }

    .tutor-kpi-title {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 6px;
    }

    .tutor-kpi-value {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
        line-height: 1.2;
    }

    /* Top Banner Card */
    .tutor-banner-card {
        background-color: var(--bs-card-bg, #ffffff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 12px;
        padding: 24px 28px;
    }

    .tutor-banner-label {
        font-size: 0.82rem;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .tutor-banner-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
        margin-bottom: 6px;
    }

    .tutor-banner-meta {
        font-size: 0.88rem;
        font-weight: 600;
        color: #dc2626;
    }

    .btn-red-action {
        background-color: #dc2626;
        color: #ffffff;
        font-weight: 600;
        border: 1px solid #dc2626;
        border-radius: 8px;
        padding: 8px 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .btn-red-action:hover, .btn-red-action:focus {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .btn-red-action-sm {
        background-color: #dc2626;
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 6px;
        padding: 5px 14px;
        font-size: 0.84rem;
        text-decoration: none;
        display: inline-block;
    }

    .btn-red-action-sm:hover {
        background-color: #b91c1c;
        color: #ffffff;
    }

    /* Badges */
    .badge-open-later {
        background-color: #fee2e2;
        color: #b91c1c;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-future {
        background-color: #f1f5f9;
        color: #64748b;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-block;
    }

    /* Checklist */
    .checklist-progress-track {
        height: 6px;
        background-color: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 22px;
    }

    .checklist-progress-fill {
        height: 100%;
        background-color: #dc2626;
        border-radius: 999px;
        transition: width 0.3s ease;
    }

    .tutor-checklist-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
        font-size: 0.92rem;
        color: var(--bs-body-color, #1e293b);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .tutor-checklist-item:hover {
        color: #dc2626;
    }

    .tutor-checklist-item.done {
        color: var(--bs-body-color, #0f172a);
        font-weight: 500;
    }

    .tutor-checklist-item.pending {
        color: #94a3b8;
    }

    .checklist-icon-done {
        font-weight: 800;
        font-size: 1.05rem;
        color: #0f172a;
        line-height: 1;
        width: 18px;
        text-align: center;
    }

    .checklist-icon-pending {
        font-size: 0.95rem;
        color: #cbd5e1;
        line-height: 1;
        width: 18px;
        text-align: center;
    }

    /* Table */
    .upcoming-schedule-table {
        margin-bottom: 0;
    }

    .upcoming-schedule-table th {
        border-top: none;
        border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--bs-body-color, #0f172a);
        padding: 12px 14px;
    }

    .upcoming-schedule-table td {
        border-top: none;
        border-bottom: 1px solid var(--bs-border-color, #f1f5f9);
        padding: 14px;
        vertical-align: middle;
        font-size: 0.9rem;
    }

    .upcoming-schedule-table tr:last-child td {
        border-bottom: none;
    }

    /* Collapse / Hide Toggle Button */
    .btn-toggle-schedule {
        border: 1px solid var(--bs-border-color, #e2e8f0);
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 4px 10px;
        background: transparent;
        transition: all 0.15s ease;
    }

    .btn-toggle-schedule:hover {
        background-color: var(--bs-tertiary-bg, #f1f5f9);
        color: #0f172a;
        border-color: #cbd5e1;
    }

    /* Compact Pagination for dashboard */
    .schedule-pagination-wrapper .pagination-modern {
        margin: 0.85rem 0 0.25rem 0;
        gap: 4px;
    }

    .schedule-pagination-wrapper .pagination-modern .page-link-btn {
        min-width: 32px;
        height: 32px;
        font-size: 0.8rem;
        padding: 0 8px;
        border-radius: 6px;
    }

    [data-bs-theme="dark"] .badge-open-later {
        background-color: rgba(220, 38, 38, 0.2);
        color: #fca5a5;
    }

    [data-bs-theme="dark"] .badge-future {
        background-color: rgba(255, 255, 255, 0.08);
        color: #94a3b8;
    }

    [data-bs-theme="dark"] .checklist-icon-done {
        color: #f1f5f9;
    }

    [data-bs-theme="dark"] .checklist-progress-track {
        background-color: #334155;
    }

    [data-bs-theme="dark"] .btn-toggle-schedule {
        border-color: #334155;
        color: #94a3b8;
    }

    [data-bs-theme="dark"] .btn-toggle-schedule:hover {
        background-color: #1e293b;
        color: #f1f5f9;
        border-color: #475569;
    }
</style>

<div class="container-fluid py-4 tutor-dashboard-container">
    <!-- Header -->
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1" style="color: var(--bs-body-color, #0f172a);">Tổng quan</h1>
        <p class="text-secondary mb-0" style="font-size: 0.92rem;">Khu làm việc của gia sư</p>
    </div>

    <!-- Thông báo hệ thống (nếu có) -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-1"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- 1. Top Banner: Buổi học tiếp theo -->
    <div class="tutor-banner-card mb-4 shadow-sm">
        @if (Model.NextSession != null)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="tutor-banner-label">Buổi học tiếp theo</div>
                    <div class="tutor-banner-title">@Model.NextSession.Title</div>
                    <div class="tutor-banner-meta">@Model.NextSession.Subtitle</div>
                </div>
                <div>
                    <a href="@Model.NextSession.JoinUrl" target="_blank" class="btn-red-action">
                        Vào lớp
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="tutor-banner-label">Buổi học tiếp theo</div>
                    <div class="tutor-banner-title">Chưa có buổi học nào sắp diễn ra</div>
                    <div class="text-secondary small">
                        Hiện tại không có lịch học nào trong thời gian tới. Bạn có thể mở thêm lịch rảnh hoặc thiết lập lịch lớp học.
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-area="Tutor" asp-controller="TutorSchedule" asp-action="Index" class="btn btn-outline-secondary px-3 py-2 fw-semibold">
                        <i class="bi bi-calendar3 me-1"></i> Xem lịch dạy
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- 2. Row 4 Metric Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Buổi hôm nay -->
        <div class="col-6 col-md-3">
            <div class="tutor-kpi-card shadow-sm">
                <div class="tutor-kpi-title">BUỔI HÔM NAY</div>
                <div class="tutor-kpi-value">@Model.TodaySessionsCount</div>
            </div>
        </div>
        <!-- Card 2: Lớp đang dạy -->
        <div class="col-6 col-md-3">
            <div class="tutor-kpi-card shadow-sm">
                <div class="tutor-kpi-title">LỚP ĐANG DẠY</div>
                <div class="tutor-kpi-value">@Model.ActiveClassesCount</div>
            </div>
        </div>
        <!-- Card 3: Yêu cầu chờ -->
        <div class="col-6 col-md-3">
            <div class="tutor-kpi-card shadow-sm">
                <div class="tutor-kpi-title">YÊU CẦU CHỜ</div>
                <div class="tutor-kpi-value">@Model.PendingRequestsCount</div>
            </div>
        </div>
        <!-- Card 4: Đánh giá -->
        <div class="col-6 col-md-3">
            <div class="tutor-kpi-card shadow-sm">
                <div class="tutor-kpi-title">ĐÁNH GIÁ</div>
                <div class="tutor-kpi-value">
                    ★ @(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0", moneyCulture) : "--")
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Two Columns: Lịch sắp tới (Left) & Hoàn thiện hồ sơ (Right) -->
    <div class="row g-4">
        <!-- Cột trái: Lịch sắp tới -->
        <div class="col-12 col-lg-7">
            <div class="tutor-dash-card shadow-sm p-4 h-100">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="h5 fw-bold mb-0" style="color: var(--bs-body-color, #0f172a);">Lịch sắp tới</h2>
                        @if (Model.Pagination?.TotalItems > 0)
                        {
                            <span class="badge rounded-pill bg-light text-secondary border fw-semibold" style="font-size: 0.75rem;">
                                @Model.Pagination.TotalItems
                            </span>
                        }
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <!-- Ô tìm kiếm tối ưu -->
                        <div class="position-relative" style="width: 175px;">
                            <input type="text"
                                   id="scheduleSearchInput"
                                   value="@Model.SearchQuery"
                                   placeholder="Tìm lớp, học viên..."
                                   class="form-control form-control-sm ps-4 pe-2 rounded-pill"
                                   style="font-size: 0.82rem;" />
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size: 0.75rem;"></i>
                        </div>

                        <!-- Nút Thu gọn / Ẩn hiện lịch học -->
                        <button type="button" 
                                class="btn btn-toggle-schedule rounded-pill d-inline-flex align-items-center gap-1"
                                id="btnToggleSchedule"
                                data-bs-toggle="collapse" 
                                data-bs-target="#scheduleCollapseArea" 
                                aria-expanded="true" 
                                aria-controls="scheduleCollapseArea"
                                title="Thu gọn hoặc mở rộng lịch học">
                            <i class="bi bi-dash-lg toggle-icon" id="scheduleToggleIcon"></i>
                            <span id="scheduleToggleText">Thu gọn</span>
                        </button>
                    </div>
                </div>

                <!-- Khu vực bảng và phân trang (Có thể thu gọn hoặc ẩn) -->
                <div class="collapse show" id="scheduleCollapseArea">
                    @if (Model.UpcomingSessions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table upcoming-schedule-table" id="upcomingScheduleTable">
                                <thead>
                                    <tr>
                                        <th style="width: 32%;">Giờ</th>
                                        <th style="width: 44%;">Lớp</th>
                                        <th style="width: 24%; text-align: right;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UpcomingSessions)
                                    {
                                        <tr class="schedule-row" data-search-target="@item.ClassDisplay.ToLowerInvariant() @item.TimeFormatted.ToLowerInvariant()">
                                            <td class="text-nowrap" style="color: var(--bs-body-color, #1e293b); font-weight: 500;">
                                                @item.TimeFormatted
                                            </td>
                                            <td style="color: var(--bs-body-color, #1e293b); font-weight: 500;">
                                                @item.ClassDisplay
                                            </td>
                                            <td class="text-end text-nowrap">
                                                @if (item.BadgeType == "Join")
                                                {
                                                    <a href="@item.JoinUrl" target="_blank" class="btn-red-action-sm">
                                                        Vào lớp
                                                    </a>
                                                }
                                                else if (item.BadgeType == "OpenLater")
                                                {
                                                    <span class="badge-open-later">@item.ActionText</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-future">@item.ActionText</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang PaginationVm chống tràn bảng -->
                        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
                        {
                            <div class="schedule-pagination-wrapper">
                                @await Html.PartialAsync("_PaginationBar", Model.Pagination)
                            </div>
                        }

                        <div id="noMatchMessage" class="text-center py-4 text-muted d-none" style="font-size: 0.9rem;">
                            <i class="bi bi-search mb-2 fs-4 d-block text-secondary"></i>
                            Không tìm thấy buổi học nào khớp với từ khóa tìm kiếm.
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar2-x fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-2 fw-medium">Chưa có buổi học nào sắp tới.</p>
                            <p class="small text-secondary mb-3">Lịch học từ các lớp đang dạy hoặc yêu cầu học thử được xác nhận sẽ xuất hiện tại đây.</p>
                            <a asp-area="Tutor" asp-controller="TutorSchedule" asp-action="Index" class="btn btn-sm btn-outline-danger">
                                Mở lịch dạy
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Hoàn thiện hồ sơ -->
        <div class="col-12 col-lg-5">
            <div class="tutor-dash-card shadow-sm p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 fw-bold mb-0" style="color: var(--bs-body-color, #0f172a);">
                        Hoàn thiện hồ sơ · @Model.ProfileCompletionPercent%
                    </h2>
                </div>

                <!-- Thanh tiến độ màu đỏ -->
                <div class="checklist-progress-track">
                    <div class="checklist-progress-fill" style="width: @Model.ProfileCompletionPercent%;"></div>
                </div>

                <!-- Danh sách 5 mục kiểm tra -->
                <div class="d-flex flex-column gap-1">
                    @foreach (var item in Model.ChecklistItems)
                    {
                        <a href="@item.ActionUrl" class="tutor-checklist-item @(item.IsChecked ? "done" : "pending")" title="Bấm để cập nhật mục này">
                            @if (item.IsChecked)
                            {
                                <span class="checklist-icon-done">✓</span>
                            }
                            else
                            {
                                <span class="checklist-icon-pending">▢</span>
                            }
                            <span class="flex-grow-1">@item.Label</span>
                            <i class="bi bi-chevron-right text-muted opacity-50 ms-auto" style="font-size: 0.75rem;"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('scheduleSearchInput');
        const table = document.getElementById('upcomingScheduleTable');
        const noMatch = document.getElementById('noMatchMessage');
        const collapseEl = document.getElementById('scheduleCollapseArea');
        const toggleIcon = document.getElementById('scheduleToggleIcon');
        const toggleText = document.getElementById('scheduleToggleText');

        // 1. Quản lý trạng thái Thu gọn / Mở rộng lịch học
        if (collapseEl) {
            const isCollapsed = localStorage.getItem('otsp_tutor_schedule_collapsed') === 'true';
            if (isCollapsed) {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseEl, { toggle: false });
                bsCollapse.hide();
                if (toggleIcon) toggleIcon.className = 'bi bi-plus-lg toggle-icon';
                if (toggleText) toggleText.textContent = 'Mở lịch';
            }

            collapseEl.addEventListener('hide.bs.collapse', function () {
                if (toggleIcon) toggleIcon.className = 'bi bi-plus-lg toggle-icon';
                if (toggleText) toggleText.textContent = 'Mở lịch';
                localStorage.setItem('otsp_tutor_schedule_collapsed', 'true');
            });

            collapseEl.addEventListener('show.bs.collapse', function () {
                if (toggleIcon) toggleIcon.className = 'bi bi-dash-lg toggle-icon';
                if (toggleText) toggleText.textContent = 'Thu gọn';
                localStorage.setItem('otsp_tutor_schedule_collapsed', 'false');
            });
        }

        // 2. Tìm kiếm tức thời phía Client (nhanh, mượt)
        if (searchInput && table) {
            const rows = table.querySelectorAll('tbody tr.schedule-row');

            searchInput.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();
                let visibleCount = 0;

                // Tự động mở rộng nếu đang thu gọn mà gõ tìm kiếm
                if (collapseEl && !collapseEl.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(collapseEl).show();
                }

                rows.forEach(row => {
                    const searchTarget = row.getAttribute('data-search-target') || '';
                    if (!query || searchTarget.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatch) {
                    if (visibleCount === 0 && query.length > 0) {
                        noMatch.classList.remove('d-none');
                    } else {
                        noMatch.classList.add('d-none');
                    }
                }
            });

            // Nhấn Enter để gửi truy vấn tìm kiếm server kèm phân trang
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const term = encodeURIComponent(this.value.trim());
                    const url = new URL(window.location.href);
                    url.searchParams.set('page', '1');
                    if (term) {
                        url.searchParams.set('q', term);
                    } else {
                        url.searchParams.delete('q');
                    }
                    window.location.href = url.toString();
                }
            });
        }
    });
</script>
