@using PROJECT_OTSP.Models
@model TutorProfile
@{
    ViewData["Title"] = "Hồ sơ gia sư";

    var avatarUrl = string.IsNullOrWhiteSpace(Model.User.AvatarUrl)
        ? Url.Content("~/assets/img/default-avatar.svg")
        : Model.User.AvatarUrl;

    var statusClass = Model.VerificationStatus switch
    {
        Enums.VerificationStatus.Approved => "status-approved",
        Enums.VerificationStatus.Rejected => "status-rejected",
        _ => "status-pending"
    };

    var statusIcon = Model.VerificationStatus switch
    {
        Enums.VerificationStatus.Approved => "bi-patch-check-fill",
        Enums.VerificationStatus.Rejected => "bi-x-octagon-fill",
        _ => "bi-hourglass-split"
    };
    
}

<style>
    .profile-wrap { padding-top: 1.5rem; padding-bottom: 3.5rem; }

    /* Sidebar dính khi cuộn */
    @@media (min-width: 992px) {
        .sticky-side { position: sticky; top: 90px; }
    }

    .rating-line {
        font-size: .9rem;
        color: var(--bs-secondary-color);
    }

    /* Bằng cấp */
    .qual-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: var(--radius-md);
        transition: border-color .2s, box-shadow .2s, transform .2s;
    }
    .qual-item + .qual-item { margin-top: .75rem; }
    .qual-item:hover {
        transform: translateY(-2px);
        border-color: var(--brand);
        box-shadow: 0 10px 24px rgba(0,0,0,.08);
    }
    .qual-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--brand-soft);
        color: var(--brand);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .save-bar {
        display: flex;
        justify-content: flex-end;
        margin: .5rem 0 1.5rem;
    }
</style>

<div class="container profile-wrap">

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4">

        <aside class="col-lg-4">
            <div class="sticky-side">
                <div class="pro-card text-center">
                    <div class="avatar-wrapper">
                        <div class="avatar-ring">
                            <img id="tutorAvatarImg" src="@avatarUrl" alt="Ảnh đại diện gia sư" />
                        </div>
                        <div id="avatarSpinner" class="avatar-loading-overlay">
                            <div class="spinner-border spinner-border-sm text-light" role="status"></div>
                        </div>
                        <label for="avatarFileInput" class="avatar-upload-btn" title="Đổi ảnh đại diện">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                        <input type="file" id="avatarFileInput" accept="image/jpeg,image/png,image/webp" class="d-none" />
                    </div>

                    <h2 class="h5 fw-bold mb-2">@Model.User.FullName</h2>

                    <span class="status-pill @statusClass">
                        <i class="bi @statusIcon"></i>@Model.VerificationStatus
                    </span>

                    <div class="rating-line mt-3">
                        @if (Model.AverageRating > 0)
                        {
                            <span><i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0") / 5</span>
                        }
                        else
                        {
                            <span>Chưa có đánh giá</span>
                        }
                    </div>
                </div>
            </div>
        </aside>

        <main class="col-lg-8">

            <form asp-action="UpdateProfile" method="post">
                <section class="pro-card mb-4">
                    <div class="section-head">
                        <h2 class="section-title">
                            <span class="section-icon"><i class="bi bi-person-vcard"></i></span>
                            Thông tin cá nhân
                        </h2>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="DisplayName" class="form-label">Họ và tên</label>
                            <input id="DisplayName" name="DisplayName" class="form-control"
                                   value="@Model.User.FullName" maxlength="150" required />
                        </div>
                        <div class="col-md-6">
                            <label for="citizenIdNumber" class="form-label">Số CCCD (12 chữ số)</label>
                            <input id="citizenIdNumber" name="citizenIdNumber" class="form-control" inputmode="numeric"
                                   value="@Model.User.CitizenIdNumber" maxlength="12" pattern="[0-9]{12}" required />
                        </div>
                        <div class="col-12">
                            <label for="residenceAddress" class="form-label">Nơi ở hiện tại (thông tin riêng tư)</label>
                            <input id="residenceAddress" name="residenceAddress" class="form-control"
                                   value="@Model.User.ResidenceAddress" maxlength="500" required />
                        </div>
                        <div class="col-md-6">
                            <label for="Email" class="form-label">Email</label>
                            <input id="Email" class="form-control" value="@Model.User.Email" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="PhoneNumber" class="form-label">Số điện thoại</label>
                            <input id="PhoneNumber" class="form-control" value="@Model.User.PhoneNumber" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="DateOfBirth" class="form-label">Ngày sinh</label>
                            <input id="DateOfBirth" type="date" class="form-control"
                                   value="@(Model.User.DateOfBirth?.ToString("yyyy-MM-dd"))" readonly />
                        </div>
                        <div class="col-12">
                            <label for="Address" class="form-label">Địa chỉ</label>
                            <input id="Address" class="form-control" value="@Model.User.Address" readonly />
                        </div>
                    </div>
                </section>

                <section class="pro-card mb-4">
                    <div class="section-head">
                        <h2 class="section-title">
                            <span class="section-icon"><i class="bi bi-chat-quote"></i></span>
                            Giới thiệu bản thân
                        </h2>
                    </div>

                    <textarea id="Introduction" name="Introduction" class="form-control" rows="5"
                              placeholder="Giới thiệu kinh nghiệm, phương pháp giảng dạy và môn học của bạn...">@Model.Introduction</textarea>
                </section>

                <div class="save-bar">
                    <button type="submit" class="btn btn-brand">
                        <i class="bi bi-check2-circle me-2"></i>Lưu hồ sơ
                    </button>
                </div>
            </form>

            <section class="pro-card mb-4">
                <div class="section-head">
                    <h2 class="section-title">
                        <span class="section-icon"><i class="bi bi-cash-stack"></i></span>
                        Môn dạy và học phí
                    </h2>
                </div>

                <div id="subjectList" class="mb-3"
                     data-remove-url="@Url.Action("Remove", "TutorSubject", new { area = "Tutor" })">
                    @foreach (var item in Model.TutorSubjects)
                    {
                        <span class="subject-chip">
                            <i class="bi bi-bookmark-fill"></i>
                            @item.Subject.Name · @item.GradeLevel.Name
                            <button type="button" class="btn-close ms-1" aria-label="Xóa"
                                    data-remove-subject="@item.Id"></button>
                        </span>
                    }
                </div>

                <div id="emptySubjects" class="empty-box mb-3 @(Model.TutorSubjects.Any() ? "d-none" : "")">
                    <i class="bi bi-journal-plus"></i>
                    <span>Bạn chưa thêm môn và cấp học giảng dạy.</span>
                </div>

                <form id="subjectForm" asp-area="Tutor" asp-controller="TutorSubject" asp-action="Add"
                      method="post" class="row g-2 align-items-end mb-4">
                    <div class="col-md-5">
                        <label class="form-label">Môn học</label>
                        <select name="subjectId" class="form-select" required>
                            @foreach (var s in (IEnumerable<Subject>)ViewBag.Subjects)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cấp học</label>
                        <select name="gradeLevelId" class="form-select" required>
                            @foreach (var g in (IEnumerable<GradeLevel>)ViewBag.GradeLevels)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-brand">Thêm</button>
                    </div>
                </form>

                <label for="HourlyFee" class="form-label">Học phí mỗi giờ</label>
                <div class="input-group">
                    <input id="HourlyFee" class="form-control" value="@Model.HourlyFee.ToString("N0")" readonly />
                    <span class="input-group-text">VNĐ/giờ</span>
                </div>
            </section>

            <section class="pro-card mb-4">
                <div class="section-head">
                    <h2 class="section-title">
                        <span class="section-icon"><i class="bi bi-patch-check"></i></span>
                        Bằng cấp / Chứng chỉ
                    </h2>
                    <button class="btn btn-brand btn-sm px-3" type="button"
                            data-bs-toggle="collapse" data-bs-target="#qualificationUpload"
                            aria-expanded="false" aria-controls="qualificationUpload">
                        <i class="bi bi-cloud-arrow-up me-1"></i>Tải bằng / chứng chỉ
                    </button>
                </div>

                <div class="collapse mb-4" id="qualificationUpload">
                    <form id="qualificationForm" asp-area="Tutor" asp-controller="Qualification" asp-action="Upload"
                          method="post" enctype="multipart/form-data" class="upload-box">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label for="qualificationTitle" class="form-label">Tên bằng cấp / chứng chỉ</label>
                                <input id="qualificationTitle" name="title" class="form-control" maxlength="200"
                                       required placeholder="Ví dụ: Chứng chỉ IELTS" />
                            </div>
                            <div class="col-md-5">
                                <label for="qualificationFile" class="form-label">Tệp (PDF, JPG, PNG; tối đa 10 MB)</label>
                                <input id="qualificationFile" name="file" type="file" class="form-control"
                                       accept=".pdf,.jpg,.jpeg,.png" required />
                            </div>
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-brand">Tải lên</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div id="qualList"
                     data-remove-url="@Url.Action("Remove", "Qualification", new { area = "Tutor" })"
                     data-open-url="@Url.Action("Open", "Qualification", new { area = "Tutor" })">
                    @foreach (var qualification in Model.Qualifications)
                    {
                        var statusText = qualification.Status switch
                        {
                            Enums.VerificationStatus.Approved => "Đã duyệt",
                            Enums.VerificationStatus.Rejected => "Bị từ chối",
                            _ => "Chờ xác minh"
                        };

                        <div class="qual-item">
                            <div class="d-flex align-items-center gap-3">
                                <span class="qual-icon"><i class="bi bi-award"></i></span>
                                <div>
                                    <div class="fw-semibold">@qualification.Title</div>
                                    <small class="text-secondary">Trạng thái: @statusText</small>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(qualification.FileUrl))
                                {
                                    <a class="btn btn-soft btn-sm px-3"
                                       href="@Url.Action("Open", "Qualification", new { area = "Tutor", id = qualification.Id })"
                                       target="_blank" rel="noopener">Xem tệp</a>
                                }

                                @if (qualification.Status == Enums.VerificationStatus.Pending)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm px-3"
                                            data-remove-qual="@qualification.Id">Xóa</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div id="emptyQuals" class="empty-box @(Model.Qualifications.Any() ? "d-none" : "")">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                    <span>Bạn chưa tải lên bằng cấp hoặc chứng chỉ. Thêm bằng cấp giúp hồ sơ đáng tin hơn.</span>
                </div>
            </section>

        </main>
    </div>
</div>

<script>
(() => {
    const notify = OTSP.notify;
    const send = OTSP.send;
    const esc = OTSP.escapeHtml;

    const subjectList = document.getElementById('subjectList');
    const subjectForm = document.getElementById('subjectForm');
    const qualList = document.getElementById('qualList');
    const qualForm = document.getElementById('qualificationForm');

    function syncEmpty(list, emptyId) {
        document.getElementById(emptyId).classList.toggle('d-none', list.children.length > 0);
    }

    function subjectChip(item) {
        const el = document.createElement('span');
        el.className = 'subject-chip';
        el.innerHTML = `<i class="bi bi-bookmark-fill"></i>
            ${esc(item.subjectName)} · ${esc(item.gradeName)}
            <button type="button" class="btn-close ms-1" aria-label="Xóa" data-remove-subject="${item.id}"></button>`;
        return el;
    }

    function qualItem(item) {
        const el = document.createElement('div');
        el.className = 'qual-item';
        el.innerHTML = `
            <div class="d-flex align-items-center gap-3">
                <span class="qual-icon"><i class="bi bi-award"></i></span>
                <div>
                    <div class="fw-semibold">${esc(item.title)}</div>
                    <small class="text-secondary">Trạng thái: ${esc(item.statusText)}</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-soft btn-sm px-3" href="${qualList.dataset.openUrl}?id=${item.id}"
                   target="_blank" rel="noopener">Xem tệp</a>
                ${item.canRemove ? `<button type="button" class="btn btn-outline-danger btn-sm px-3" data-remove-qual="${item.id}">Xóa</button>` : ''}
            </div>`;
        return el;
    }

    subjectForm.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = subjectForm.querySelector('button[type="submit"]');
        btn.disabled = true;
        try {
            const data = await send(subjectForm.action, new FormData(subjectForm));
            subjectList.appendChild(subjectChip(data.item));
            syncEmpty(subjectList, 'emptySubjects');
            notify('success', data.message);
        } catch (err) {
            notify('danger', err.message);
        } finally {
            btn.disabled = false;
        }
    });

    qualForm.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = qualForm.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Đang tải...';
        try {
            const data = await send(qualForm.action, new FormData(qualForm));
            qualList.prepend(qualItem(data.item));
            syncEmpty(qualList, 'emptyQuals');
            qualForm.reset();
            bootstrap.Collapse.getOrCreateInstance(document.getElementById('qualificationUpload')).hide();
            notify('success', data.message);
        } catch (err) {
            notify('danger', err.message);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Tải lên';
        }
    });

    document.addEventListener('click', async e => {
        const subjBtn = e.target.closest('[data-remove-subject]');
        const qualBtn = e.target.closest('[data-remove-qual]');
        if (!subjBtn && !qualBtn) return;

        const isSubject = !!subjBtn;
        const btn = subjBtn || qualBtn;
        if (!confirm(isSubject ? 'Xóa môn dạy này?' : 'Xóa bằng cấp này?')) return;

        const list = isSubject ? subjectList : qualList;
        const id = isSubject ? btn.dataset.removeSubject : btn.dataset.removeQual;
        const row = btn.closest(isSubject ? '.subject-chip' : '.qual-item');

        btn.disabled = true;
        try {
            const data = await send(list.dataset.removeUrl, new URLSearchParams({ id }));
            row.remove();
            syncEmpty(list, isSubject ? 'emptySubjects' : 'emptyQuals');
            notify('success', data.message);
        } catch (err) {
            notify('danger', err.message);
            btn.disabled = false;
        }
    });

    const avatarInput = document.getElementById('avatarFileInput');
    const avatarImg = document.getElementById('tutorAvatarImg');
    const avatarSpinner = document.getElementById('avatarSpinner');

    if (avatarInput && avatarImg) {
        avatarInput.addEventListener('change', async () => {
            const file = avatarInput.files?.[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                notify('danger', 'Kích thước ảnh tối đa là 5 MB.');
                avatarInput.value = '';
                return;
            }

            const formData = new FormData();
            formData.append('avatarFile', file);

            avatarSpinner.style.display = 'flex';
            try {
                const res = await send('@Url.Action("UploadAvatar", "TutorProfile")', formData);
                if (res.avatarUrl) {
                    avatarImg.src = res.avatarUrl;
                    document.querySelectorAll('[data-role="avatar-img"], [data-role="avatar"]').forEach(img => {
                        img.src = res.avatarUrl;
                        img.classList.remove('d-none');
                    });
                }
                notify('success', res.message || 'Cập nhật ảnh đại diện thành công!');
            } catch (err) {
                notify('danger', err.message || 'Không thể tải ảnh lên.');
            } finally {
                avatarSpinner.style.display = 'none';
                avatarInput.value = '';
            }
        });
    }
})();
</script>