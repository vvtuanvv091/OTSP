@model System.Collections.Generic.List<PROJECT_OTSP.Dtos.TutorAvailabilityDto>
@inject PROJECT_OTSP.Services.IScheduleBlockService BlockService

@{
    var days = new[]
    {
        System.DayOfWeek.Monday, System.DayOfWeek.Tuesday, System.DayOfWeek.Wednesday,
        System.DayOfWeek.Thursday, System.DayOfWeek.Friday, System.DayOfWeek.Saturday,
        System.DayOfWeek.Sunday
    };
    var dayLabels = new System.Collections.Generic.Dictionary<System.DayOfWeek, string>
    {
        [System.DayOfWeek.Monday] = "T2",
        [System.DayOfWeek.Tuesday] = "T3",
        [System.DayOfWeek.Wednesday] = "T4",
        [System.DayOfWeek.Thursday] = "T5",
        [System.DayOfWeek.Friday] = "T6",
        [System.DayOfWeek.Saturday] = "T7",
        [System.DayOfWeek.Sunday] = "CN"
    };
    var busySlotKeys = ViewBag.BusySlotKeys as System.Collections.Generic.HashSet<string>
                       ?? new System.Collections.Generic.HashSet<string>(System.StringComparer.Ordinal);

    var blocks = BlockService.Blocks;
    System.Func<int, string> periodOf = startHour => startHour < 12 ? "Sáng" : startHour < 17 ? "Chiều" : "Tối";
    var periodSpan = blocks
        .GroupBy(b => periodOf(b.Start))
        .ToDictionary(g => g.Key, g => g.Count());

    var freeBlockCount = 0;
    var freeHourCount = 0;
    foreach (var day in days)
    {
        foreach (var block in blocks)
        {
            var key = $"{(int)day}:{block.Start}";
            var start = new System.TimeOnly(block.Start, 0);
            var end = new System.TimeOnly(block.End, 0);
            if (!busySlotKeys.Contains(key)
                && Model.Exists(x => x.DayOfWeek == day && x.StartTime <= start && x.EndTime >= end))
            {
                freeBlockCount++;
                freeHourCount += block.Hours;
            }
        }
    }
}

<style>
    .availability-page {
        padding: 1.75rem 2rem;
        border-radius: 12px;
        --availability-accent: var(--bs-success);
        --availability-accent-text: var(--bs-success-text-emphasis);
        --availability-accent-soft: var(--bs-success-bg-subtle);
        --availability-accent-border: var(--bs-success-border-subtle);
        --availability-border: var(--bs-border-color);
        --availability-busy-bg: var(--bs-secondary-bg);
        min-height: calc(100vh - 148px);
            background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
    }

        .availability-page .availability-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 240px;
            gap: 16px;
            align-items: start;
        }

        .availability-page .availability-card {
            background: var(--bs-body-bg);
            border: 1px solid var(--availability-border);
            border-radius: 4px;
        }

        .availability-page .availability-table-wrap {
            overflow-x: auto;
        }

        .availability-page .availability-table {
            width: 100%;
            min-width: 650px;
            table-layout: fixed;
            border-collapse: separate;
            border-spacing: 3px 4px;
            font-size: 12px;
        }

            .availability-page .availability-table th {
                padding: 3px 2px;
                color: var(--bs-body-color);
                font-weight: 500;
                text-align: center;
                white-space: nowrap;
            }

                .availability-page .availability-table th.period-column {
                    width: 43px;
                }

                .availability-page .availability-table th.time-column {
                    width: 100px;
                }

            .availability-page .availability-table td {
                padding: 0 1px;
                text-align: center;
            }

        .availability-page .period-label {
            color: var(--availability-accent);
            font-size: 11px;
            font-weight: 600;
        }

        .availability-page .time-label {
            color: var(--bs-secondary-color);
            font-size: 11px;
            white-space: nowrap;
        }

        .availability-page .availability-table td.rest-cell {
            padding: 5px 4px;
            border-radius: 3px;
                background: var(--bs-tertiary-bg);
            color: var(--bs-secondary-color);
            font-size: 11px;
        }
        .availability-page .availability-slot {
            position: relative;
            display: flex;
            width: 100%;
            min-height: 38px;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--availability-border);
            border-radius: 3px;
            background: var(--bs-body-bg);
            color: var(--availability-accent);
            cursor: pointer;
            font-size: 11px;
            line-height: 1;
        }

            .availability-page .availability-slot.is-selected {
                border-color: var(--availability-accent-border);
                background-color: #E6F4EA;
                color: var(--availability-accent-text);
            }

            .availability-page .availability-slot:focus-within {
                outline: 2px solid rgba(var(--bs-success-rgb), .35);
            }

        .availability-page .slot-checkbox {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
        }

        .availability-page .availability-slot.is-busy {
            border-color: var(--availability-border);
            background: var(--availability-busy-bg);
            color: var(--bs-secondary-color);
            cursor: not-allowed;
        }

        .availability-page .availability-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            color: var(--bs-secondary-color);
            font-size: 12px;
        }

        .availability-page .legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .availability-page .legend-swatch {
            width: 12px;
            height: 12px;
            border: 1px solid var(--availability-border);
            border-radius: 2px;
            background: var(--bs-body-bg);
        }

            .availability-page .legend-swatch.is-free {
                border-color: var(--availability-accent-border);
                background: var(--availability-accent-soft);
            }

            .availability-page .legend-swatch.is-busy {
                border-color: var(--availability-border);
                background: var(--availability-busy-bg);
            }

        .availability-page .summary-hours {
            color: var(--availability-accent);
            font-size: 21px;
            font-weight: 700;
        }

        .availability-page .quick-action {
            width: 100%;
            border: 1px solid var(--availability-accent);
            border-radius: 3px;
            background: var(--bs-body-bg);
            color: var(--availability-accent);
            font-size: 12px;
            padding: 7px 8px;
        }

        .availability-page .save-action {
            width: 100%;
            border: 0;
            border-radius: 3px;
            background: var(--availability-accent);
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            padding: 9px 10px;
        }

        .availability-page .quick-action:hover {
            background: var(--availability-accent-soft);
        }

        .availability-page .save-action:hover {
            filter: brightness(.9);
        }
        .availability-slot.is-busy{
              background-color: #DB303A !important;
              border-color: #DB303A !important;
              color: #ffffff !important;
        }
    @@media (max-width: 991.98px) {
        .availability-page .availability-layout {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .availability-page .availability-mobile-day-picker {
        display: none;
    }

    .availability-page .availability-day-button {
        border: 1px solid var(--availability-border);
        border-radius: var(--bs-border-radius);
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        padding: .45rem .6rem;
        font-size: .85rem;
    }

        .availability-page .availability-day-button[aria-pressed="true"] {
            border-color: var(--availability-accent);
            background: var(--availability-accent);
            color: #fff;
        }

    @@media (max-width: 767.98px) {
        .availability-page {
        padding: 1.75rem 2rem;
        border-radius: 12px;
            min-height: 0;
            padding: 1rem .65rem !important;
        }

            .availability-page .availability-layout {
                display: flex;
                flex-direction: column;
                gap: .75rem;
            }

                .availability-page .availability-layout aside {
                    order: 0;
                    width: 100%;
                }

                .availability-page .availability-layout section {
                    order: 1;
                    width: 100%;
                }

            .availability-page .availability-mobile-day-picker {
                display: flex;
                gap: .3rem;
                overflow-x: auto;
                padding: .1rem .1rem .5rem;
                scrollbar-width: thin;
            }

            .availability-page .availability-day-button {
                flex: 1 0 auto;
                min-width: 2.35rem;
                padding: .4rem .35rem;
            }

            .availability-page .availability-table {
                min-width: 100%;
                border-spacing: 2px 4px;
                font-size: .72rem;
            }

                .availability-page .availability-table th.period-column {
                    width: 2.45rem;
                }

                .availability-page .availability-table th.time-column {
                    width: 5.6rem;
                }

                .availability-page .availability-table th[data-day-column],
                .availability-page .availability-table td[data-day-column] {
                    display: none;
                }

            .availability-page[data-active-day="1"] .availability-table [data-day-column="1"],
            .availability-page[data-active-day="2"] .availability-table [data-day-column="2"],
            .availability-page[data-active-day="3"] .availability-table [data-day-column="3"],
            .availability-page[data-active-day="4"] .availability-table [data-day-column="4"],
            .availability-page[data-active-day="5"] .availability-table [data-day-column="5"],
            .availability-page[data-active-day="6"] .availability-table [data-day-column="6"],
            .availability-page[data-active-day="0"] .availability-table [data-day-column="0"] {
                display: table-cell;
            }

            .availability-page .availability-slot {
                min-height: 2.4rem;
                font-size: .75rem;
            }

            .availability-page .availability-card {
                max-width: 100%;
            }

            .availability-page .summary-hours {
                font-size: 1.2rem;
            }
    }
</style>

<div class="container-fluid py-4 availability-page" data-active-day="1">
    <div class="mb-3">
        <h1 class="h4 mb-1">Lịch rảnh hàng tuần</h1>
        <p class="text-muted small mb-0">Chọn các khối bạn có thể dạy. Mỗi ô là một buổi học 2 tiếng, theo giờ Việt Nam (GMT+7).</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success py-2" role="status">@success</div>
    }

    <form asp-action="Save" method="post" asp-antiforgery="false">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SelectedSlotKeys" value="" />

        <div class="availability-legend mb-3">
            <span class="legend-item"><span class="legend-swatch is-free"></span>Rảnh - có thể nhận lớp</span>
            <span class="legend-item"><span class="legend-swatch is-busy"></span>Đã có lớp</span>
            <span class="legend-item"><span class="legend-swatch"></span>Không dạy</span>
        </div>

        <div class="availability-layout">
            <section class="availability-card p-2" aria-label="Bảng lịch rảnh hàng tuần">
                <div class="availability-mobile-day-picker" role="group" aria-label="Chọn ngày trong tuần">
                    @foreach (var day in days)
                    {
                        var active = day == System.DayOfWeek.Monday;
                        <button type="button" class="availability-day-button"
                                data-mobile-day="@((int)day)" aria-pressed="@(active ? "true" : "false")">
                            @dayLabels[day]
                        </button>
                    }
                </div>
                <div class="availability-table-wrap">
                    <table class="availability-table mb-0">
                        <thead>
                            <tr>
                                <th class="period-column" scope="col"></th>
                                <th class="time-column" scope="col"></th>
                                @foreach (var day in days)
                                {
                                    var dayLabel = day == System.DayOfWeek.Sunday ? "Chủ nhật" : $"Thứ {(int)day + 1}";
                                    <th scope="col" data-day-column="@((int)day)">@dayLabel</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < blocks.Count; i++)
                            {
                                var block = blocks[i];
                                var period = periodOf(block.Start);
                                var isFirstOfPeriod = i == 0 || periodOf(blocks[i - 1].Start) != period;
                               

                                <tr>
                                    @if (isFirstOfPeriod)
                                    {
                                        <th class="period-label" scope="rowgroup" rowspan="@periodSpan[period]">@period</th>
                                    }
                                    <th class="time-label" scope="row">@block.Label</th>
                                    @foreach (var day in days)
                                    {
                                        var slotKey = $"{(int)day}:{block.Start}";
                                        var isBusy = busySlotKeys.Contains(slotKey);
                                        var slotStart = new System.TimeOnly(block.Start, 0);
                                        var slotEnd = new System.TimeOnly(block.End, 0);
                                        var isSelected = !isBusy && Model.Exists(x => x.DayOfWeek == day
                                                                                  && x.StartTime <= slotStart
                                                                                  && x.EndTime >= slotEnd);
                                        if (isBusy)
                                        {
                                            <td data-day-column="@((int)day)"><div class="availability-slot is-busy" title="Đã có lớp trong khung giờ này"><span class="slot_color_text">Có lớp</span></div></td>
                                        }
                                        else
                                        {
                                            <td data-day-column="@((int)day)">
                                                <label class="availability-slot @(isSelected ? "is-selected" : "")">
                                                    <input class="slot-checkbox slot-toggle" type="checkbox" name="SelectedSlotKeys"
                                                           value="@slotKey" data-hours="@block.Hours" checked="@isSelected"
                                                           aria-label="Chọn @dayLabels[day] @block.Label" />
                                                    <span>@(isSelected ? "Rảnh" : "")</span>
                                                </label>
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <aside class="availability-card p-3" aria-label="Tóm tắt lịch rảnh">
                <h2 class="h6 text-muted mb-3">Tóm tắt tuần</h2>
                <div class="summary-hours mb-1"><span id="free-block-count">@freeBlockCount</span> buổi rảnh / tuần</div>
                <p class="small text-muted mb-1">tương đương <span id="free-hour-count">@freeHourCount</span> giờ dạy</p>
                <p class="small text-muted mb-3"><span>@busySlotKeys.Count</span> buổi đã có lớp - không thể bỏ chọn</p>
                <div class="small fw-semibold mb-2">Chọn nhanh</div>
                <div class="d-grid gap-2">
                    <button type="button" class="quick-action" data-quick-action="weeknights">Tối các ngày thường (17:00 – 21:00)</button>
                    <button type="button" class="quick-action" data-quick-action="weekend">Cuối tuần cả ngày (08:00 – 17:00)</button>
                    <button type="button" class="quick-action" data-quick-action="clear">Xóa tất cả</button>
                    <button type="submit" class="save-action mt-1">Lưu lịch rảnh</button>

                    <div class="mt-3 p-3 rounded border border-danger-subtle bg-danger-subtle text-dark text-start">
                        <div class="fw-bold text-danger small mb-1">
                            <i class="bi bi-calendar-plus-fill me-1"></i>Tự tạo lịch học / Dạy bù
                        </div>
                        <p class="small text-muted mb-2" style="font-size: 11px;">
                            Khi bạn bận hoặc cần xếp lịch dạy bù cho học viên, hãy sử dụng chức năng <strong>Tự tạo lịch học / Dạy bù</strong> trong trang Lịch dạy.
                        </p>
                        <a asp-controller="TutorSchedule" asp-action="Index" class="btn btn-sm btn-danger w-100" style="font-size: 12px;">
                            <i class="bi bi-arrow-right-circle me-1"></i>Sang Lịch dạy &amp; Tạo lịch bù
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </form>
</div>

<script>
    (() => {
        const page = document.querySelector('.availability-page');
        const form = page?.querySelector('form');
        if (!form) return;

        const slots = Array.from(form.querySelectorAll('.slot-toggle'));
        const blockCount = document.getElementById('free-block-count');
        const hourCount = document.getElementById('free-hour-count');

        form.querySelectorAll('[data-mobile-day]').forEach(button => {
            button.addEventListener('click', () => {
                page.dataset.activeDay = button.dataset.mobileDay;
                form.querySelectorAll('[data-mobile-day]').forEach(dayButton => {
                    dayButton.setAttribute('aria-pressed', String(dayButton === button));
                });
            });
        });

        const refreshSlot = checkbox => {
            const label = checkbox.closest('.availability-slot');
            label.classList.toggle('is-selected', checkbox.checked);
            label.querySelector('span').textContent = checkbox.checked ? 'Rảnh' : '';
        };

        const refreshCount = () => {
            const picked = slots.filter(slot => slot.checked);
            blockCount.textContent = picked.length;
            hourCount.textContent = picked.reduce((sum, slot) => sum + Number(slot.dataset.hours || 0), 0);
        };

        form.addEventListener('change', event => {
            if (!event.target.matches('.slot-toggle')) return;
            refreshSlot(event.target);
            refreshCount();
        });

        form.querySelectorAll('[data-quick-action]').forEach(button => {
            button.addEventListener('click', () => {
                const action = button.dataset.quickAction;
                for (const slot of slots) {
                    const [day, hour] = slot.value.split(':').map(Number);
                    if (action === 'clear') {
                        slot.checked = false;
                    } else if (action === 'weeknights' && day >= 1 && day <= 5 && hour >= 17 && hour <= 19) {
                        slot.checked = true;
                    } else if (action === 'weekend' && (day === 6 || day === 0) && hour >= 8 && hour <= 15) {
                        slot.checked = true;
                    }
                    refreshSlot(slot);
                }
                refreshCount();
            });
        });
    })();
</script>
