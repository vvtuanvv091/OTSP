                                                <span class="rounded bg-body-secondary d-inline-flex align-items-center justify-content-center" style="width:52px;height:40px">
                                                    <i class="bi bi-image text-body-secondary" aria-hidden="true"></i>
                                                </span>
                                            }
                                            <span class="fw-semibold">@classroom.Name</span>
                                        </div>
