@using static PROJECT_OTSP.Models.Enums
@model IReadOnlyList<PROJECT_OTSP.Dtos.ClassroomListItemVm>

@{
    ViewData["Title"] = "Quản lý lớp nhóm";
    var selectedStatus = ViewBag.SelectedStatus is ClassroomStatus value ? value : (ClassroomStatus?)null;
    var money = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Quản lý lớp nhóm</h1>
            <p class="text-body-secondary mb-0">Tạo lớp, cập nhật thông tin và theo dõi số chỗ còn nhận học viên.</p>
        </div>
        <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Create" class="btn btn-danger">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Tạo lớp nhóm
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Warning"] is string warningMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>@warningMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <form asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
                <div class="col-12 col-sm-5 col-md-3">
                    <label for="statusFilter" class="form-label">Lọc trạng thái</label>
                    <select id="statusFilter" name="status" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Active" selected="@(selectedStatus == ClassroomStatus.Active)">Đang tuyển sinh</option>
                        <option value="Completed" selected="@(selectedStatus == ClassroomStatus.Completed)">Đã hoàn thành</option>
                        <option value="Cancelled" selected="@(selectedStatus == ClassroomStatus.Cancelled)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-outline-secondary">Lọc</button>
                    <a asp-action="Index" class="btn btn-link">Xóa lọc</a>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <div class="text-center text-body-secondary py-5">
                    <i class="bi bi-easel fs-1 d-block mb-2" aria-hidden="true"></i>
                    Chưa có lớp nhóm phù hợp.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Lớp học</th>
                                <th scope="col">Môn - Cấp</th>
                                <th scope="col">Học phí</th>
                                <th scope="col">Sĩ số</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Ngày bắt đầu</th>
                                <th scope="col" class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var classroom in Model)
                            {
                                var statusLabel = classroom.Status switch
                                {
                                    ClassroomStatus.Active => "Đang tuyển sinh",
                                    ClassroomStatus.Completed => "Đã hoàn thành",
                                    ClassroomStatus.Cancelled => "Đã hủy",
                                    _ => classroom.Status.ToString()
                                };
                                var statusClass = classroom.Status switch
                                {
                                    ClassroomStatus.Active => "text-bg-success",
                                    ClassroomStatus.Completed => "text-bg-secondary",
                                    _ => "text-bg-danger"
                                };
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(classroom.CoverImageUrl))
                                            {
                                                <img src="@classroom.CoverImageUrl" alt="" width="52" height="40" class="rounded object-fit-cover" />
                                            }
