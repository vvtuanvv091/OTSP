@using static PROJECT_OTSP.Models.Enums
@model IReadOnlyList<PROJECT_OTSP.Dtos.ClassroomListItemVm>

@{
    ViewData["Title"] = "Quản lý lớp học";
    var selectedStatus = ViewBag.SelectedStatus is ClassroomStatus value ? value : (ClassroomStatus?)null;
    var money = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<style>
    .tutor-classroom-card {
        transition: all 0.2s ease;
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
    }
    .tutor-classroom-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
        transform: translateY(-1px);
    }
    .tutor-fee-badge {
        background-color: #FAFAFA;
        border: 1px solid #F1F5F9;
        min-width: 76px;
        height: 62px;
    }
    .progress-bar-custom {
        background-color: #C12026;
        border-radius: 999px;
    }
</style>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Quản lý lớp học</h1>
            <p class="text-secondary mb-0">Quản lý các lớp đang dạy (lớp 1-1 và lớp nhóm), lịch dạy và học viên.</p>
        </div>
        <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Create" class="btn btn-danger">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Tạo lớp nhóm
        </a>
    </div>

    <!-- Thông báo hệ thống -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Warning"] is string warningMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>@warningMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Bộ Lọc Trạng Thái -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
            <form asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-12 col-sm-auto">
                    <span class="small fw-semibold text-secondary me-2"><i class="bi bi-funnel me-1"></i>Lọc trạng thái:</span>
                </div>
                <div class="col-12 col-sm-4 col-md-3">
                    <select id="statusFilter" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Active" selected="@(selectedStatus == ClassroomStatus.Active)">Đang tuyển sinh / Đang dạy</option>
                        <option value="Completed" selected="@(selectedStatus == ClassroomStatus.Completed)">Đã hoàn thành</option>
                        <option value="Cancelled" selected="@(selectedStatus == ClassroomStatus.Cancelled)">Đã hủy</option>
                    </select>
                </div>
                @if (selectedStatus.HasValue)
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-danger p-0 ms-1">
                            <i class="bi bi-x-circle me-1"></i>Xóa lọc
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Danh Sách Lớp Học Dạng Lưới 3x3 Card (Chuẩn hình 2 & Bổ sung Avatar) -->
    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-secondary">
            <i class="bi bi-easel fs-1 d-block mb-2 text-muted" aria-hidden="true"></i>
            <h3 class="h5 fw-bold text-dark">Chưa có lớp học nào phù hợp</h3>
            <p class="small text-muted mb-3">Bạn chưa có lớp học nào trong danh mục hoặc trạng thái đã chọn.</p>
            <div>
                <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Create" class="btn btn-danger btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Tạo lớp nhóm mới
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
            @foreach (var classroom in Model)
            {
                var statusLabel = classroom.Status switch
                {
                    ClassroomStatus.Active => "Đang mở",
                    ClassroomStatus.Completed => "Đã hoàn thành",
                    ClassroomStatus.Cancelled => "Đã hủy",
                    _ => classroom.Status.ToString()
                };
                var statusBadge = classroom.Status switch
                {
                    ClassroomStatus.Active => "bg-success-subtle text-success border border-success-subtle",
                    ClassroomStatus.Completed => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                    _ => "bg-danger-subtle text-danger border border-danger-subtle"
                };

                <div class="col">
                    <div class="card tutor-classroom-card h-100 rounded-3 p-3 p-sm-3.5 d-flex flex-column justify-content-between">
                        <!-- Khối trên: Avatar (nếu có) hoặc Box Học phí & Thông tin lớp học -->
                        <div>
                            <div class="d-flex align-items-start gap-2.5">
                                <!-- Avatar lớp học (Hiển thị nếu có ảnh, không có thì hiển thị box Học phí chuẩn) -->
                                @if (!string.IsNullOrWhiteSpace(classroom.CoverImageUrl))
                                {
                                    <div class="position-relative flex-shrink-0" style="width: 60px; height: 60px;">
                                        <img src="@classroom.CoverImageUrl" alt="@classroom.Name"
                                             class="w-100 h-100 rounded-3 object-fit-cover border shadow-sm"
                                             onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                                        <div class="tutor-fee-badge w-100 h-100 p-1 rounded-3 text-center d-none flex-column justify-content-center">
                                            <span class="text-secondary small" style="font-size: 0.65rem; line-height: 1.1;">Học phí</span>
                                            <span class="fw-bold text-danger" style="font-size: 0.75rem; line-height: 1.1;">
                                                @classroom.Fee.ToString("N0", money) đ
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- Box học phí thay thế khi không có ảnh (Chuẩn theo mẫu) -->
                                    <div class="tutor-fee-badge p-2 rounded-3 text-center d-flex flex-column justify-content-center flex-shrink-0"
                                         style="width: 76px; height: 60px;">
                                        <span class="text-secondary small" style="font-size: 0.72rem; line-height: 1.2;">Học phí</span>
                                        <span class="fw-bold text-danger mt-0.5" style="font-size: 0.9rem; line-height: 1.2;">
                                            @classroom.Fee.ToString("N0", money) đ
                                        </span>
                                    </div>
                                }

                                <!-- Thông tin lớp bên phải -->
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;" title="@classroom.Name - @classroom.SubjectName · @classroom.GradeLevelName">
                                            <i class="bi bi-book text-danger me-1"></i>
                                            @if (!string.IsNullOrWhiteSpace(classroom.Name))
                                            {
                                                <span class="text-dark fw-bold">@classroom.Name</span>
                                                <span class="text-secondary fw-normal ms-1" style="font-size: 0.85rem;">(@classroom.SubjectName · @classroom.GradeLevelName)</span>
                                            }
                                            else
                                            {
                                                <span>@classroom.SubjectName · @classroom.GradeLevelName</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(classroom.CoverImageUrl))
                                        {
                                            <span class="badge bg-danger-subtle text-danger fw-bold text-nowrap px-2 py-0.5" style="font-size: 0.8rem;">
                                                @classroom.Fee.ToString("N0", money) đ
                                            </span>
                                        }
                                    </div>

                                    <div class="small text-secondary text-truncate mb-1" title="@classroom.ScheduleSummary">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>Lịch học: <b>@classroom.FormattedSchedule</b>
                                    </div>

                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <span class="small text-secondary text-nowrap">
                                            <i class="bi bi-people me-1 text-muted"></i>Sĩ số: <b>@classroom.StudentCount@(classroom.Type == ClassroomType.Group ? $"/{classroom.MaxStudents}" : "") hv</b>
                                        </span>
                                        <span class="badge @(classroom.Type == ClassroomType.OneToOne ? "bg-info-subtle text-info-emphasis border border-info-subtle" : "bg-primary-subtle text-primary-emphasis border border-primary-subtle")" style="font-size: 0.68rem; padding: 2px 6px;">
                                            @(classroom.Type == ClassroomType.OneToOne ? "Lớp 1-1" : "Lớp nhóm")
                                        </span>
                                        <span class="badge @statusBadge" style="font-size: 0.68rem; padding: 2px 6px;">
                                            @statusLabel
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Khối giữa: Tiến độ giảng dạy (Thưa ra, thoáng đãng) -->
                            <div class="mt-3 pt-2.5 border-top">
                                <div class="d-flex justify-content-between align-items-center small mb-1.5">
                                    <span class="text-secondary" style="font-size: 0.8rem;">Tiến độ giảng dạy</span>
                                    <span class="fw-bold text-dark" style="font-size: 0.825rem;">
                                        @classroom.CompletedSessions/@classroom.TotalSessions buổi
                                    </span>
                                </div>
                                <div class="progress" style="height: 6px; background-color: #E2E8F0; border-radius: 999px;">
                                    <div class="progress-bar progress-bar-custom" role="progressbar"
                                         style="width: @classroom.ProgressPercent%;"
                                         aria-valuenow="@classroom.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Khối dưới: Nút Tài liệu lớp bên trái, Nút Sửa lớp & Lịch dạy bên phải -->
                        <div class="d-flex align-items-center justify-content-between gap-2 mt-3 pt-3 border-top">
                            <!-- Nút Tài liệu lớp bên trái (text-nowrap chống rớt dòng trên mobile) -->
                            <a asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Index" asp-route-classroomId="@classroom.Id"
                               class="btn btn-sm btn-outline-secondary px-2.5 px-sm-3 py-1.5 d-inline-flex align-items-center gap-1 rounded-2 text-nowrap flex-shrink-0"
                               style="font-size: 0.825rem; white-space: nowrap;" title="Xem tài liệu lớp học">
                                <i class="bi bi-folder2-open"></i><span class="d-none d-sm-inline">Tài liệu lớp</span><span class="d-inline d-sm-none">Tài liệu</span>
                            </a>

                            <!-- Nhóm nút bên phải: Sửa lớp, Lịch dạy & Thao tác mở rộng -->
                            <div class="d-flex align-items-center" style="gap: 6px;">
                                @if (classroom.Status is not ClassroomStatus.Cancelled and not ClassroomStatus.Completed)
                                {
                                    <a asp-action="Edit" asp-route-id="@classroom.Id"
                                       class="btn btn-sm btn-outline-danger px-2.5 px-sm-3 py-1.5 rounded-2 text-nowrap"
                                       style="font-size: 0.825rem; white-space: nowrap;">
                                        Sửa lớp
                                    </a>
                                }

                                <a asp-area="Tutor" asp-controller="TutorSchedule" asp-action="Index"
                                   class="btn btn-sm btn-danger px-2.5 px-sm-3 py-1.5 rounded-2 text-nowrap"
                                   style="font-size: 0.825rem; white-space: nowrap;">
                                    Lịch dạy
                                </a>

                                <!-- Menu thao tác bổ sung -->
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border px-2 py-1.5 rounded-2 text-secondary d-flex align-items-center justify-content-center"
                                            type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thao tác khác" style="height: 32px; width: 32px;">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border small">
                                        <li>
                                            <a class="dropdown-item py-1.5" asp-action="Edit" asp-route-id="@classroom.Id">
                                                <i class="bi bi-pencil me-2 text-primary"></i>Chỉnh sửa thông tin
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-1.5" asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Index" asp-route-classroomId="@classroom.Id">
                                                <i class="bi bi-folder2 me-2 text-secondary"></i>Quản lý tài liệu
                                            </a>
                                        </li>
                                        @if (classroom.Status is not ClassroomStatus.Cancelled and not ClassroomStatus.Completed)
                                        {
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <form asp-action="Cancel" asp-route-id="@classroom.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('@(classroom.CanHardDelete ? "Xóa vĩnh viễn lớp này? Dữ liệu lớp và lịch học sẽ bị xóa hoàn toàn khỏi hệ thống." : "Hủy lớp này và thông báo cho học viên?")');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-1.5 text-danger">
                                                        <i class="bi bi-x-circle me-2"></i>@(classroom.CanHardDelete ? "Xóa lớp học" : "Hủy lớp học")
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        else if (classroom.Status == ClassroomStatus.Cancelled && classroom.CanHardDelete)
                                        {
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <form asp-action="Cancel" asp-route-id="@classroom.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('Xóa vĩnh viễn lớp đã hủy này khỏi hệ thống?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-1.5 text-danger">
                                                        <i class="bi bi-trash me-2"></i>Xóa vĩnh viễn
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang lưới 3x3 đồng bộ (PaginationVm & _PaginationBar) -->
        @if (ViewBag.Pagination is PROJECT_OTSP.Dtos.PaginationVm pagination && pagination.TotalPages > 1)
        {
            <div class="mt-4 pt-2">
                @await Html.PartialAsync("_PaginationBar", pagination)
            </div>
        }
    }
</div>
