@model PROJECT_OTSP.Dtos.ClassroomFormVm

@{
    ViewData["Title"] = "Sửa lớp nhóm";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Sửa lớp nhóm</h1>
        <p class="text-body-secondary mb-0">Kiểm tra thông tin trước khi lưu thay đổi.</p>
    </div>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning" role="alert">@errorMessage</div>
    }

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <partial name="_Form" model="Model" />
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
