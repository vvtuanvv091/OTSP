@model PROJECT_OTSP.Dtos.ClassroomFormVm
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    var actionName = isEdit ? "Edit" : "Create";
    var money = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var currentHours = Model.HoursPerSession >= 10.0 ? Model.HoursPerSession / 10.0 : (Model.HoursPerSession > 0 ? Model.HoursPerSession : 2.0);
}

<form asp-area="Tutor" asp-controller="TutorClassroom" asp-action="@actionName" asp-route-id="@(isEdit ? Model.Id : null)" method="post" enctype="multipart/form-data">
    @if (isEdit)
    {
        <input asp-for="Id" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger mb-3 py-2 px-3"></div>
    }

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-semibold"></label>
        <input asp-for="Name" class="form-control" maxlength="200" autocomplete="off" placeholder="Ví dụ: Lớp Toán nâng cao / Lớp Tiếng Anh giao tiếp..." />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SubjectGradeKey" class="form-label fw-semibold"></label>
        @if (isEdit && !Model.CanChangeSubjectGrade)
        {
            <div class="form-control-plaintext fw-semibold text-danger">
                <i class="bi bi-book me-1"></i>@Model.SubjectGradeLabel
            </div>
            <input asp-for="SubjectGradeKey" type="hidden" />
            <div class="form-text small text-muted">Không thể đổi môn/cấp vì lớp đã có học viên hoặc yêu cầu kết nối.</div>
        }
        else
        {
            <select asp-for="SubjectGradeKey" asp-items="Model.SubjectGradeOptions" class="form-select">
                <option value="">-- Chọn môn và cấp học --</option>
            </select>
        }
        <span asp-validation-for="SubjectGradeKey" class="text-danger small"></span>
    </div>

    <!-- KHỐI GỘP ẢNH BÌA LỚP HỌC (TẢI TỆP HOẶC DÁN URL KÈM XEM TRƯỚC TRỰC QUAN) -->
    <div class="card mb-4 border border-light-subtle shadow-sm rounded-3">
        <div class="card-body p-3">
            <label class="form-label fw-bold text-dark d-flex align-items-center justify-content-between mb-2">
                <span><i class="bi bi-image text-danger me-1"></i> Ảnh bìa lớp học</span>
                <span class="badge bg-light text-secondary border fw-normal" style="font-size:11px;">Tùy chọn</span>
            </label>

            <div class="row g-3 align-items-center">
                <!-- Cột xem trước ảnh -->
                <div class="col-12 col-md-4 text-center">
                    <div class="cover-image-preview-wrapper p-2 bg-light border rounded-3 position-relative d-flex align-items-center justify-content-center" style="min-height: 140px; max-height: 160px; overflow: hidden;">
                        <img id="coverImagePreview" 
                             src="@(!string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl) ? Model.CurrentCoverImageUrl : (!string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? Model.CoverImageUrl : ""))" 
                             data-initial="@(Model.CurrentCoverImageUrl ?? "")"
                             alt="Xem trước ảnh bìa" 
                             class="img-fluid rounded @(string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl) && string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "d-none" : "")" 
                             style="max-height: 140px; width: 100%; object-fit: cover;" />
                        
                        <div id="coverImagePlaceholder" class="text-muted small @(!string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl) || !string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "d-none" : "")">
                            <i class="bi bi-card-image fs-1 d-block text-secondary opacity-50 mb-1"></i>
                            <span>Chưa có ảnh bìa</span>
                        </div>
                    </div>
                    @if (isEdit && !string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl))
                    {
                        <div class="form-check mt-2 text-start">
                            <input asp-for="RemoveCoverImage" class="form-check-input" id="removeCoverCheck" />
                            <label asp-for="RemoveCoverImage" class="form-check-label small text-danger cursor-pointer" for="removeCoverCheck">
                                <i class="bi bi-trash3 me-1"></i>Xóa ảnh bìa hiện tại
                            </label>
                        </div>
                    }
                </div>

                <!-- Cột chọn phương thức tải ảnh -->
                <div class="col-12 col-md-8">
                    <!-- Nút chuyển đổi: Tải từ máy tính VS Dán liên kết ảnh -->
                    <div class="btn-group btn-group-sm w-100 mb-2" role="group">
                        <input type="radio" class="btn-check" name="coverImageMode" id="modeUpload" autocomplete="off" checked>
                        <label class="btn btn-outline-danger" for="modeUpload"><i class="bi bi-upload me-1"></i> Tải ảnh từ máy tính</label>

                        <input type="radio" class="btn-check" name="coverImageMode" id="modeUrl" autocomplete="off">
                        <label class="btn btn-outline-danger" for="modeUrl"><i class="bi bi-link-45deg me-1"></i> Dán liên kết ảnh (URL)</label>
                    </div>

                    <!-- Lựa chọn 1: Tải tệp trực tiếp -->
                    <div id="uploadInputBox">
                        <input asp-for="CoverImageFile" id="coverImageFileInput" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <div class="form-text small text-muted mt-1" style="font-size:11px;">
                            <i class="bi bi-info-circle me-1"></i>Định dạng JPG, PNG hoặc WebP; dung lượng tối đa 5 MB.
                        </div>
                        <span asp-validation-for="CoverImageFile" class="text-danger small"></span>
                    </div>

                    <!-- Lựa chọn 2: Dán URL ảnh -->
                    <div id="urlInputBox" class="d-none">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-link"></i></span>
                            <input asp-for="CoverImageUrl" id="coverImageUrlInput" class="form-control" type="url" maxlength="500" placeholder="https://example.com/anh-lop.jpg" />
                        </div>
                        <div class="form-text small text-muted mt-1" style="font-size:11px;">
                            <i class="bi bi-info-circle me-1"></i>Nhập đường dẫn trực tiếp tới ảnh (bắt đầu bằng http:// hoặc https://).
                        </div>
                        <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="Fee" class="form-label fw-semibold"></label>
            @if (isEdit && !Model.CanChangeFee)
            {
                <input class="form-control" value="@Model.Fee.ToString("N0", money)" disabled />
                <input asp-for="Fee" type="hidden" />
                <div class="form-text small text-muted">Không thể sửa học phí vì lớp đã có thanh toán thành công.</div>
            }
            else
            {
                <input asp-for="Fee" class="form-control" type="number" min="1" step="1" />
            }
            <span asp-validation-for="Fee" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="MaxStudents" class="form-label fw-semibold"></label>
            @if (Model.IsOneToOne)
            {
                <input asp-for="MaxStudents" type="hidden" value="1" />
                <div class="form-control bg-light d-flex align-items-center justify-content-between border">
                    <span class="text-dark fw-bold"><i class="bi bi-person me-1 text-danger"></i>1 học viên</span>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                        <i class="bi bi-lock-fill me-1"></i>Lớp 1 kèm 1 (Cố định 1 học viên)
                    </span>
                </div>
                <div class="form-text small text-muted">Lớp 1 kèm 1 có sĩ số cố định là 1 học viên.</div>
            }
            else
            {
                <input asp-for="MaxStudents" class="form-control" type="number" min="2" max="50" step="1" />
                <span asp-validation-for="MaxStudents" class="text-danger small"></span>
                <div class="form-text small text-muted">Sĩ số lớp nhóm từ 2 đến 50 học viên.</div>
            }
        </div>
    </div>

    <!-- Cấu hình lịch học các buổi trong tuần (Buổi 1, 2, 3...) -->
    <div class="card bg-light border-0 mb-4 p-3 rounded-3">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <div>
                <h5 class="h6 mb-0 fw-bold text-danger">
                    <i class="bi bi-calendar-week me-1"></i> Thiết lập lịch học cố định theo buổi / tuần
                </h5>
                <small class="text-muted">Quy định số buổi học trong tuần, thứ và thời gian từng buổi</small>
            </div>
            @if (Model.IsOneToOne)
            {
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                    <i class="bi bi-person-check me-1"></i>Lớp 1 kèm 1
                </span>
            }
            else
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lớp nhóm cố định</span>
            }
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="SessionsPerWeek" class="form-label fw-semibold">Số buổi học / tuần <span class="text-danger">*</span></label>
                <select asp-for="SessionsPerWeek" class="form-select" id="sessionsPerWeekSelect">
                    <option value="1">1 buổi / tuần</option>
                    <option value="2">2 buổi / tuần</option>
                    <option value="3">3 buổi / tuần</option>
                    @if (!Model.IsOneToOne)
                    {
                        <option value="4">4 buổi / tuần</option>
                        <option value="5">5 buổi / tuần</option>
                    }
                </select>
                <span asp-validation-for="SessionsPerWeek" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="HoursPerSession" class="form-label fw-semibold">Thời lượng mỗi buổi (tiếng)</label>
                <select name="HoursPerSession" class="form-select" id="hoursPerSessionSelect">
                    <option value="1" selected="@(Math.Abs(currentHours - 1.0) < 0.05 ? "selected" : null)">1.0 giờ (60 phút)</option>
                    <option value="1.5" selected="@(Math.Abs(currentHours - 1.5) < 0.05 ? "selected" : null)">1.5 giờ (90 phút)</option>
                    <option value="2" selected="@(Math.Abs(currentHours - 2.0) < 0.05 ? "selected" : null)">2.0 giờ (120 phút)</option>
                    <option value="2.5" selected="@(Math.Abs(currentHours - 2.5) < 0.05 ? "selected" : null)">2.5 giờ (150 phút)</option>
                    <option value="3" selected="@(Math.Abs(currentHours - 3.0) < 0.05 ? "selected" : null)">3.0 giờ (180 phút)</option>
                </select>
                <span asp-validation-for="HoursPerSession" class="text-danger small"></span>
                <div class="form-text small text-danger">Thời lượng mỗi buổi học nên từ 1 đến 3 giờ (chuẩn 2 giờ/buổi).</div>
            </div>
        </div>

        <!-- Danh sách chi tiết từng buổi học -->
        <label class="form-label fw-semibold mb-2">Chi tiết khung giờ từng buổi trong tuần:</label>
        <div id="weeklySchedulesContainer" class="d-flex flex-column gap-2">
            @for (int i = 0; i < Model.WeeklySchedules.Count; i++)
            {
                var schedule = Model.WeeklySchedules[i];
                var durationHours = currentHours;
                if (schedule.EndTime > schedule.StartTime)
                {
                    var diff = (schedule.EndTime - schedule.StartTime).TotalHours;
                    if (diff > 0)
                    {
                        durationHours = diff;
                    }
                }
                <div class="schedule-row p-3 border rounded-3 bg-white shadow-sm" data-index="@i">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-danger text-white">Buổi @(i + 1)</span>
                        <small class="text-muted session-duration-text">Thời lượng: @durationHours.ToString("0.#") giờ</small>
                    </div>
                    <input type="hidden" name="WeeklySchedules[@i].SessionIndex" value="@(i + 1)" />
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Thứ trong tuần</label>
                            <select name="WeeklySchedules[@i].DayOfWeek" class="form-select form-select-sm schedule-day">
                                @foreach (DayOfWeek day in Enum.GetValues(typeof(DayOfWeek)))
                                {
                                    var dayName = day switch
                                    {
                                        DayOfWeek.Monday => "Thứ Hai",
                                        DayOfWeek.Tuesday => "Thứ Ba",
                                        DayOfWeek.Wednesday => "Thứ Tư",
                                        DayOfWeek.Thursday => "Thứ Năm",
                                        DayOfWeek.Friday => "Thứ Sáu",
                                        DayOfWeek.Saturday => "Thứ Bảy",
                                        DayOfWeek.Sunday => "Chủ Nhật",
                                        _ => day.ToString()
                                    };
                                    if (Model.WeeklySchedules[i].DayOfWeek == day)
                                    {
                                        <option value="@day" selected>@dayName</option>
                                    }
                                    else
                                    {
                                        <option value="@day">@dayName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small text-muted mb-1">Giờ bắt đầu</label>
                            <input type="time" name="WeeklySchedules[@i].StartTime" class="form-control form-control-sm schedule-start"
                                   value="@Model.WeeklySchedules[i].StartTime.ToString("HH\\:mm")" required />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small text-muted mb-1">Giờ kết thúc</label>
                            <input type="time" name="WeeklySchedules[@i].EndTime" class="form-control form-control-sm schedule-end"
                                   value="@Model.WeeklySchedules[i].EndTime.ToString("HH\\:mm")" required />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label fw-semibold"></label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label fw-semibold"></label>
        <textarea asp-for="Description" class="form-control" rows="4" maxlength="1000" placeholder="Mô tả nội dung chương trình học, tài liệu giảng dạy, yêu cầu đối với học viên..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-danger px-4">
            <i class="bi bi-check2-circle me-1"></i>@(isEdit ? "Lưu thay đổi" : "Tạo lớp")
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- XỬ LÝ KHỐI ẢNH BÌA GỘP (FILE UPLOAD HOẶC URL VÀ XEM TRƯỚC) ---
        const modeUpload = document.getElementById('modeUpload');
        const modeUrl = document.getElementById('modeUrl');
        const uploadInputBox = document.getElementById('uploadInputBox');
        const urlInputBox = document.getElementById('urlInputBox');
        const fileInput = document.getElementById('coverImageFileInput');
        const urlInput = document.getElementById('coverImageUrlInput');
        const imgPreview = document.getElementById('coverImagePreview');
        const placeholder = document.getElementById('coverImagePlaceholder');
        const removeCheck = document.getElementById('removeCoverCheck');

        function updatePreview(src) {
            if (src) {
                imgPreview.src = src;
                imgPreview.classList.remove('d-none');
                if (placeholder) placeholder.classList.add('d-none');
            } else {
                imgPreview.src = '';
                imgPreview.classList.add('d-none');
                if (placeholder) placeholder.classList.remove('d-none');
            }
        }

        if (modeUpload && modeUrl) {
            modeUpload.addEventListener('change', function () {
                if (this.checked) {
                    uploadInputBox.classList.remove('d-none');
                    urlInputBox.classList.add('d-none');
                    if (fileInput && fileInput.files && fileInput.files[0]) {
                        updatePreview(URL.createObjectURL(fileInput.files[0]));
                    }
                }
            });

            modeUrl.addEventListener('change', function () {
                if (this.checked) {
                    uploadInputBox.classList.add('d-none');
                    urlInputBox.classList.remove('d-none');
                    if (urlInput && urlInput.value.trim()) {
                        updatePreview(urlInput.value.trim());
                    }
                }
            });
        }

        if (fileInput) {
            fileInput.addEventListener('change', function () {
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    updatePreview(URL.createObjectURL(file));
                    if (removeCheck) removeCheck.checked = false;
                }
            });
        }

        if (urlInput) {
            urlInput.addEventListener('input', function () {
                const val = this.value.trim();
                if (val) {
                    updatePreview(val);
                    if (removeCheck) removeCheck.checked = false;
                }
            });
        }

        if (removeCheck) {
            removeCheck.addEventListener('change', function () {
                if (this.checked) {
                    updatePreview('');
                    if (fileInput) fileInput.value = '';
                    if (urlInput) urlInput.value = '';
                } else {
                    const initialUrl = imgPreview ? imgPreview.getAttribute('data-initial') : '';
                    updatePreview(initialUrl);
                }
            });
        }

        // --- XỬ LÝ LỊCH HỌC THEO BUỔI ---
        const selectCount = document.getElementById('sessionsPerWeekSelect');
        const selectHours = document.getElementById('hoursPerSessionSelect');
        const container = document.getElementById('weeklySchedulesContainer');
        if (!selectCount || !selectHours || !container) return;

        const defaultDays = ['Monday', 'Wednesday', 'Friday', 'Tuesday', 'Thursday', 'Saturday', 'Sunday'];
        const dayLabels = {
            'Monday': 'Thứ Hai',
            'Tuesday': 'Thứ Ba',
            'Wednesday': 'Thứ Tư',
            'Thursday': 'Thứ Năm',
            'Friday': 'Thứ Sáu',
            'Saturday': 'Thứ Bảy',
            'Sunday': 'Chủ Nhật'
        };

        function addHoursToTime(timeStr, hours) {
            if (!timeStr) return '';
            const [h, m] = timeStr.split(':').map(Number);
            const totalMinutes = h * 60 + m + Math.round(hours * 60);
            const newH = Math.floor(totalMinutes / 60) % 24;
            const newM = totalMinutes % 60;
            return String(newH).padStart(2, '0') + ':' + String(newM).padStart(2, '0');
        }

        function calcRowDuration(row) {
            if (!row) return;
            const startInput = row.querySelector('.schedule-start');
            const endInput = row.querySelector('.schedule-end');
            const durationEl = row.querySelector('.session-duration-text');
            if (!startInput || !endInput || !durationEl) return;

            if (startInput.value && endInput.value) {
                const [sh, sm] = startInput.value.split(':').map(Number);
                const [eh, em] = endInput.value.split(':').map(Number);
                let diffMinutes = (eh * 60 + em) - (sh * 60 + sm);
                if (diffMinutes > 0) {
                    const diffHours = Math.round((diffMinutes / 60) * 10) / 10;
                    durationEl.textContent = `Thời lượng: ${diffHours} giờ`;
                    return;
                }
            }
            const fallbackHours = parseFloat(selectHours.value) || 2.0;
            durationEl.textContent = `Thời lượng: ${fallbackHours} giờ`;
        }

        // Initialize duration calculation on existing rows
        container.querySelectorAll('.schedule-row').forEach(row => {
            calcRowDuration(row);
        });

        function syncRows() {
            const targetCount = parseInt(selectCount.value, 10) || 1;
            const duration = parseFloat(selectHours.value) || 2.0;
            let currentRows = container.querySelectorAll('.schedule-row');

            while (currentRows.length < targetCount) {
                const i = currentRows.length;
                const defDay = defaultDays[i % defaultDays.length];
                const startTime = '19:00';
                const endTime = addHoursToTime(startTime, duration);

                let optionsHtml = '';
                for (const [dayVal, dayText] of Object.entries(dayLabels)) {
                    optionsHtml += `<option value="${dayVal}" ${dayVal === defDay ? 'selected' : ''}>${dayText}</option>`;
                }

                const rowHtml = `
                    <div class="schedule-row p-3 border rounded-3 bg-white shadow-sm" data-index="${i}">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-danger text-white">Buổi ${i + 1}</span>
                            <small class="text-muted session-duration-text">Thời lượng: ${duration} giờ</small>
                        </div>
                        <input type="hidden" name="WeeklySchedules[${i}].SessionIndex" value="${i + 1}" />
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-4">
                                <label class="form-label small text-muted mb-1">Thứ trong tuần</label>
                                <select name="WeeklySchedules[${i}].DayOfWeek" class="form-select form-select-sm schedule-day">
                                    ${optionsHtml}
                                </select>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small text-muted mb-1">Giờ bắt đầu</label>
                                <input type="time" name="WeeklySchedules[${i}].StartTime" class="form-control form-control-sm schedule-start" value="${startTime}" required />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small text-muted mb-1">Giờ kết thúc</label>
                                <input type="time" name="WeeklySchedules[${i}].EndTime" class="form-control form-control-sm schedule-end" value="${endTime}" required />
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
                currentRows = container.querySelectorAll('.schedule-row');
            }

            while (currentRows.length > targetCount) {
                currentRows[currentRows.length - 1].remove();
                currentRows = container.querySelectorAll('.schedule-row');
            }

            // Update duration text
            container.querySelectorAll('.schedule-row').forEach(row => {
                calcRowDuration(row);
            });
        }

        selectCount.addEventListener('change', syncRows);

        selectHours.addEventListener('change', function () {
            const duration = parseFloat(selectHours.value) || 2.0;
            container.querySelectorAll('.schedule-row').forEach(row => {
                const startInput = row.querySelector('.schedule-start');
                const endInput = row.querySelector('.schedule-end');
                if (startInput && startInput.value && endInput) {
                    endInput.value = addHoursToTime(startInput.value, duration);
                }
                calcRowDuration(row);
            });
        });

        container.addEventListener('change', function (e) {
            const row = e.target.closest('.schedule-row');
            if (!row) return;

            if (e.target.classList.contains('schedule-start')) {
                const duration = parseFloat(selectHours.value) || 2.0;
                const endInput = row.querySelector('.schedule-end');
                if (endInput) {
                    endInput.value = addHoursToTime(e.target.value, duration);
                }
                calcRowDuration(row);
            } else if (e.target.classList.contains('schedule-end')) {
                calcRowDuration(row);
            }
        });
    });
</script>
