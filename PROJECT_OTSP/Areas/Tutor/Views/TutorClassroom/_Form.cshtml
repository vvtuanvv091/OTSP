@model PROJECT_OTSP.Dtos.ClassroomFormVm
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    var actionName = isEdit ? "Edit" : "Create";
    var money = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<form asp-area="Tutor" asp-controller="TutorClassroom" asp-action="@actionName" asp-route-id="@(isEdit ? Model.Id : null)" method="post" enctype="multipart/form-data">
    @if (isEdit)
    {
        <input asp-for="Id" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="200" autocomplete="off" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SubjectGradeKey" class="form-label"></label>
        @if (isEdit && !Model.CanChangeSubjectGrade)
        {
            <div class="form-control-plaintext fw-semibold">@Model.SubjectGradeLabel</div>
            <input asp-for="SubjectGradeKey" type="hidden" />
            <div class="form-text">Không thể đổi môn/cấp vì lớp đã có học viên hoặc yêu cầu kết nối.</div>
        }
        else
        {
            <select asp-for="SubjectGradeKey" asp-items="Model.SubjectGradeOptions" class="form-select">
                <option value="">-- Chọn môn và cấp học --</option>
            </select>
        }
        <span asp-validation-for="SubjectGradeKey" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl))
    {
        <div class="mb-3">
            <span class="form-label d-block">Ảnh bìa hiện tại</span>
            <img src="@Model.CurrentCoverImageUrl" alt="Ảnh bìa lớp @Model.Name" class="img-thumbnail" style="max-width:240px;max-height:160px;object-fit:cover" />
        </div>
    }

    <div class="mb-3">
        <label asp-for="CoverImageUrl" class="form-label"></label>
        <input asp-for="CoverImageUrl" class="form-control" type="url" maxlength="500" placeholder="https://example.com/anh-lop.jpg" />
        <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CoverImageFile" class="form-label"></label>
        <input asp-for="CoverImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
        <div class="form-text">JPG, PNG hoặc WebP; tối đa 5 MB. Nếu chọn cả URL và tệp, tệp tải lên sẽ được dùng.</div>
        <span asp-validation-for="CoverImageFile" class="text-danger"></span>
    </div>
    @if (isEdit && !string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl))
    {
        <div class="form-check mb-3">
            <input asp-for="RemoveCoverImage" class="form-check-input" />
            <label asp-for="RemoveCoverImage" class="form-check-label">Xóa ảnh bìa hiện tại</label>
        </div>
    }

    <div class="row g-3">
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="Fee" class="form-label"></label>
            @if (isEdit && !Model.CanChangeFee)
            {
                <input class="form-control" value="@Model.Fee.ToString("N0", money)" disabled />
                <input asp-for="Fee" type="hidden" />
                <div class="form-text">Không thể sửa học phí vì lớp đã có thanh toán thành công.</div>
            }
            else
            {
                <input asp-for="Fee" class="form-control" type="number" min="1" step="1" />
            }
            <span asp-validation-for="Fee" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="MaxStudents" class="form-label"></label>
            <input asp-for="MaxStudents" class="form-control" type="number" min="2" max="50" step="1" />
            <span asp-validation-for="MaxStudents" class="text-danger"></span>
        </div>
    </div>

    <!-- Cấu hình lịch học các buổi trong tuần (Buổi 1, 2, 3...) -->
    <div class="card bg-light border-0 mb-4 p-3 rounded-3">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <div>
                <h5 class="h6 mb-0 fw-bold text-danger">
                    <i class="bi bi-calendar-week me-1"></i> Thiết lập lịch học cố định theo buổi / tuần
                </h5>
                <small class="text-muted">Quy định số buổi học trong tuần, thứ và thời gian từng buổi</small>
            </div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lớp nhóm cố định</span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="SessionsPerWeek" class="form-label fw-semibold">Số buổi học / tuần <span class="text-danger">*</span></label>
                <select asp-for="SessionsPerWeek" class="form-select" id="sessionsPerWeekSelect">
                    <option value="1">1 buổi / tuần</option>
                    <option value="2">2 buổi / tuần</option>
                    <option value="3">3 buổi / tuần</option>
                    <option value="4">4 buổi / tuần</option>
                    <option value="5">5 buổi / tuần</option>
                </select>
                <span asp-validation-for="SessionsPerWeek" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="HoursPerSession" class="form-label fw-semibold">Thời lượng mỗi buổi (tiếng)</label>
                <select asp-for="HoursPerSession" class="form-select" id="hoursPerSessionSelect">
                    <option value="1.0">1.0 giờ (60 phút)</option>
                    <option value="1.5">1.5 giờ (90 phút)</option>
                    <option value="2.0">2.0 giờ (120 phút)</option>
                    <option value="2.5">2.5 giờ (150 phút)</option>
                    <option value="3.0">3.0 giờ (180 phút)</option>
                </select>
                <span asp-validation-for="HoursPerSession" class="text-danger"></span>
            </div>
        </div>

        <!-- Danh sách chi tiết từng buổi học -->
        <label class="form-label fw-semibold mb-2">Chi tiết khung giờ từng buổi trong tuần:</label>
        <div id="weeklySchedulesContainer" class="d-flex flex-column gap-2">
            @for (int i = 0; i < Model.WeeklySchedules.Count; i++)
            {
                <div class="schedule-row p-3 border rounded-3 bg-white shadow-sm" data-index="@i">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-danger text-white">Buổi @(i + 1)</span>
                        <small class="text-muted session-duration-text">Thời lượng: @Model.HoursPerSession giờ</small>
                    </div>
                    <input type="hidden" name="WeeklySchedules[@i].SessionIndex" value="@(i + 1)" />
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted mb-1">Thứ trong tuần</label>
                            <select name="WeeklySchedules[@i].DayOfWeek" class="form-select form-select-sm schedule-day">
                                @foreach (DayOfWeek day in Enum.GetValues(typeof(DayOfWeek)))
                                {
                                    var dayName = day switch
                                    {
                                        DayOfWeek.Monday => "Thứ Hai",
                                        DayOfWeek.Tuesday => "Thứ Ba",
                                        DayOfWeek.Wednesday => "Thứ Tư",
                                        DayOfWeek.Thursday => "Thứ Năm",
                                        DayOfWeek.Friday => "Thứ Sáu",
                                        DayOfWeek.Saturday => "Thứ Bảy",
                                        DayOfWeek.Sunday => "Chủ Nhật",
                                        _ => day.ToString()
                                    };
                                    if (Model.WeeklySchedules[i].DayOfWeek == day)
                                    {
                                        <option value="@day" selected>@dayName</option>
                                    }
                                    else
                                    {
                                        <option value="@day">@dayName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small text-muted mb-1">Giờ bắt đầu</label>
                            <input type="time" name="WeeklySchedules[@i].StartTime" class="form-control form-control-sm schedule-start"
                                   value="@Model.WeeklySchedules[i].StartTime.ToString("HH\\:mm")" required />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small text-muted mb-1">Giờ kết thúc</label>
                            <input type="time" name="WeeklySchedules[@i].EndTime" class="form-control form-control-sm schedule-end"
                                   value="@Model.WeeklySchedules[i].EndTime.ToString("HH\\:mm")" required />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4" maxlength="1000"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-danger">@(isEdit ? "Lưu thay đổi" : "Tạo lớp")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectCount = document.getElementById('sessionsPerWeekSelect');
        const selectHours = document.getElementById('hoursPerSessionSelect');
        const container = document.getElementById('weeklySchedulesContainer');
        if (!selectCount || !selectHours || !container) return;

        const defaultDays = ['Monday', 'Wednesday', 'Friday', 'Tuesday', 'Thursday', 'Saturday', 'Sunday'];
        const dayLabels = {
            'Monday': 'Thứ Hai',
            'Tuesday': 'Thứ Ba',
            'Wednesday': 'Thứ Tư',
            'Thursday': 'Thứ Năm',
            'Friday': 'Thứ Sáu',
            'Saturday': 'Thứ Bảy',
            'Sunday': 'Chủ Nhật'
        };

        function addHoursToTime(timeStr, hours) {
            if (!timeStr) return '';
            const [h, m] = timeStr.split(':').map(Number);
            const totalMinutes = h * 60 + m + Math.round(hours * 60);
            const newH = Math.floor(totalMinutes / 60) % 24;
            const newM = totalMinutes % 60;
            return String(newH).padStart(2, '0') + ':' + String(newM).padStart(2, '0');
        }

        function syncRows() {
            const targetCount = parseInt(selectCount.value, 10) || 1;
            const duration = parseFloat(selectHours.value) || 2.0;
            let currentRows = container.querySelectorAll('.schedule-row');

            while (currentRows.length < targetCount) {
                const i = currentRows.length;
                const defDay = defaultDays[i % defaultDays.length];
                const startTime = '19:00';
                const endTime = addHoursToTime(startTime, duration);

                let optionsHtml = '';
                for (const [dayVal, dayText] of Object.entries(dayLabels)) {
                    optionsHtml += `<option value="${dayVal}" ${dayVal === defDay ? 'selected' : ''}>${dayText}</option>`;
                }

                const rowHtml = `
                    <div class="schedule-row p-3 border rounded-3 bg-white shadow-sm" data-index="${i}">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-danger text-white">Buổi ${i + 1}</span>
                            <small class="text-muted session-duration-text">Thời lượng: ${duration} giờ</small>
                        </div>
                        <input type="hidden" name="WeeklySchedules[${i}].SessionIndex" value="${i + 1}" />
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-4">
                                <label class="form-label small text-muted mb-1">Thứ trong tuần</label>
                                <select name="WeeklySchedules[${i}].DayOfWeek" class="form-select form-select-sm schedule-day">
                                    ${optionsHtml}
                                </select>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small text-muted mb-1">Giờ bắt đầu</label>
                                <input type="time" name="WeeklySchedules[${i}].StartTime" class="form-control form-control-sm schedule-start" value="${startTime}" required />
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small text-muted mb-1">Giờ kết thúc</label>
                                <input type="time" name="WeeklySchedules[${i}].EndTime" class="form-control form-control-sm schedule-end" value="${endTime}" required />
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
                currentRows = container.querySelectorAll('.schedule-row');
            }

            while (currentRows.length > targetCount) {
                currentRows[currentRows.length - 1].remove();
                currentRows = container.querySelectorAll('.schedule-row');
            }

            // Update duration text
            container.querySelectorAll('.session-duration-text').forEach(el => {
                el.textContent = `Thời lượng: ${duration} giờ`;
            });
        }

        selectCount.addEventListener('change', syncRows);

        selectHours.addEventListener('change', function () {
            const duration = parseFloat(selectHours.value) || 2.0;
            container.querySelectorAll('.schedule-row').forEach(row => {
                const startInput = row.querySelector('.schedule-start');
                const endInput = row.querySelector('.schedule-end');
                if (startInput && startInput.value && endInput) {
                    endInput.value = addHoursToTime(startInput.value, duration);
                }
            });
            container.querySelectorAll('.session-duration-text').forEach(el => {
                el.textContent = `Thời lượng: ${duration} giờ`;
            });
        });

        container.addEventListener('change', function (e) {
            if (e.target.classList.contains('schedule-start')) {
                const duration = parseFloat(selectHours.value) || 2.0;
                const row = e.target.closest('.schedule-row');
                const endInput = row ? row.querySelector('.schedule-end') : null;
                if (endInput) {
                    endInput.value = addHoursToTime(e.target.value, duration);
                }
            }
        });
    });
</script>
