@{
    var isVietnamese = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "en";
    var culture = isVietnamese ? "vi" : "en";
    var theme = Context.Request.Cookies["otsp-theme"] == "dark" ? "dark" : "light";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var groupBy = Context.Request.Query["groupBy"].ToString();

    // Tên tạm lấy từ cookie đăng nhập, không truy vấn DB
    var initialName = User.Identity?.Name ?? "";
    var sidebarInfoUrl = Url.Action("SidebarInfo", "TutorProfile", new { area = "Tutor" });

    var themeLabel = theme == "dark"
        ? (isVietnamese ? "Chuyển sang giao diện sáng" : "Switch to light theme")
        : (isVietnamese ? "Chuyển sang giao diện tối" : "Switch to dark theme");
}<!DOCTYPE html>
<html lang="@culture" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OTSP</title>
    <link rel="icon" href="~/assets/img/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Poppins:wght@400;500;600;700;800&family=Raleway:wght@400;600;700;800&display=swap" />

    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/assets/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/otsp-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/otsp-red-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-mobile.css" asp-append-version="true" />
</head>
<body class="index-page" data-controller="@controllerName">
    <div id="tutor-realtime-config" class="d-none"
         data-hub-url="@Url.Content("~/hubs/connection-requests")"
         data-requests-url="@Url.Action("Index", "TutorConnectionRequest", new { area = "Tutor" })"></div>

    <header id="header" class="header sticky-top">
        <div class="header-top">
            <div class="container-fluid container-xl d-flex align-items-center justify-content-end gap-2">
                <form asp-area="" asp-controller="SetLanguage" asp-action="SetPreferences" method="post" class="header-language" aria-label="Language">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" name="culture" value="vi" class="header-control @(culture == "vi" ? "active" : "")" aria-pressed="@(culture == "vi")">VI</button>
                    <button type="submit" name="culture" value="en" class="header-control @(culture == "en" ? "active" : "")" aria-pressed="@(culture == "en")">EN</button>
                </form>

                <form asp-area="" asp-controller="SetLanguage" asp-action="SetPreferences" method="post" class="header-theme-form">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" name="theme" value="@(theme == "dark" ? "light" : "dark")"
                            class="header-control header-theme-toggle" aria-label="@themeLabel" title="@themeLabel">
                        <i class="bi @(theme == "dark" ? "bi-sun-fill" : "bi-moon-stars-fill")" aria-hidden="true"></i>
                    </button>
                </form>

                <partial name="_LoginPartial" />
            </div>
        </div>

        <div class="container-fluid container-xl position-relative d-flex align-items-center">
            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto">
                <h1 class="sitename">OTSP</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">@(isVietnamese ? "Trang chủ" : "Home")</a></li>
                    <li><a href="#">@(isVietnamese ? "Gia sư" : "Tutors")</a></li>
                    <li><a href="#">@(isVietnamese ? "Môn học" : "Subjects")</a></li>
                    <li><a href="/#how-it-works">@(isVietnamese ? "Tin tức" : "News")</a></li>
                    <li><a href="#">@(isVietnamese ? "Giới thiệu" : "About")</a></li>
                    <li><a href="/#contact">@(isVietnamese ? "Liên hệ" : "Contact")</a></li>
                </ul>
            </nav>

            <a class="btn-getstarted" href="/#tutors">@(isVietnamese ? "Tìm gia sư" : "Find a tutor")</a>
        </div>
    </header>

    <div class="tutor-dashboard-shell">
        <aside class="tutor-sidebar" id="tutorSidebar" aria-label="Thanh điều hướng gia sư">

            <div class="tutor-sidebar-user" id="tutorSidebarUser" data-info-url="@sidebarInfoUrl">
                <img class="tutor-sidebar-avatar d-none" data-role="avatar-img" alt="" referrerpolicy="no-referrer" />
                <span class="tutor-sidebar-avatar" data-role="avatar-icon"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                <div class="tutor-sidebar-user-info">
                    <strong data-role="name">@initialName</strong>
                </div>
            </div>

            <nav class="tutor-sidebar-nav">
                <span class="tutor-sidebar-heading">TỔNG QUAN</span>
                <a asp-area="Tutor" asp-controller="TutorProfile" asp-action="Index"
                   class="tutor-sidebar-link @(controllerName == "TutorProfile" ? "active" : "")">
                    <i class="bi bi-grid" aria-hidden="true"></i><span>Tổng quan</span>
                </a>

                <span class="tutor-sidebar-heading">GIẢNG DẠY</span>
                <a asp-area="Tutor" asp-controller="TutorSchedule" asp-action="Index"
                   class="tutor-sidebar-link @(controllerName == "TutorSchedule" ? "active" : "")">
                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>Lịch dạy</span>
                </a>
                <a asp-area="Tutor" asp-controller="TutorConnectionRequest" asp-action="Index"
                   class="tutor-sidebar-link @(controllerName == "TutorConnectionRequest" ? "active" : "")">
                    <i class="bi bi-person-plus" aria-hidden="true"></i><span>Yêu cầu kết nối</span>
                </a>
                <a asp-area="Tutor" asp-controller="TutorClassroom" asp-action="Index"
                   class="tutor-sidebar-link @(controllerName == "TutorClassroom" ? "active" : "")">
                    <i class="bi bi-easel" aria-hidden="true"></i><span>Quản lý lớp nhóm</span>
                </a>
                <a asp-area="Tutor" asp-controller="TutorAvailability" asp-action="Index"
                   class="tutor-sidebar-link @(controllerName == "TutorAvailability" ? "active" : "")">
                    <i class="bi bi-calendar3" aria-hidden="true"></i><span>Lịch rảnh</span>
                </a>
                <a asp-area="Tutor" asp-controller="TutorSubject" asp-action="Index" asp-route-groupBy="subject"
                   class="tutor-sidebar-link @(controllerName == "TutorSubject" && groupBy != "grade" ? "active" : "")">
                    <i class="bi bi-book" aria-hidden="true"></i><span>Môn học</span>
                </a>
                <a asp-area="Tutor" asp-controller="TutorSubject" asp-action="Index" asp-route-groupBy="grade"
                   class="tutor-sidebar-link @(controllerName == "TutorSubject" && groupBy == "grade" ? "active" : "")">
                    <i class="bi bi-mortarboard" aria-hidden="true"></i><span>Cấp học</span>
                </a>

                <span class="tutor-sidebar-heading">HỌC VIÊN CỦA TÔI</span>
                <a asp-area="Tutor" asp-controller="TutorLearningDocument" asp-action="Index"
                   class="tutor-sidebar-link @(controllerName == "TutorLearningDocument" ? "active" : "")">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i><span>Tài liệu</span>
                </a>

                <span class="tutor-sidebar-heading">TƯƠNG TÁC</span>
                <span class="tutor-sidebar-link is-disabled"><i class="bi bi-star" aria-hidden="true"></i><span>Đánh giá</span></span>
                <span class="tutor-sidebar-link is-disabled"><i class="bi bi-chat-dots" aria-hidden="true"></i><span>Tin nhắn</span></span>

                <span class="tutor-sidebar-heading">TÀI CHÍNH</span>
                <span class="tutor-sidebar-link is-disabled"><i class="bi bi-wallet2" aria-hidden="true"></i><span>Thu nhập</span></span>

                <span class="tutor-sidebar-heading">TÀI KHOẢN</span>
                <a asp-area="Tutor" asp-controller="TutorProfile" asp-action="Index" class="tutor-sidebar-link">
                    <i class="bi bi-person-vcard" aria-hidden="true"></i><span>Hồ sơ</span>
                </a>
            </nav>
        </aside>

        <button type="button" class="tutor-menu-toggle" id="tutorMenuToggle"
                aria-label="Mở thanh điều hướng" aria-controls="tutorSidebar" aria-expanded="true">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <button type="button" class="tutor-sidebar-backdrop" id="tutorSidebarBackdrop" aria-label="Đóng thanh điều hướng"></button>

        <main id="tutorPageContent" role="main" class="tutor-dashboard-main pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ==================== FOOTER ==================== -->
    <footer id="footer" class="footer position-relative">
        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center text-decoration-none">
                        <span class="sitename">OTSP</span>
                    </a>
                    <p class="pt-3">
                        @(isVietnamese
                            ? "Nền tảng kết nối gia sư và học viên trực tuyến hàng đầu. Đội ngũ gia sư được kiểm định bằng cấp nghiêm ngặt, học phí minh bạch và hỗ trợ học thử linh hoạt."
                            : "Premier online tutoring platform connecting verified tutors and students with transparent pricing and flexible schedules.")
                    </p>
                    <div class="footer-contact pt-2">
                        <p><i class="bi bi-telephone-fill me-2 text-danger"></i><strong>Hotline:</strong> <span>(+84) 984 391 940</span></p>
                        <p><i class="bi bi-envelope-fill me-2 text-danger"></i><strong>Email:</strong> <span>support@otsp.vn</span></p>
                    </div>
                    <div class="social-links d-flex gap-2 mt-4">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2 col-md-3 footer-links">
                    <h4>@(isVietnamese ? "Khám phá" : "Explore")</h4>
                    <ul class="list-unstyled">
                        <li><a href="/#features">@(isVietnamese ? "Danh mục môn học" : "Subjects")</a></li>
                        <li><a href="/#courses">@(isVietnamese ? "Lớp học đang mở" : "Active Classes")</a></li>
                        <li><a href="/#trainers-index">@(isVietnamese ? "Gia sư tiêu biểu" : "Top Tutors")</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register">@(isVietnamese ? "Đăng ký gia sư" : "Become Tutor")</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2 col-md-3 footer-links">
                    <h4>@(isVietnamese ? "Thông tin" : "Information")</h4>
                    <ul class="list-unstyled">
                        <li><a href="/#why-us">@(isVietnamese ? "Về OTSP" : "About Us")</a></li>
                        <li><a href="/#hero">@(isVietnamese ? "Quy định học thử" : "Trial Policy")</a></li>
                        <li><a href="/#footer">@(isVietnamese ? "Chính sách bảo mật" : "Privacy Policy")</a></li>
                        <li><a href="/#footer">@(isVietnamese ? "Điều khoản dịch vụ" : "Terms of Service")</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 footer-newsletter">
                    <h4>@(isVietnamese ? "Nhận bản tin giáo dục" : "Newsletter")</h4>
                    <p>@(isVietnamese ? "Đăng ký email để nhận thông tin ưu đãi học tập và các mẹo ôn thi hữu ích." : "Subscribe to receive study tips and exclusive tutoring offers.")</p>
                    <form onsubmit="event.preventDefault(); alert('@(isVietnamese ? "Cảm ơn bạn đã đăng ký nhận tin!" : "Thank you for subscribing!")');" class="php-email-form">
                        <div class="newsletter-form">
                            <input type="email" name="email" placeholder="@(isVietnamese ? "Nhập email của bạn..." : "Your email address...")" required>
                            <input type="submit" value="@(isVietnamese ? "Đăng ký" : "Subscribe")">
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="container copyright text-center mt-4 pt-3 border-top">
            <p class="mb-0 text-muted small">
                © <strong>OTSP</strong>. @(isVietnamese ? "Bảo lưu mọi quyền." : "All rights reserved.")
            </p>
        </div>
    </footer>

<script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js" defer></script>
<script src="~/js/tutor-ajax-navigation.js" asp-append-version="true" defer></script>

<script>
    (() => {
        // 1) Sidebar: lấy họ tên và avatar sau khi trang đã hiển thị
        const userBox = document.getElementById('tutorSidebarUser');
        if (userBox && userBox.dataset.infoUrl) {
            fetch(userBox.dataset.infoUrl, {
                credentials: 'same-origin',
                headers: { Accept: 'application/json' }
            })
            .then(res => res.ok ? res.json() : null)
            .then(info => {
                if (!info) return;

                userBox.querySelector('[data-role="name"]').textContent = info.name || '';

                if (info.avatarUrl) {
                    const img = userBox.querySelector('[data-role="avatar-img"]');
                    img.src = info.avatarUrl;
                    img.classList.remove('d-none');
                    userBox.querySelector('[data-role="avatar-icon"]').classList.add('d-none');
                }
            })
            .catch(() => { /* giữ tên tạm từ cookie */ });
        }

        // 2) Mở/đóng sidebar
        const toggle = document.getElementById('tutorMenuToggle');
        const backdrop = document.getElementById('tutorSidebarBackdrop');
        const mobileQuery = window.matchMedia('(max-width: 991.98px)');

        function setSidebarOpen(open) {
            document.body.classList.toggle('tutor-sidebar-open', open);
            document.body.classList.toggle('tutor-sidebar-collapsed', !open && !mobileQuery.matches);
            toggle.setAttribute('aria-expanded', String(open));
            toggle.setAttribute('aria-label', open ? 'Thu gọn thanh điều hướng' : 'Mở thanh điều hướng');
            toggle.querySelector('i').className = open ? 'bi bi-x-lg' : 'bi bi-list';
        }

        setSidebarOpen(!mobileQuery.matches);

        toggle.addEventListener('click', () => {
            setSidebarOpen(!document.body.classList.contains('tutor-sidebar-open'));
        });
        backdrop.addEventListener('click', () => setSidebarOpen(false));
        mobileQuery.addEventListener('change', e => setSidebarOpen(!e.matches));

        // 3) Đồng bộ chiều cao header để sidebar luôn nằm ngay dưới header
        const header = document.getElementById('header');
        const shell = document.querySelector('.tutor-dashboard-shell');
        const syncHeaderOffset = () => {
            shell.style.setProperty('--tutor-header-offset', header.offsetHeight + 'px');
        };
        syncHeaderOffset();
        window.addEventListener('resize', syncHeaderOffset);
        new ResizeObserver(syncHeaderOffset).observe(header);
    })();
</script>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
<script>
    (() => {
        const config = document.getElementById("tutor-realtime-config");
        if (!config || !window.signalR) return;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(config.dataset.hubUrl)
            .withAutomaticReconnect()
            .build();

        const showNotice = message => {
            const notice = document.createElement("div");
            notice.className = "alert alert-info shadow position-fixed top-0 end-0 m-3";
            notice.style.zIndex = "1080";
            notice.setAttribute("role", "status");
            notice.textContent = message + " ";

            const link = document.createElement("a");
            link.href = config.dataset.requestsUrl;
            link.className = "alert-link";
            link.textContent = "Xem yêu cầu";
            notice.appendChild(link);
            document.body.appendChild(notice);
            window.setTimeout(() => notice.remove(), 10000);
        };

        connection.on("ConnectionRequestReceived", update => {
            showNotice(`Có yêu cầu kết nối mới từ ${update.studentName} cho môn ${update.subjectName}.`);
            if (document.body.dataset.controller === "TutorConnectionRequest")
                window.setTimeout(() => window.location.reload(), 500);
        });

        connection.on("ConnectionRequestCancelled", () => {
            showNotice("Học viên đã hủy yêu cầu kết nối.");
            if (document.body.dataset.controller === "TutorConnectionRequest")
                window.setTimeout(() => window.location.reload(), 500);
        });

        connection.start().catch(error => console.error("SignalR connection failed:", error));
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>