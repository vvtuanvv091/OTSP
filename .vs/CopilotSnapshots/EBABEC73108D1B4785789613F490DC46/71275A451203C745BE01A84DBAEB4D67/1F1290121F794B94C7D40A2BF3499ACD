using static PROJECT_OTSP.Models.Enums;

namespace PROJECT_OTSP.Dtos;

/// <summary>
/// DTO chứa thông tin yêu cầu kết nối mà học viên/phụ huynh đã gửi tới các gia sư.
/// </summary>
public class StudentConnectionRequestDto
{
    public int Id { get; set; }
    public int TutorId { get; set; }
    public string TutorName { get; set; } = string.Empty;
    public string? TutorAvatarUrl { get; set; }
    public decimal HourlyFee { get; set; }
    public string SubjectName { get; set; } = string.Empty;
    public string GradeLevelName { get; set; } = string.Empty;
    public ClassroomType PreferredType { get; set; }
    public string? ClassroomName { get; set; }
    public string? Message { get; set; }
    public RequestStatus Status { get; set; }
    public DateTime CreatedAt { get; set; }
    public DateTime? RespondedAt { get; set; }

    public string StatusBadgeClass => Status switch
    {
        RequestStatus.Pending => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        RequestStatus.Accepted => "bg-success-subtle text-success-emphasis border border-success-subtle",
        RequestStatus.Rejected => "bg-danger-subtle text-danger-emphasis border border-danger-subtle",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    public string StatusText => Status switch
    {
        RequestStatus.Pending => "Đang chờ gia sư duyệt",
        RequestStatus.Accepted => "Đã được chấp nhận",
        RequestStatus.Rejected => "Đã bị từ chối",
        _ => Status.ToString()
    };
}
