@model PROJECT_OTSP.Dtos.Chat.ChatConversationVm

@{
    ViewData["Title"] = $"Trò chuyện với {Model.ContactName}";
    Layout = User.IsInRole("Tutor")
        ? "~/Areas/Tutor/Views/Shared/_Layout_Tutor.cshtml"
        : "~/Areas/Student_Parent/Views/Shared/_Layout_Student.cshtml";
}

<div id="chat-page" class="container-fluid py-4"
     data-request-id="@Model.RequestId"
     data-current-user-id="@Model.CurrentUserId"
     data-hub-url="@Url.Content("~/hubs/chat")">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 900px; min-height: 70vh">
        <div class="card-header bg-body d-flex align-items-center justify-content-between py-3">
            <div>
                <h1 class="h5 mb-1"><i class="bi bi-chat-dots text-danger me-2" aria-hidden="true"></i>@Model.ContactName</h1>
                <span id="chatConnectionStatus" class="small text-body-secondary" role="status">Đang kết nối...</span>
            </div>
            <a asp-area="Student_Parent" asp-controller="Send_Details_Tutor" asp-action="MyRequests" class="btn btn-sm btn-outline-secondary">
                Quay lại
            </a>
        </div>

        <div id="chatMessages" class="card-body overflow-auto d-flex flex-column gap-3" style="max-height: 60vh" role="log" aria-live="polite" aria-relevant="additions">
            @if (Model.Messages.Count == 0)
            {
                <p id="chatEmptyState" class="text-center text-body-secondary my-auto">Chưa có tin nhắn. Hãy bắt đầu cuộc trò chuyện.</p>
            }
            @foreach (var message in Model.Messages)
            {
                var isOwnMessage = message.SenderId == Model.CurrentUserId;
                <article class="d-flex @(isOwnMessage ? "justify-content-end" : "justify-content-start")" data-message-id="@message.Id">
                    <div class="rounded-3 px-3 py-2 @(isOwnMessage ? "bg-danger text-white" : "bg-body-tertiary")" style="max-width: min(80%, 600px)">
                        <div class="small fw-semibold mb-1">@message.SenderName</div>
                        <div class="text-break" data-message-content>@message.Content</div>
                        <time class="small d-block text-end mt-1 opacity-75" datetime="@message.SentAtUtc.ToString("O")">
                            @message.SentAtUtc.AddHours(7).ToString("dd/MM HH:mm")
                        </time>
                    </div>
                </article>
            }
        </div>

        <div class="card-footer bg-body">
            <form id="chatForm" class="d-flex gap-2">
                <label class="visually-hidden" for="chatInput">Tin nhắn</label>
                <textarea id="chatInput" class="form-control" rows="2" maxlength="2000" placeholder="Nhập tin nhắn..." required></textarea>
                <button id="chatSendButton" type="submit" class="btn btn-danger align-self-end" disabled>
                    <i class="bi bi-send-fill me-1" aria-hidden="true"></i> Gửi
                </button>
            </form>
            <div id="chatError" class="small text-danger mt-2" role="alert"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    <script>
        (() => {
            const page = document.getElementById("chat-page");
            const messages = document.getElementById("chatMessages");
            const form = document.getElementById("chatForm");
            const input = document.getElementById("chatInput");
            const sendButton = document.getElementById("chatSendButton");
            const status = document.getElementById("chatConnectionStatus");
            const error = document.getElementById("chatError");
            if (!page || !window.signalR) {
                status.textContent = "Không tải được kết nối chat.";
                return;
            }

            const requestId = Number(page.dataset.requestId);
            const currentUserId = page.dataset.currentUserId;
            const connection = new signalR.HubConnectionBuilder()
                .withUrl(page.dataset.hubUrl)
                .withAutomaticReconnect()
                .build();

            const appendMessage = message => {
                document.getElementById("chatEmptyState")?.remove();
                const article = document.createElement("article");
                article.className = `d-flex ${message.senderId === currentUserId ? "justify-content-end" : "justify-content-start"}`;
                article.dataset.messageId = message.id;

                const bubble = document.createElement("div");
                bubble.className = `rounded-3 px-3 py-2 ${message.senderId === currentUserId ? "bg-danger text-white" : "bg-body-tertiary"}`;
                bubble.style.maxWidth = "min(80%, 600px)";

                const name = document.createElement("div");
                name.className = "small fw-semibold mb-1";
                name.textContent = message.senderName;
                const content = document.createElement("div");
                content.className = "text-break";
                content.textContent = message.content;
                const time = document.createElement("time");
                time.className = "small d-block text-end mt-1 opacity-75";
                time.dateTime = message.sentAtUtc;
                time.textContent = new Date(message.sentAtUtc).toLocaleString("vi-VN", {
                    timeZone: "Asia/Ho_Chi_Minh",
                    day: "2-digit",
                    month: "2-digit",
                    hour: "2-digit",
                    minute: "2-digit"
                });

                bubble.append(name, content, time);
                article.appendChild(bubble);
                messages.appendChild(article);
                messages.scrollTop = messages.scrollHeight;
            };

            const joinConversation = async () => {
                await connection.invoke("JoinConversation", requestId);
                status.textContent = "Đang trực tuyến";
                sendButton.disabled = false;
            };

            connection.on("ReceiveMessage", appendMessage);
            connection.onreconnecting(() => {
                status.textContent = "Đang kết nối lại...";
                sendButton.disabled = true;
            });
            connection.onreconnected(joinConversation);
            connection.onclose(() => {
                status.textContent = "Mất kết nối. Vui lòng tải lại trang.";
                sendButton.disabled = true;
            });

            connection.start()
                .then(joinConversation)
                .catch(() => {
                    status.textContent = "Không thể kết nối chat.";
                    error.textContent = "Vui lòng tải lại trang hoặc kiểm tra kết nối mạng.";
                });

            form.addEventListener("submit", async event => {
                event.preventDefault();
                const content = input.value.trim();
                if (!content || sendButton.disabled) return;

                sendButton.disabled = true;
                error.textContent = "";
                try {
                    await connection.invoke("SendMessage", requestId, content);
                    input.value = "";
                    input.focus();
                } catch (exception) {
                    error.textContent = exception.message || "Không gửi được tin nhắn.";
                } finally {
                    sendButton.disabled = connection.state !== signalR.HubConnectionState.Connected;
                }
            });

            messages.scrollTop = messages.scrollHeight;
        })();
    </script>
}
