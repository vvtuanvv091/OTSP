    private static async Task EnsurePaymentsAndInvoicesAsync(ApplicationDbContext db, IReadOnlyList<Classroom> classrooms, IReadOnlyList<StudentProfile> students)
    {
        var codes = Enumerable.Range(1, SampleCount).Select(i => $"OTSP-SEED30-PAY-{i:D3}").ToArray();
        var payments = await db.Payments.Where(x => x.GatewayTransactionCode != null && codes.Contains(x.GatewayTransactionCode)).ToListAsync();
        var existingCodes = payments.Select(x => x.GatewayTransactionCode).ToHashSet();
        for (var i = 1; i <= Math.Min(SampleCount, Math.Min(classrooms.Count, students.Count)); i++)
            if (!existingCodes.Contains($"OTSP-SEED30-PAY-{i:D3}"))
                db.Payments.Add(new Payment { Amount = classrooms[i - 1].Fee, Method = "Demo", Status = PaymentStatus.Success, GatewayTransactionCode = $"OTSP-SEED30-PAY-{i:D3}", PaidAt = DateTime.UtcNow.AddDays(-i), StudentId = students[i - 1].Id, ClassroomId = classrooms[i - 1].Id });
        await db.SaveChangesAsync();

        payments = await db.Payments.Where(x => x.GatewayTransactionCode != null && codes.Contains(x.GatewayTransactionCode)).OrderBy(x => x.GatewayTransactionCode).ToListAsync();
        var paymentIds = payments.Select(x => x.Id).ToArray();
        var invoiced = (await db.Invoices.Where(x => paymentIds.Contains(x.PaymentId)).Select(x => x.PaymentId).ToListAsync()).ToHashSet();
        for (var i = 0; i < payments.Count; i++)
            if (!invoiced.Contains(payments[i].Id))
                db.Invoices.Add(new Invoice { PaymentId = payments[i].Id, IssuedDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-i)), TotalAmount = payments[i].Amount });
        await db.SaveChangesAsync();
    }

