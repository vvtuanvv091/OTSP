    private static async Task EnsureRequestsAsync(ApplicationDbContext db, IReadOnlyList<StudentProfile> students, IReadOnlyList<TutorProfile> tutors, IReadOnlyList<Subject> subjects, IReadOnlyList<GradeLevel> grades)
    {
        var names = Enumerable.Range(1, SampleCount).Select(i => SampleName("yêu cầu kết nối", i)).ToArray();
        var existing = await db.ConnectionRequests.Where(x => x.Message != null && names.Contains(x.Message)).Select(x => x.Message!).ToListAsync();
        for (var i = 1; i <= SampleCount; i++)
            if (!existing.Contains(SampleName("yêu cầu kết nối", i)))
            {
                var status = (RequestStatus)((i - 1) % 4);
                db.ConnectionRequests.Add(new ConnectionRequest
                {
                    Message = SampleName("yêu cầu kết nối", i),
                    Status = status,
                    RespondedAt = status == RequestStatus.Pending ? null : DateTime.UtcNow,
                    StudentId = students[i - 1].Id,
                    TutorId = tutors[i - 1].Id,
                    SubjectId = subjects[i - 1].Id,
                    GradeLevelId = grades[i - 1].Id,
                    PreferredType = i % 2 == 0 ? ClassroomType.Group : ClassroomType.OneToOne
                });
            }
        await db.SaveChangesAsync();
    }

    private static async Task EnsureTrialSchedulesAsync(ApplicationDbContext db, IReadOnlyList<ConnectionRequest> requests)
    {
        var ids = requests.Select(x => x.Id).ToArray();
        var existing = (await db.TrialSchedules.Where(x => ids.Contains(x.ConnectionRequestId)).Select(x => x.ConnectionRequestId).ToListAsync()).ToHashSet();
        for (var i = 0; i < Math.Min(SampleCount, requests.Count); i++)
            if (!existing.Contains(requests[i].Id))
                db.TrialSchedules.Add(new TrialSchedule { ConnectionRequestId = requests[i].Id, ScheduledAt = DateTime.UtcNow.AddDays(i + 1), Status = (ScheduleStatus)(i % 3) });
        await db.SaveChangesAsync();
    }

