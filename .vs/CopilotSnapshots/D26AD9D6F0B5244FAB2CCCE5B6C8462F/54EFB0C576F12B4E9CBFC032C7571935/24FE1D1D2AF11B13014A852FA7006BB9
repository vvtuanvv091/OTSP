    private static async Task EnsureClassroomStudentsAsync(ApplicationDbContext db, IReadOnlyList<Classroom> classrooms, IReadOnlyList<StudentProfile> students)
    {
        var classroomIds = classrooms.Select(x => x.Id).ToArray();
