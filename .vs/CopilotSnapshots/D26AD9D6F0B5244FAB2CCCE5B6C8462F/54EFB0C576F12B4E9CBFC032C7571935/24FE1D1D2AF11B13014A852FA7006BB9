        var existing = await db.ClassroomStudents.Where(x => classroomIds.Contains(x.ClassroomId) && studentIds.Contains(x.StudentId))
            .Select(x => new { x.ClassroomId, x.StudentId }).ToListAsync();
        var keys = existing.Select(x => $"{x.ClassroomId}:{x.StudentId}").ToHashSet();
        for (var i = 0; i < Math.Min(SampleCount, Math.Min(classrooms.Count, students.Count)); i++)
            if (!keys.Contains($"{classrooms[i].Id}:{students[i].Id}"))
                db.ClassroomStudents.Add(new ClassroomStudent { ClassroomId = classrooms[i].Id, StudentId = students[i].Id, JoinedAt = DateTime.UtcNow.AddDays(-i) });
        await db.SaveChangesAsync();
    }

