using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using PROJECT_OTSP.Data;
using PROJECT_OTSP.Dtos.Admin;
using PROJECT_OTSP.Models;
using static PROJECT_OTSP.Models.Enums;

namespace PROJECT_OTSP.Areas.Admin.Controllers;

[Area("Admin")]
[Authorize(Roles = "Admin")]
public sealed class TutorApprovalsController : Controller
{
    private readonly ApplicationDbContext _db;
    private readonly UserManager<ApplicationUser> _userManager;

    public TutorApprovalsController(ApplicationDbContext db, UserManager<ApplicationUser> userManager)
    {
        _db = db;
        _userManager = userManager;
    }

    [HttpGet]
    public async Task<IActionResult> Index(CancellationToken cancellationToken)
    {
        var tutors = await _db.TutorProfiles
            .AsNoTracking()
            .Where(t => t.VerificationStatus == VerificationStatus.Pending)
            .OrderBy(t => t.User.FullName)
            .Select(t => new TutorApprovalViewModel
            {
                TutorId = t.Id,
                FullName = t.User.FullName,
                Email = t.User.Email,
                PhoneNumber = t.User.PhoneNumber,
                Address = t.User.Address,
                DateOfBirth = t.User.DateOfBirth,
                Introduction = t.Introduction,
                HourlyFee = t.HourlyFee,
                Subjects = t.TutorSubjects
                    .OrderBy(ts => ts.Subject.Name)
                    .Select(ts => new TutorApprovalSubjectViewModel
                    {
                        SubjectName = ts.Subject.Name,
                        GradeName = ts.GradeLevel.Name
                    })
                    .ToList(),
                Qualifications = t.Qualifications
                    .OrderBy(q => q.Title)
                    .Select(q => new TutorApprovalQualificationViewModel
                    {
                        Title = q.Title,
                        FileUrl = q.FileUrl,
                        Status = q.Status
                    })
                    .ToList()
            })
            .ToListAsync(cancellationToken);

        return View(new TutorApprovalsIndexViewModel { PendingTutors = tutors });
    }

    [HttpPost]
    [ValidateAntiForgeryToken]
    public Task<IActionResult> Approve(int id, CancellationToken cancellationToken) =>
        ReviewTutorAsync(id, VerificationStatus.Approved, null, cancellationToken);

    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> Reject(RejectTutorViewModel input, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid)
        {
            TempData["Error"] = "Vui lòng nhập lý do từ chối.";
            return RedirectToAction(nameof(Index));
        }

        return await ReviewTutorAsync(input.TutorId, VerificationStatus.Rejected, input.Reason.Trim(), cancellationToken);
    }

    private async Task<IActionResult> ReviewTutorAsync(
        int tutorId,
        VerificationStatus result,
        string? reason,
        CancellationToken cancellationToken)
    {
        var tutor = await _db.TutorProfiles
            .Include(t => t.User)
            .SingleOrDefaultAsync(t => t.Id == tutorId, cancellationToken);

        if (tutor == null)
        {
            TempData["Error"] = "Không tìm thấy hồ sơ gia sư.";
            return RedirectToAction(nameof(Index));
        }

        if (tutor.VerificationStatus != VerificationStatus.Pending)
        {
            TempData["Error"] = "Hồ sơ này đã được xử lý trước đó.";
            return RedirectToAction(nameof(Index));
        }

        var adminUserId = _userManager.GetUserId(User);
        if (string.IsNullOrEmpty(adminUserId))
            return Challenge();

        var admin = await _db.AdminProfiles.SingleOrDefaultAsync(a => a.UserId == adminUserId, cancellationToken);
        if (admin == null)
        {
            admin = new AdminProfile { UserId = adminUserId, Rank = "Quản trị viên" };
            _db.AdminProfiles.Add(admin);
        }

        tutor.VerificationStatus = result;
        _db.ProfileVerifications.Add(new ProfileVerification
        {
            Tutor = tutor,
            Admin = admin,
            Result = result,
            Reason = reason,
            ProcessedAt = DateTime.UtcNow
        });

        _db.Notifications.Add(new Notification
        {
            UserId = tutor.UserId,
            Title = result == VerificationStatus.Approved ? "Hồ sơ gia sư đã được duyệt" : "Hồ sơ gia sư chưa được duyệt",
            Content = result == VerificationStatus.Approved
                ? "Hồ sơ của bạn đã được duyệt và có thể hiển thị trong danh sách tìm gia sư."
                : $"Hồ sơ của bạn chưa được duyệt. Lý do: {reason}"
        });

        _db.AuditLogs.Add(new AuditLog
        {
            UserId = adminUserId,
            Action = result == VerificationStatus.Approved
                ? $"ApproveTutorProfile:{tutorId}"
                : $"RejectTutorProfile:{tutorId}",
            IpAddress = HttpContext.Connection.RemoteIpAddress?.ToString()
        });

        await _db.SaveChangesAsync(cancellationToken);
        TempData["Success"] = result == VerificationStatus.Approved
            ? $"Đã duyệt hồ sơ gia sư {tutor.User.FullName}."
            : $"Đã từ chối hồ sơ gia sư {tutor.User.FullName}.";

        return RedirectToAction(nameof(Index));
    }
}
