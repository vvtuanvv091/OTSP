using PROJECT_OTSP.Models;
using static PROJECT_OTSP.Models.Enums;

namespace PROJECT_OTSP.Dtos.Admin;

public sealed class TutorApprovalsIndexViewModel
{
    public List<TutorApprovalViewModel> PendingTutors { get; set; } = new();
}

public sealed class TutorApprovalViewModel
{
    public int TutorId { get; set; }
    public string FullName { get; set; } = "";
    public string? Email { get; set; }
    public string? PhoneNumber { get; set; }
    public string? Address { get; set; }
    public DateOnly? DateOfBirth { get; set; }
    public string? Introduction { get; set; }
    public decimal HourlyFee { get; set; }
    public TeachingFormat TeachingFormat { get; set; }
    public List<TutorApprovalSubjectViewModel> Subjects { get; set; } = new();
    public List<TutorApprovalQualificationViewModel> Qualifications { get; set; } = new();
}

public sealed class TutorApprovalSubjectViewModel
{
    public string SubjectName { get; set; } = "";
    public string GradeName { get; set; } = "";
}

public sealed class TutorApprovalQualificationViewModel
{
    public string Title { get; set; } = "";
    public string? FileUrl { get; set; }
    public VerificationStatus Status { get; set; }
}

public sealed class RejectTutorViewModel
{
    public int TutorId { get; set; }
    public string Reason { get; set; } = "";
}
