using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using PROJECT_OTSP.Data;
using System.Security.Claims;

namespace PROJECT_OTSP.Areas.Tutor.Controllers
{
    [Area("Tutor")]
    public class TutorProfileController : Controller
    {

        private readonly ApplicationDbContext _dbcontext;
        public TutorProfileController(ApplicationDbContext dbcontext, IWebHostEnvironment env)
        {
            _dbcontext = dbcontext;


        }

        private string? GetCurrentUserId()
            => User.FindFirstValue(ClaimTypes.NameIdentifier);
        [HttpGet]
        public async Task<IActionResult> Index(
           CancellationToken cancellationToken)
        {
            var userId = GetCurrentUserId();

            if (string.IsNullOrWhiteSpace(userId))
            {
                return RedirectToAction(
                    "Login",
                    "Account"
                    );
            }

            var tutorProfile = await _dbcontext.TutorProfiles
                .AsNoTracking()
                .AsSingleQuery()
                .Include(t => t.User)
                .Include(t => t.Qualifications)
                .Include(t => t.TutorSubjects)
                    .ThenInclude(ts => ts.Subject)
                .Include(t => t.TutorSubjects)
                    .ThenInclude(ts => ts.GradeLevel)
                .SingleOrDefaultAsync(
                    t => t.UserId == userId,
                    cancellationToken);

            if (tutorProfile is null)
                return NotFound();

            return View(tutorProfile);
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> UpdateProfile(string? DisplayName,string? Introduction,CancellationToken cancellationToken)
        {
            var userId = GetCurrentUserId();
            if (string.IsNullOrWhiteSpace(userId))
                return RedirectToAction("Login", "Account");

            var tutorProfile = await _dbcontext.TutorProfiles
                .Include(t => t.User)
                .FirstOrDefaultAsync(t => t.UserId == userId, cancellationToken);

            if (tutorProfile == null)
                return NotFound();

            var fullName = DisplayName?.Trim();
            if (string.IsNullOrWhiteSpace(fullName) || fullName.Length > 150)
            {
                TempData["Error"] = "Họ tên phải có từ 1 đến 150 ký tự.";
                return RedirectToAction(nameof(Index));
            }

            tutorProfile.User.FullName = fullName;
            tutorProfile.Introduction = string.IsNullOrWhiteSpace(Introduction)
                ? null
                : Introduction.Trim();

            await _dbcontext.SaveChangesAsync(cancellationToken);

            TempData["Success"] = "Cập nhật thông tin thành công.";
            return RedirectToAction(nameof(Index));
        }
    }
}
