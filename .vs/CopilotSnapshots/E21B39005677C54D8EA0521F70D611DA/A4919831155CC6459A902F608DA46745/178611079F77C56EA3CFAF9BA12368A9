    private static async Task<List<Classroom>> EnsureClassroomsAsync(ApplicationDbContext db, IReadOnlyList<TutorProfile> tutors, IReadOnlyList<Subject> subjects, IReadOnlyList<GradeLevel> grades)
    {
        var tutorIds = tutors.Select(x => x.Id).ToArray();
        var existing = await db.Classrooms.Where(x => tutorIds.Contains(x.TutorId)).OrderBy(x => x.Id).ToListAsync();
        var count = Math.Min(SampleCount, Math.Min(tutors.Count, Math.Min(subjects.Count, grades.Count)));
        var classrooms = new List<Classroom>(count);
        for (var i = 1; i <= count; i++)
        {
            var tutor = tutors[i - 1];
            var subject = subjects[i - 1];
            var grade = grades[i - 1];
            var classroom = existing.FirstOrDefault(x => x.TutorId == tutor.Id);
            if (classroom == null)
            {
                classroom = new Classroom { TutorId = tutor.Id };
                db.Classrooms.Add(classroom);
            }

            classroom.Name = $"{subject.Name} - {grade.Name}";
            var coverPhotoId = i % 2 == 0
                ? "photo-1522202176988-66273c2fd55f"
                : "photo-1509062522246-3755977927d7";
            classroom.CoverImageUrl = $"https://images.unsplash.com/{coverPhotoId}?auto=format&fit=crop&w=800&q=75";
            classroom.CoverImagePublicId = null;
            classroom.Fee = 250000 + i * 10000;
            classroom.Description = $"Lớp {subject.Name} dành cho {grade.Name}, học theo lộ trình phù hợp với từng học viên.";
            classroom.StartDate = DateOnly.FromDateTime(DateTime.UtcNow.Date.AddDays(i));
            classroom.Status = ClassroomStatus.Active;
            classroom.Type = ClassroomType.OneToOne;
            classroom.MaxStudents = 1;
            classroom.SubjectId = subject.Id;
            classroom.GradeLevelId = grade.Id;
            classrooms.Add(classroom);
        }

        await db.SaveChangesAsync();
        return classrooms;
    }

