        var messages = Enumerable.Range(1, SampleCount).Select(i => SampleName("tin nhắn", i)).ToArray();
        var existingMessages = (await db.Messagers.Where(x => messages.Contains(x.Content)).Select(x => x.Content).ToListAsync()).ToHashSet();
