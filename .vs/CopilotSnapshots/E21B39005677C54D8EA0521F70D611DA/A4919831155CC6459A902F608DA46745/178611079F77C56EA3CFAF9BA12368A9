    private static async Task<List<Subject>> EnsureSubjectsAsync(ApplicationDbContext db)
    {
        var codes = Enumerable.Range(1, SampleCount).Select(i => $"M30S{i:D3}").ToArray();
        var existing = await db.Subjects.Where(x => codes.Contains(x.Code)).ToListAsync();
        for (var i = 1; i <= SampleCount; i++)
        {
            var code = $"M30S{i:D3}";
            var subject = existing.SingleOrDefault(x => x.Code == code);
            if (subject == null)
            {
                subject = new Subject { Code = code };
                db.Subjects.Add(subject);
            }

            subject.Name = SubjectNames[i - 1];
            subject.Description = $"Chương trình học và luyện tập môn {SubjectNames[i - 1]} dành cho học viên.";
        }

        await db.SaveChangesAsync();
        return await db.Subjects.Where(x => codes.Contains(x.Code)).OrderBy(x => x.Code).ToListAsync();
    }

    private static async Task<List<GradeLevel>> EnsureGradeLevelsAsync(ApplicationDbContext db)
    {
        var codes = Enumerable.Range(1, SampleCount).Select(i => $"M30G{i:D3}").ToArray();
        var existing = await db.GradeLevels.Where(x => codes.Contains(x.Code)).ToListAsync();
        for (var i = 1; i <= SampleCount; i++)
        {
            var code = $"M30G{i:D3}";
            var grade = existing.SingleOrDefault(x => x.Code == code);
            if (grade == null)
            {
                grade = new GradeLevel { Code = code };
                db.GradeLevels.Add(grade);
            }

            grade.Name = GradeNames[i - 1];
        }

        await db.SaveChangesAsync();
        return await db.GradeLevels.Where(x => codes.Contains(x.Code)).OrderBy(x => x.Code).ToListAsync();
    }

    private static async Task<List<TProfile>> EnsureProfilesAsync<TProfile>(
        ApplicationDbContext db,
        UserManager<ApplicationUser> userManager,
        string role,
        string accountPrefix,
        Func<int, TProfile> profileFactory)
        where TProfile : class
    {
        var emails = Enumerable.Range(1, SampleCount)
            .Select(i => $"seed30.{accountPrefix}.{i:D3}@otsp.local")
            .ToList();

        // 1. Tải trước toàn bộ người dùng mẫu của nhóm này trong 1 câu truy vấn
        var existingUsers = await userManager.Users
            .Where(u => u.Email != null && emails.Contains(u.Email))
            .ToDictionaryAsync(u => u.Email!, StringComparer.OrdinalIgnoreCase);

        // 2. Tải trước danh sách UserId đã gán vai trò tương ứng trong 1 câu truy vấn
        var roleEntity = await db.Roles.AsNoTracking().FirstOrDefaultAsync(r => r.Name == role);
        var roleUserIds = roleEntity != null
            ? (await db.UserRoles.Where(ur => ur.RoleId == roleEntity.Id).Select(ur => ur.UserId).ToListAsync()).ToHashSet()
            : new HashSet<string>();

        // 3. Đảm bảo toàn bộ tài khoản Identity được tạo và cấp quyền
        var usersByIndex = new ApplicationUser[SampleCount];
        var usersToUpdate = new List<ApplicationUser>();

        for (var i = 1; i <= SampleCount; i++)
        {
            var email = emails[i - 1];
            var area = SampleAreas[i - 1];
            var fullName = GetSamplePersonName(accountPrefix, i);
            var avatarUrl = GetSampleAvatarUrl(accountPrefix, i);

            if (!existingUsers.TryGetValue(email, out var user))
            {
                user = new ApplicationUser
                {
                    UserName = email,
                    Email = email,
                    EmailConfirmed = true,
                    FullName = fullName,
                    Address = accountPrefix == "admin" ? null : area,
                    AvatarUrl = avatarUrl,
                    DateOfBirth = accountPrefix == "student"
                        ? new DateOnly(2010, (i - 1) % 12 + 1, (i - 1) % 27 + 1)
                        : new DateOnly(1990 + i % 15, (i - 1) % 12 + 1, (i - 1) % 27 + 1)
                };
                var createResult = await userManager.CreateAsync(user, Password);
                EnsureSucceeded(createResult, $"Tạo tài khoản mẫu {email}");
                existingUsers[email] = user;
            }
            else if (user.FullName != fullName || user.AvatarUrl != avatarUrl || user.Address != area)
            {
                user.FullName = fullName;
                user.Address = area;
                user.AvatarUrl = avatarUrl;
                usersToUpdate.Add(user);
            }

            if (!roleUserIds.Contains(user.Id))
            {
                EnsureSucceeded(await userManager.AddToRoleAsync(user, role), $"Gán vai trò {role} cho {email}");
                roleUserIds.Add(user.Id);
            }

            usersByIndex[i - 1] = user;
        }

        foreach (var user in usersToUpdate)
        {
            EnsureSucceeded(await userManager.UpdateAsync(user), $"Cập nhật tài khoản mẫu {user.Email}");
        }

        // 4. Tải trước toàn bộ hồ sơ (Profile) của các User này trong 1 câu truy vấn
        var userIds = usersByIndex.Select(u => u.Id).ToList();
        Dictionary<string, TProfile> existingProfiles;

        if (typeof(TProfile) == typeof(AdminProfile))
        {
            var list = await db.AdminProfiles.Where(x => userIds.Contains(x.UserId)).ToListAsync();
            existingProfiles = list.ToDictionary(x => x.UserId, x => (x as TProfile)!);
        }
        else if (typeof(TProfile) == typeof(TutorProfile))
        {
            var list = await db.TutorProfiles.Where(x => userIds.Contains(x.UserId)).ToListAsync();
            existingProfiles = list.ToDictionary(x => x.UserId, x => (x as TProfile)!);
        }
        else if (typeof(TProfile) == typeof(StudentProfile))
        {
            var list = await db.StudentProfiles.Where(x => userIds.Contains(x.UserId)).ToListAsync();
            existingProfiles = list.ToDictionary(x => x.UserId, x => (x as TProfile)!);
        }
        else
        {
            existingProfiles = new Dictionary<string, TProfile>();
        }

        // 5. Thêm mới hoặc cập nhật hồ sơ tương ứng
        var profiles = new List<TProfile>(SampleCount);
        for (var i = 1; i <= SampleCount; i++)
        {
            var user = usersByIndex[i - 1];
            if (!existingProfiles.TryGetValue(user.Id, out var profile))
            {
                profile = profileFactory(i);
                SetUserId(profile, user.Id);
                db.Set<TProfile>().Add(profile);
            }
            else
            {
                UpdateProfileSample(profile, accountPrefix, i);
            }

            profiles.Add(profile);
        }

        await db.SaveChangesAsync();
        return profiles;
    }

    private static void SetUserId<TProfile>(TProfile profile, string userId) where TProfile : class
    {
        switch (profile)
        {
            case AdminProfile value: value.UserId = userId; break;
            case TutorProfile value: value.UserId = userId; break;
            case StudentProfile value: value.UserId = userId; break;
        }
    }

    private static void UpdateProfileSample<TProfile>(TProfile profile, string accountPrefix, int index) where TProfile : class
    {
        switch (profile)
        {
            case AdminProfile admin:
                admin.Rank = "Quản trị viên";
                break;
            case TutorProfile tutor:
                tutor.Introduction = $"Tôi có kinh nghiệm giảng dạy {SubjectNames[index - 1]} và luôn xây dựng lộ trình phù hợp với từng học viên.";
                tutor.HourlyFee = 100000 + index * 10000;
                tutor.VerificationStatus = VerificationStatus.Approved;
                tutor.AverageRating = 4 + index % 10 / 10.0;
                break;
            case StudentProfile student:
                student.InterestedSubjects = $"{SubjectNames[(index - 1) % SubjectNames.Length]}, {SubjectNames[index % SubjectNames.Length]}";
                student.Area = SampleAreas[index - 1];
                student.FreeSchedule = "Tối thứ Hai, thứ Tư và sáng thứ Bảy";
                break;
        }
    }

    private static string GetSamplePersonName(string accountPrefix, int index)
    {
        var offset = accountPrefix switch
        {
            "tutor" => 0,
            "student" => 10,
            _ => 20
        };
        return VietnameseNames[(index - 1 + offset) % VietnameseNames.Length];
    }

    private static string GetSampleAvatarUrl(string accountPrefix, int index)
    {
        var imageIndex = index - 1 + (accountPrefix == "student" ? 50 : 0);
        var gender = imageIndex % 2 == 0 ? "men" : "women";
        return $"https://randomuser.me/api/portraits/{gender}/{imageIndex / 2}.jpg";
    }

    private static void EnsureSucceeded(IdentityResult result, string operation)
    {
        if (!result.Succeeded)
            throw new InvalidOperationException($"{operation}: {string.Join(", ", result.Errors.Select(x => x.Description))}");
    }

    private static async Task EnsureTutorSubjectsAsync(
        ApplicationDbContext db, IReadOnlyList<TutorProfile> tutors,
        IReadOnlyList<Subject> subjects, IReadOnlyList<GradeLevel> grades)
    {
        var tutorIds = tutors.Select(x => x.Id).ToArray();
        var existing = await db.TutorSubjects.Where(x => tutorIds.Contains(x.TutorId))
            .Select(x => new { x.TutorId, x.SubjectId, x.GradeLevelId }).ToListAsync();
        var keys = existing.Select(x => $"{x.TutorId}:{x.SubjectId}:{x.GradeLevelId}").ToHashSet();
        var count = Math.Min(SampleCount, Math.Min(tutors.Count, Math.Min(subjects.Count, grades.Count)));
        for (var i = 0; i < count; i++)
        {
            var key = $"{tutors[i].Id}:{subjects[i].Id}:{grades[i].Id}";
            if (!keys.Contains(key))
                db.TutorSubjects.Add(new TutorSubject { TutorId = tutors[i].Id, SubjectId = subjects[i].Id, GradeLevelId = grades[i].Id });
        }
        await db.SaveChangesAsync();
    }

    private static async Task EnsureAvailabilitiesAsync(ApplicationDbContext db, IReadOnlyList<TutorProfile> tutors)
    {
        var ids = tutors.Select(x => x.Id).ToArray();
        var existing = await db.TutorAvailabilities.Where(x => ids.Contains(x.TutorId))
            .Select(x => new { x.TutorId, x.DayOfWeek, x.StartTime, x.EndTime }).ToListAsync();
        var keys = existing.Select(x => $"{x.TutorId}:{x.DayOfWeek}:{x.StartTime}:{x.EndTime}").ToHashSet();
        var count = Math.Min(SampleCount, tutors.Count);
        for (var i = 0; i < count; i++)
        {
            var day = (DayOfWeek)(i % 7);
            var start = new TimeOnly(16 + i % 3, 0);
            var end = start.AddHours(2);
            if (!keys.Contains($"{tutors[i].Id}:{day}:{start}:{end}"))
                db.TutorAvailabilities.Add(new TutorAvailability { TutorId = tutors[i].Id, DayOfWeek = day, StartTime = start, EndTime = end });
        }
        await db.SaveChangesAsync();
    }

    private static async Task EnsureGuardiansAsync(ApplicationDbContext db, IReadOnlyList<StudentProfile> students)
    {
        var ids = students.Select(x => x.Id).ToArray();
        var existing = await db.Guardians.Where(x => ids.Contains(x.StudentProfileId)).Select(x => x.StudentProfileId).ToListAsync();
        var keys = existing.ToHashSet();
        var count = Math.Min(SampleCount, students.Count);
        for (var i = 0; i < count; i++)
            if (!keys.Contains(students[i].Id))
                db.Guardians.Add(new Guardian { FullName = $"Người giám hộ mẫu {i + 1:D3}", ContactInfo = $"guardian{i + 1:D3}@example.test", StudentProfileId = students[i].Id });
        await db.SaveChangesAsync();
    }

    private static async Task EnsureQualificationsAsync(ApplicationDbContext db, IReadOnlyList<TutorProfile> tutors)
    {
        var names = Enumerable.Range(1, SampleCount).Select(i => SampleName("bằng cấp", i)).ToArray();
        var existing = (await db.Qualifications.Where(x => names.Contains(x.Title)).Select(x => x.Title).ToListAsync()).ToHashSet();
        var count = Math.Min(SampleCount, tutors.Count);
