        logger?.LogInformation("--> [8/15] Thiết lập yêu cầu kết nối & lịch học thử...");
        await EnsureRequestsAsync(db, students, tutors, subjects, gradeLevels);

        var requests = await db.ConnectionRequests
            .Where(x => x.Message != null && x.Message.StartsWith("Mẫu yêu cầu kết nối "))
            .OrderBy(x => x.Message)
            .ToListAsync();
        await EnsureTrialSchedulesAsync(db, requests);

        logger?.LogInformation("--> [9/15] Thiết lập lớp học & buổi học...");
        var classrooms = await EnsureClassroomsAsync(db, tutors, subjects, gradeLevels);
        await EnsureClassroomStudentsAsync(db, classrooms, students);
        await EnsureClassSessionsAsync(db, classrooms);

        var sessions = await db.ClassSessions
            .Where(x => x.VideoRoom != null && x.VideoRoom.StartsWith("OTSP-SEED30-SESSION-"))
            .OrderBy(x => x.VideoRoom)
            .ToListAsync();

        logger?.LogInformation("--> [10/15] Thiết lập đánh giá học viên & cảnh báo đánh giá...");
        await EnsureReviewsAsync(db, sessions, students);

        var reviews = await db.Reviews
            .Where(x => x.Comment != null && x.Comment.StartsWith("Mẫu đánh giá "))
            .OrderBy(x => x.Comment)
            .ToListAsync();
        await EnsureReviewAlertsAsync(db, reviews, admins);

