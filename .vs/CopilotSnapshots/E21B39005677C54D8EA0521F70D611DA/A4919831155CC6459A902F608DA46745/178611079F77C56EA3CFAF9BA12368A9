    public static async Task SeedAsync(
        ApplicationDbContext db,
        UserManager<ApplicationUser> userManager,
        ILogger? logger = null)
    {
        logger?.LogInformation("--> [1/15] Đồng bộ danh mục môn học mẫu (Subjects)...");
        var subjects = await EnsureSubjectsAsync(db);

        logger?.LogInformation("--> [2/15] Đồng bộ danh mục cấp học mẫu (GradeLevels)...");
        var gradeLevels = await EnsureGradeLevelsAsync(db);

        logger?.LogInformation("--> [3/15] Dùng tài khoản Admin cốt lõi duy nhất cho dữ liệu mẫu...");
        var admin = await db.AdminProfiles.OrderBy(x => x.UserId).FirstOrDefaultAsync()
            ?? throw new InvalidOperationException("Tài khoản Admin cốt lõi chưa được tạo trước khi nạp dữ liệu mẫu.");
        var admins = Enumerable.Repeat(admin, SampleCount).ToList();

        logger?.LogInformation("--> [4/15] Đồng bộ 50 hồ sơ Gia sư mẫu...");
        var tutors = await EnsureProfilesAsync(db, userManager, "Tutor", "tutor", i =>
            new TutorProfile
            {
                Introduction = $"Tôi có kinh nghiệm giảng dạy {SubjectNames[i - 1]} và luôn xây dựng lộ trình phù hợp với từng học viên.",
                HourlyFee = 100000 + i * 10000,
                VerificationStatus = VerificationStatus.Approved,
                AverageRating = 4 + i % 10 / 10.0
            });

        logger?.LogInformation("--> [5/15] Đồng bộ 50 hồ sơ Học viên mẫu...");
        var students = await EnsureProfilesAsync(db, userManager, "Student_Parent", "student", i =>
            new StudentProfile
