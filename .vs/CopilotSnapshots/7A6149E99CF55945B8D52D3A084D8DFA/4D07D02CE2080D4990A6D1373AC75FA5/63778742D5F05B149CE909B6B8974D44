@using PROJECT_OTSP.Models
@using PROJECT_OTSP.Data
@model TutorProfile
@{
    // Layout = "~/Areas/Tutor/Views/_Layout_Tutor.cshtml";
    ViewData["Title"] = "Hồ sơ gia sư";

    var avatarUrl = string.IsNullOrWhiteSpace(Model.User.AvatarUrl)
        ? "https://cdn-media.sforum.vn/storage/app/media/ctv_seo3/meme-meo-cuoi-5.jpg"
        : Model.User.AvatarUrl;

    var statusClass = Model.VerificationStatus switch
    {
        Enums.VerificationStatus.Approved => "status-approved",
        Enums.VerificationStatus.Rejected => "status-rejected",
        _ => "status-pending"
    };

    var statusIcon = Model.VerificationStatus switch
    {
        Enums.VerificationStatus.Approved => "bi-patch-check-fill",
        Enums.VerificationStatus.Rejected => "bi-x-octagon-fill",
        _ => "bi-hourglass-split"
    };

    var subjectCount = Model.TutorSubjects.Count();
    var qualificationCount = Model.Qualifications.Count();

    ViewBag.Subjects = await _dbcontext.Subjects
    .AsNoTracking().OrderBy(s => s.Name).ToListAsync(cancellationToken);

    ViewBag.GradeLevels = await _dbcontext.GradeLevels
    .AsNoTracking().OrderBy(g => g.Id).ToListAsync(cancellationToken);

}

<style>
    :root {
        --brand: #2f9e6e;
        --brand-dark: #1d6e4e;
        --brand-glow: rgba(47, 158, 110, .22);
        --brand-soft: rgba(47, 158, 110, .12);
        --radius-lg: 1.25rem;
        --radius-md: .9rem;
    }

    /* Banner */
    .profile-hero {
        background:
            radial-gradient(circle at 90% 10%, rgba(255,255,255,.22), transparent 38%),
            radial-gradient(circle at 10% 100%, rgba(255,255,255,.12), transparent 42%),
            linear-gradient(120deg, var(--brand), var(--brand-dark));
        color: #fff;
        padding: 3rem 0 6.5rem;
    }
    .profile-hero .breadcrumb-item,
    .profile-hero .breadcrumb-item a { color: rgba(255,255,255,.78); text-decoration: none; }
    .profile-hero .breadcrumb-item.active { color: #fff; }
    .profile-hero .breadcrumb-item + .breadcrumb-item::before { color: rgba(255,255,255,.5); }
    .profile-hero h1 { font-weight: 800; letter-spacing: -.02em; }

    .profile-wrap { margin-top: -5rem; padding-bottom: 4rem; }

    /* Card chung */
    .pro-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: var(--radius-lg);
        box-shadow: 0 10px 30px rgba(0, 0, 0, .06);
        padding: 1.75rem;
    }

    /* Sidebar dính khi cuộn */
    @@media (min-width: 992px) {
        .sticky-side { position: sticky; top: 90px; }
    }

    /* Avatar */
    .avatar-ring {
        width: 128px;
        height: 128px;
        margin: -4.5rem auto 1rem;
        padding: 5px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand), #9fe0c3);
        box-shadow: 0 8px 22px var(--brand-glow);
    }
    .avatar-ring img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid var(--bs-body-bg);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .9rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }
    .status-approved { background: rgba(25,135,84,.14); color: #198754; }
    .status-rejected { background: rgba(220,53,69,.14); color: #dc3545; }
    .status-pending  { background: rgba(255,193,7,.18); color: #b58100; }

    .rating-line {
        font-size: .9rem;
        color: var(--bs-secondary-color);
    }

    /* Ô thống kê */
    .stat-box {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1rem;
        border-radius: var(--radius-md);
        background: var(--brand-soft);
    }
    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--bs-body-bg);
        color: var(--brand);
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .stat-box .num { font-size: 1.5rem; font-weight: 800; color: var(--brand); line-height: 1; }
    .stat-box .label { font-size: .8rem; color: var(--bs-secondary-color); margin-top: .2rem; }

    /* Tiêu đề mục */
    .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }
    .section-title {
        display: flex;
        align-items: center;
        gap: .7rem;
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--bs-body-color);
    }
    .section-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--brand-soft);
        color: var(--brand);
        font-size: 1rem;
    }

    /* Ô nhập */
    .form-label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--bs-secondary-color);
        margin-bottom: .4rem;
    }
    .form-control {
        border-radius: .75rem;
        border-color: var(--bs-border-color);
        min-height: 48px;
        background-color: var(--bs-body-bg);
        color: var(--bs-body-color);
    }
    .form-control:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 .22rem var(--brand-glow);
    }
    .form-control[readonly] {
        background-color: var(--bs-tertiary-bg);
        border-style: dashed;
        cursor: not-allowed;
    }
    .input-group-text {
        border-radius: 0 .75rem .75rem 0;
        background: var(--bs-tertiary-bg);
        color: var(--bs-secondary-color);
        font-size: .85rem;
    }

    /* Chip môn dạy */
    .subject-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem 1rem;
        margin: .2rem .25rem .2rem 0;
        border-radius: 999px;
        background: var(--brand-soft);
        color: var(--brand-dark);
        font-size: .85rem;
        font-weight: 600;
    }
    html[data-bs-theme="dark"] .subject-chip { color: #8fe3bf; }

    /* Khung trống */
    .empty-box {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: 1.1rem 1.25rem;
        border: 1px dashed var(--bs-border-color);
        border-radius: var(--radius-md);
        color: var(--bs-secondary-color);
        font-size: .9rem;
    }
    .empty-box i { font-size: 1.4rem; color: var(--brand); }

    /* Bằng cấp */
    .qual-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: var(--radius-md);
        transition: border-color .2s, box-shadow .2s, transform .2s;
    }
    .qual-item + .qual-item { margin-top: .75rem; }
    .qual-item:hover {
        transform: translateY(-2px);
        border-color: var(--brand);
        box-shadow: 0 10px 24px rgba(0,0,0,.08);
    }
    .qual-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--brand-soft);
        color: var(--brand);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    /* Nút */
    .btn-brand {
        background: linear-gradient(120deg, var(--brand), var(--brand-dark));
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: .7rem 1.8rem;
        font-weight: 600;
        box-shadow: 0 8px 20px var(--brand-glow);
        transition: transform .15s, box-shadow .15s;
    }
    .btn-brand:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 12px 26px var(--brand-glow); }

    .btn-soft {
        background: var(--brand-soft);
        color: var(--brand-dark);
        border: 1px solid transparent;
        border-radius: 999px;
        font-weight: 600;
    }
    .btn-soft:hover { background: var(--brand); color: #fff; }
    html[data-bs-theme="dark"] .btn-soft { color: #8fe3bf; }

    /* Khối tải lên */
    .upload-box {
        border: 1px dashed var(--brand);
        border-radius: var(--radius-md);
        background: var(--brand-soft);
        padding: 1.25rem;
    }

    .save-bar {
        display: flex;
        justify-content: flex-end;
        margin: .5rem 0 1.5rem;
    }

    .alert { border-radius: var(--radius-md); }
</style>

<section class="profile-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ sơ gia sư</li>
            </ol>
        </nav>
        <h1 class="mb-2">Hồ sơ gia sư</h1>
        <p class="mb-0 opacity-75">Cập nhật thông tin để học viên dễ tìm thấy và tin tưởng bạn hơn.</p>
    </div>
</section>

<div class="container profile-wrap">

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4">

        <aside class="col-lg-4">
            <div class="sticky-side">
                <div class="pro-card text-center mb-4">
                    <div class="avatar-ring">
                        <img src="@avatarUrl" alt="Ảnh đại diện gia sư" />
                    </div>

                    <h2 class="h5 fw-bold mb-2">@Model.User.FullName</h2>

                    <span class="status-pill @statusClass">
                        <i class="bi @statusIcon"></i>@Model.VerificationStatus
                    </span>

                    <div class="rating-line mt-3">
                        @if (Model.AverageRating > 0)
                        {
                            <span><i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0") / 5</span>
                        }
                        else
                        {
                            <span>Chưa có đánh giá</span>
                        }
                    </div>
                </div>

