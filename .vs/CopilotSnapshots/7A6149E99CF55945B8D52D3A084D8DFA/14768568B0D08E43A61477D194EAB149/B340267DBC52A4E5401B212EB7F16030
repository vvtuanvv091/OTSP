body:has(.tutor-dashboard-shell) {
    --tutor-sidebar-width: 260px;
}

.tutor-dashboard-shell {
    display: flex;
    min-height: calc(100vh - 110px);
    align-items: flex-start;
}

.tutor-dashboard-main {
    flex: 1;
    min-width: 0;
}

.tutor-sidebar {
    position: sticky;
    top: 90px;
    z-index: 1035;
    flex: 0 0 var(--tutor-sidebar-width);
    width: var(--tutor-sidebar-width);
    height: calc(100vh - 90px);
    overflow-y: auto;
    padding: 1rem .75rem;
    background: var(--bs-body-bg);
    border-right: 1px solid var(--bs-border-color);
    transition: transform .25s ease, margin .25s ease;
}

.tutor-sidebar-user {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding: .5rem .65rem 1.1rem;
    border-bottom: 1px solid var(--bs-border-color);
    margin-bottom: .8rem;
}

.tutor-sidebar-avatar {
    display: inline-flex;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(47, 158, 110, .14);
    color: #2f9e6e;
    font-size: 1.15rem;
}

.tutor-sidebar-user-info {
    min-width: 0;
}

.tutor-sidebar-user-info strong,
.tutor-sidebar-user-info small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tutor-sidebar-user-info strong {
    font-size: .9rem;
}

.tutor-sidebar-user-info small {
    margin-top: .1rem;
    color: var(--bs-secondary-color);
    font-size: .72rem;
}

.tutor-sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: .12rem;
}

.tutor-sidebar-heading {
    margin: .8rem .65rem .25rem;
    color: var(--bs-secondary-color);
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .035em;
}

.tutor-sidebar-link {
    display: flex;
    min-height: 38px;
    align-items: center;
    gap: .7rem;
    padding: .55rem .7rem;
    border-radius: .45rem;
    color: var(--bs-body-color);
    font-size: .84rem;
    text-decoration: none;
}

.tutor-sidebar-link i {
    width: 18px;
    color: var(--bs-secondary-color);
    font-size: .95rem;
    text-align: center;
}

.tutor-sidebar-link.active {
    background: rgba(220, 53, 69, .09);
    color: #dc3545;
}

.tutor-sidebar-link.active i {
    color: #dc3545;
}

.tutor-sidebar-link.is-disabled {
    cursor: default;
    opacity: .65;
}

.tutor-menu-toggle {
    position: fixed;
    top: 98px;
    left: calc(var(--tutor-sidebar-width) - 52px);
    z-index: 1045;
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bs-border-color);
    border-radius: .5rem;
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
    box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
    font-size: 1.45rem;
}

.tutor-sidebar-backdrop {
    display: none;
}

body.tutor-sidebar-collapsed .tutor-sidebar {
    display: none;
}

body.tutor-sidebar-collapsed .tutor-menu-toggle {
    left: 14px;
}

@media (max-width: 991.98px) {
    .tutor-dashboard-shell {
        min-height: calc(100vh - 90px);
    }

    .tutor-sidebar {
        position: fixed;
        top: 90px;
        bottom: 0;
        left: 0;
        width: min(var(--tutor-sidebar-width), calc(100vw - 56px));
        height: auto;
        transform: translateX(-105%);
        box-shadow: 8px 0 24px rgba(0, 0, 0, .12);
    }

    body.tutor-sidebar-open .tutor-sidebar {
        transform: translateX(0);
    }

    .tutor-menu-toggle {
        left: 14px;
    }

    body.tutor-sidebar-open .tutor-menu-toggle {
        left: calc(min(var(--tutor-sidebar-width), 100vw - 56px) - 52px);
    }

    .tutor-sidebar-backdrop {
        position: fixed;
        inset: 90px 0 0;
        z-index: 1030;
        border: 0;
        background: rgba(0, 0, 0, .35);
    }

    body.tutor-sidebar-open .tutor-sidebar-backdrop {
        display: block;
    }
}
