          <button type="submit" name="theme" value="@(theme == "dark" ? "light" : "dark")" class="header-control header-theme-toggle" aria-label="@(theme == "dark" ? (isVietnamese ? "Chuyển sang giao diện sáng" : "Switch to light theme") : (isVietnamese ? "Chuyển sang giao diện tối" : "Switch to dark theme"))" title="@(theme == "dark" ? (isVietnamese ? "Giao diện sáng" : "Light theme") : (isVietnamese ? "Giao diện tối" : "Dark theme"))">
