# Google OAuth 2.0 Web Client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Địa chỉ Backend khi chạy bản build (vite preview / production). KHÔNG có dấu "/" ở cuối.
# Local dev (`npm run dev` tại cổng 5173) tự động dùng proxy Vite sang http://localhost:5170.
VITE_API_BASE_URL=http://localhost:5170
